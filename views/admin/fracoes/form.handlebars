<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>{{titulo}}</h1>
    <p class="subtitle">Defina os dados da fração</p>
  </div>
  <a href="/admin/fracoes" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1">arrow_back</span>Voltar</a>
</div>

<div class="row g-4">
  <div class="col-12 col-lg-6">
    <div class="card">
      <div class="card-body">
        <form action="{{#if fracao}}/admin/fracoes/{{fracao.id}}{{else}}/admin/fracoes{{/if}}" method="POST">
          <div class="mb-3">
            <label class="form-label">Designação *</label>
            <input type="text" class="form-control" name="designacao" value="{{fracao.designacao}}" required />
          </div>
          <div class="row">
            <div class="col-6 mb-3">
              <label class="form-label">Permilagem (‰)</label>
              <input type="text" class="form-control" name="permilagem" value="{{fracao.permilagem}}" placeholder="ex.: 120,5" />
            </div>
            <div class="col-6 mb-3">
              <label class="form-label">Andar</label>
              <input type="text" class="form-control" name="andar" value="{{fracao.andar}}" />
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Observações</label>
            <textarea class="form-control" name="observacoes" rows="2">{{fracao.observacoes}}</textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">Estado</label>
            <select class="form-select" name="estado">
              <option value="ativo" {{selected fracao.estado 'ativo'}}>Ativa</option>
              <option value="inativo" {{selected fracao.estado 'inativo'}}>Inativa</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary"><span class="material-symbols-outlined me-1">save</span>Guardar</button>
        </form>
      </div>
    </div>
  </div>

  {{#if fracao}}
  <div class="col-12 col-lg-6">
    <div class="card">
      <div class="card-header"><span class="material-symbols-outlined me-2">link</span>Pessoas associadas</div>
      <div class="card-body">
        <form action="/admin/fracoes/{{fracao.id}}/pessoas" method="POST" class="row g-2 mb-3">
          <div class="col-12">
            <label class="form-label">Pessoa</label>
            <select class="form-select" name="pessoa_id" required>
              {{#each pessoas}}
              <option value="{{id}}">{{nome}}</option>
              {{/each}}
            </select>
          </div>
          <div class="col-6">
            <select class="form-select" name="vinculo">
              <option value="proprietario">Proprietário</option>
              <option value="arrendatario">Arrendatário</option>
              <option value="usufrutuario">Usufrutuário</option>
            </select>
          </div>
          <div class="col-6">
            <button type="submit" class="btn btn-outline-primary w-100"><span class="material-symbols-outlined me-1">add</span>Associar</button>
          </div>
        </form>

        <ul class="list-group list-group-flush">
          {{#each fracao.pessoas}}
          <li class="list-group-item d-flex justify-content-between align-items-center px-0">
            <div>
              <span class="fw-semibold">{{nome}}</span>
              <span class="badge text-bg-light border ms-2">{{this.FracaoPessoa.vinculo}}</span>
            </div>
            <form action="/admin/fracoes/{{../fracao.id}}/pessoas/{{this.FracaoPessoa.id}}/eliminar" method="POST">
              <button class="btn btn-sm btn-outline-danger"><span class="material-symbols-outlined">close</span></button>
            </form>
          </li>
          {{else}}
          <li class="list-group-item text-muted px-0">Nenhuma pessoa associada.</li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
  {{/if}}
</div>
