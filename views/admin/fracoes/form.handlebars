<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>{{titulo}}</h1>
    <p class="subtitle">Defina os dados da fração</p>
  </div>
  <a href="/admin/fracoes" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1">arrow_back</span>Voltar</a>
</div>

<div class="row g-4">
  <div class="col-12 col-lg-6">
    <div class="card">
      <div class="card-body">
        <form action="{{#if fracao}}/admin/fracoes/{{fracao.id}}{{else}}/admin/fracoes{{/if}}" method="POST">
          <div class="mb-3">
            <label class="form-label">Designação *</label>
            <input type="text" class="form-control" name="designacao" value="{{fracao.designacao}}" required />
          </div>
          <div class="row">
            <div class="col-6 mb-3">
              <label class="form-label">Permilagem (‰)</label>
              <input type="text" class="form-control" name="permilagem" value="{{fracao.permilagem}}" placeholder="ex.: 120,5" />
            </div>
            <div class="col-6 mb-3">
              <label class="form-label">Andar</label>
              <input type="text" class="form-control" name="andar" value="{{fracao.andar}}" placeholder="ex.: 3.º" />
            </div>
          </div>
          <div class="row">
            <div class="col-6 mb-3">
              <label class="form-label">Porta</label>
              <input type="text" class="form-control" name="porta" value="{{fracao.porta}}" placeholder="ex.: 3.º Esq." />
            </div>
            <div class="col-6 mb-3">
              <label class="form-label">Estado</label>
              <select class="form-select" name="estado">
                <option value="ativo" {{selected fracao.estado 'ativo'}}>Ativa</option>
                <option value="inativo" {{selected fracao.estado 'inativo'}}>Inativa</option>
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Observações</label>
            <textarea class="form-control" name="observacoes" rows="2">{{fracao.observacoes}}</textarea>
          </div>
          <button type="submit" class="btn btn-primary"><span class="material-symbols-outlined me-1">save</span>Guardar</button>
        </form>
      </div>
    </div>
  </div>

  {{#if fracao}}
  <div class="col-12 col-lg-6">
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><span class="material-symbols-outlined me-2">badge</span>Titularidade</span>
        <span class="badge text-bg-light border">{{titulares.length}} titular(es) atual(ais)</span>
      </div>
      <div class="card-body">
        {{#if proprietariosDuplicados}}
        <div class="alert alert-warning" role="status">
          <span class="fw-semibold">Há mais do que um proprietário ativo nesta fração.</span>
          Se a fração mudou de proprietário, encerre o período anterior com a data da escritura — o registo
          mantém-se no histórico e o novo proprietário passa a ter acesso apenas ao que lhe compete.
        </div>
        {{/if}}
        {{#if titulares.length}}
        <ul class="list-group list-group-flush mb-3">
          {{#each titulares}}
          <li class="list-group-item px-0">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div>
                <span class="fw-semibold">{{#if this.pessoa}}{{this.pessoa.nome}}{{else}}{{#if this.utilizador}}{{this.utilizador.nome}}{{else}}Sem pessoa associada{{/if}}{{/if}}</span>
                <span class="badge text-bg-light border ms-2">{{this.vinculo}}</span>
                {{#if this.temConta}}<span class="badge text-bg-success ms-1">com conta</span>{{else}}<span class="badge text-bg-secondary ms-1">sem conta</span>{{/if}}
                <div class="text-muted small">
                  Desde {{#if this.data_inicio}}{{formatDate this.data_inicio}}{{else}}—{{/if}}
                </div>
                {{#unless this.temConta}}
                <div class="small mt-1">
                  <a href="/admin/utilizadores/novo">Criar conta por convite</a>
                  <span class="text-muted">— sem conta, o titular fica registado mas não acede ao GesCondu. Cada proprietário tem a sua própria conta: nunca reutilize as credenciais do anterior.</span>
                </div>
                {{/unless}}
                {{#if this.contasMultiplas}}
                <div class="small text-warning-emphasis mt-1">Mais do que uma conta ligada a esta pessoa — confirme em Utilizadores qual deve manter.</div>
                {{/if}}
              </div>
            </div>
            <form action="/admin/fracoes/{{../fracao.id}}/titulares/{{this.id}}/cessar" method="POST" class="row g-2 mt-2">
              <div class="col-5">
                <input type="date" class="form-control form-control-sm" name="data_fim" value="{{dateInput ../hoje}}" />
              </div>
              <div class="col-4">
                <input type="text" class="form-control form-control-sm" name="motivo" placeholder="Motivo (ex.: venda)" />
              </div>
              <div class="col-3">
                <button class="btn btn-sm btn-outline-danger w-100" data-confirmar="Encerrar esta titularidade com a data indicada? O registo mantém-se no histórico.">
                  Encerrar
                </button>
              </div>
            </form>
          </li>
          {{/each}}
        </ul>
        {{else}}
        <p class="text-muted">Sem titularidade registada. Registe o titular atual para que a autorização de acesso passe a ser determinada pelas relações em vigor.</p>
        {{/if}}

        <form action="/admin/fracoes/{{fracao.id}}/titulares" method="POST" class="row g-2 align-items-end border-top pt-3">
          <div class="col-12">
            <label class="form-label">Titular (pessoa do condomínio)</label>
            <select class="form-select form-select-sm" name="pessoa_id" required>
              {{#each pessoas}}
              <option value="{{id}}">{{nome}}</option>
              {{/each}}
            </select>
          </div>
          <div class="col-6">
            <label class="form-label">Vínculo</label>
            <select class="form-select form-select-sm" name="vinculo">
              <option value="proprietario">Proprietário</option>
              <option value="arrendatario">Arrendatário</option>
              <option value="usufrutuario">Usufrutuário</option>
            </select>
          </div>
          <div class="col-6">
            <label class="form-label">Início</label>
            <input type="date" class="form-control form-control-sm" name="data_inicio" value="{{dateInput hoje}}" />
          </div>
          <div class="col-12">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="encerrar_atual" name="encerrar_atual" value="on" checked />
              <label class="form-check-label small" for="encerrar_atual">
                Encerrar o titular atual do mesmo vínculo (mudança de proprietário): o período anterior é fechado
                no dia anterior e mantém-se no histórico.
              </label>
            </div>
          </div>
          <div class="col-12">
            <button class="btn btn-sm btn-primary"><span class="material-symbols-outlined me-1">add</span>Registar titular</button>
          </div>
        </form>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header"><span class="material-symbols-outlined me-2">history</span>Histórico de titularidade</div>
      {{#if historico.length}}
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light">
            <tr><th>Titular</th><th>Vínculo</th><th>Início</th><th>Fim</th><th>Estado</th><th>Motivo</th></tr>
          </thead>
          <tbody>
            {{#each historico}}
            <tr>
              <td>{{#if this.pessoa}}{{this.pessoa.nome}}{{else}}{{#if this.utilizador}}{{this.utilizador.nome}}{{else}}—{{/if}}{{/if}}</td>
              <td>{{this.vinculo}}</td>
              <td>{{#if this.data_inicio}}{{formatDate this.data_inicio}}{{else}}—{{/if}}</td>
              <td>{{#if this.data_fim}}{{formatDate this.data_fim}}{{else}}—{{/if}}</td>
              <td>{{#if (eq this.estado 'ativa')}}<span class="badge text-bg-success">Em vigor</span>{{else}}<span class="badge text-bg-secondary">Encerrada</span>{{/if}}</td>
              <td class="text-muted small">{{#if this.motivo_cessacao}}{{this.motivo_cessacao}}{{else}}—{{/if}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="card-body text-muted small">
        Ainda não há períodos de titularidade registados. O histórico é criado à medida que registar titulares e
        encerrar períodos; nada é substituído nem apagado.
      </div>
      {{/if}}
    </div>

    <div class="card">
      <div class="card-header"><span class="material-symbols-outlined me-2">link</span>Pessoas associadas</div>
      <div class="card-body">
        <p class="text-muted small">
          Lista usada para contactos e comunicações por fração (avisos, envio de quotas e recibos).
          A mudança de proprietário faz-se na secção <strong>Titularidade</strong>, que mantém o histórico.
        </p>
        <form action="/admin/fracoes/{{fracao.id}}/pessoas" method="POST" class="row g-2 mb-3">
          <div class="col-12">
            <label class="form-label">Pessoa</label>
            <select class="form-select" name="pessoa_id" required>
              {{#each pessoas}}
              <option value="{{id}}">{{nome}}</option>
              {{/each}}
            </select>
          </div>
          <div class="col-6">
            <select class="form-select" name="vinculo">
              <option value="proprietario">Proprietário</option>
              <option value="arrendatario">Arrendatário</option>
              <option value="usufrutuario">Usufrutuário</option>
            </select>
          </div>
          <div class="col-6">
            <button type="submit" class="btn btn-outline-primary w-100"><span class="material-symbols-outlined me-1">add</span>Associar</button>
          </div>
        </form>

        <ul class="list-group list-group-flush">
          {{#each fracao.pessoas}}
          <li class="list-group-item d-flex justify-content-between align-items-center px-0">
            <div>
              <span class="fw-semibold">{{nome}}</span>
              <span class="badge text-bg-light border ms-2">{{this.FracaoPessoa.vinculo}}</span>
            </div>
            <form action="/admin/fracoes/{{../fracao.id}}/pessoas/{{this.FracaoPessoa.id}}/eliminar" method="POST" data-confirmar="Remover esta associação? A titularidade correspondente será encerrada com a data de hoje e mantém-se no histórico." data-confirmar-perigo="1">
              <button class="btn btn-sm btn-outline-danger"><span class="material-symbols-outlined">close</span></button>
            </form>
          </li>
          {{else}}
          <li class="list-group-item text-muted px-0">Nenhuma pessoa associada.</li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
  {{/if}}
</div>
