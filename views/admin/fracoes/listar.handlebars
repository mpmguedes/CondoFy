<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <h1 class="h3 mb-0"><i class="bi bi-building me-2"></i>Frações</h1>
  <a href="/admin/fracoes/nova" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nova fração</a>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Designação</th>
          <th>Permilagem</th>
          <th>Andar</th>
          <th>Proprietários</th>
          <th>Estado</th>
          <th class="text-end">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each fracoes}}
        <tr>
          <td class="fw-semibold">{{designacao}}</td>
          <td>{{#if permilagem}}{{permilagem}} ‰{{else}}—{{/if}}</td>
          <td>{{#if andar}}{{andar}}{{else}}—{{/if}}</td>
          <td>
            {{#each pessoas}}
              <span class="badge text-bg-light border">{{nome}} {{#if (eq this.FracaoPessoa.vinculo 'arrendatario')}}(arrend.){{/if}}</span>
            {{else}}
              <span class="text-muted">Sem proprietário</span>
            {{/each}}
          </td>
          <td>
            {{#if (eq estado 'ativo')}}<span class="badge text-bg-success">Ativa</span>{{else}}<span class="badge text-bg-secondary">Inativa</span>{{/if}}
          </td>
          <td class="text-end">
            <a href="/admin/fracoes/{{id}}/editar" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
            <form action="/admin/fracoes/{{id}}/eliminar" method="POST" class="d-inline" onsubmit="return confirm('Eliminar esta fração?');">
              <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
            </form>
          </td>
        </tr>
        {{else}}
        <tr><td colspan="6" class="text-center text-muted py-4">Ainda não há frações registadas.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
