<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>Frações</h1>
    <p class="subtitle">Gerir as frações do condomínio, permilagens e proprietários</p>
  </div>
  <a href="/admin/fracoes/nova" class="btn btn-primary"><span class="material-symbols-outlined me-1">add</span>Nova fração</a>
</div>

{{#if fracoes}}
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Designação</th>
          <th>Permilagem</th>
          <th>Andar</th>
          <th>Proprietários</th>
          <th>Estado</th>
          <th class="text-end">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each fracoes}}
        <tr>
          <td class="fw-semibold">{{designacao}}</td>
          <td>{{#if permilagem}}{{permilagem}} ‰{{else}}—{{/if}}</td>
          <td>{{#if andar}}{{andar}}{{else}}—{{/if}}</td>
          <td>
            {{#each pessoas}}
              <span class="badge text-bg-light border">{{nome}} {{#if (eq this.FracaoPessoa.vinculo 'arrendatario')}}(arrend.){{/if}}</span>
            {{else}}
              <span class="text-muted">Sem proprietário</span>
            {{/each}}
          </td>
          <td>
            {{#if (eq estado 'ativo')}}<span class="badge text-bg-success">Ativa</span>{{else}}<span class="badge text-bg-secondary">Inativa</span>{{/if}}
          </td>
          <td class="text-end">
            <a href="/admin/fracoes/{{id}}/editar" class="btn btn-sm btn-outline-secondary" title="Editar"><span class="material-symbols-outlined">edit</span></a>
            <form action="/admin/fracoes/{{id}}/eliminar" method="POST" class="d-inline" onsubmit="return confirm('Eliminar esta fração?');">
              <button class="btn btn-sm btn-outline-danger" title="Eliminar"><span class="material-symbols-outlined">delete</span></button>
            </form>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
{{> _empty-state icon="apartment" titulo="Ainda não existem frações" descricao="Adicione a primeira fração do condomínio para começar a gerir quotas e residentes." link="/admin/fracoes/nova" linkTexto="Nova fração"}}
{{/if}}
