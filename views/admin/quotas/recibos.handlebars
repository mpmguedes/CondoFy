{{> _quotas-tabs ativo='recibos'}}

<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>Recibos</h1>
    <p class="subtitle">Emissão, envio e anulação de recibos formais (RCP)</p>
  </div>
</div>

<div class="row g-2 mb-3 mt-1">
  <div class="col-6 col-lg-2"><div class="card mini-stat h-100"><div class="card-body">
    <div class="mini-stat-label">Emitidos</div>
    <div class="mini-stat-value">{{resumo.emitidos}}</div>
    <div class="mini-stat-sub">recibos válidos</div>
  </div></div></div>
  <div class="col-6 col-lg-2"><div class="card mini-stat h-100"><div class="card-body">
    <div class="mini-stat-label">Enviados</div>
    <div class="mini-stat-value text-success">{{resumo.enviados}}</div>
    <div class="mini-stat-sub">por email</div>
  </div></div></div>
  <div class="col-6 col-lg-2"><div class="card mini-stat h-100"><div class="card-body">
    <div class="mini-stat-label">Por enviar</div>
    <div class="mini-stat-value text-danger">{{resumo.porEnviar}}</div>
    <div class="mini-stat-sub">ainda não enviados</div>
  </div></div></div>
</div>

{{!-- Fluxo único de emissão: por fração, com quotas ordinárias e/ou
     Quotas Extra elegíveis no mesmo modal (Emitir recibo). --}}
{{!-- 3.1 Recibos por emitir --}}
<h2 class="section-title">Por emitir</h2>
{{#if porEmitir}}
<div class="card mb-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Fração</th>
          <th class="text-end">Pago</th>
          <th class="text-end">Enviado</th>
          <th class="text-end">Por emitir</th>
          <th class="text-center">Ação</th>
        </tr>
      </thead>
      <tbody>
        {{#each porEmitir}}
        <tr>
          <td class="qmap-fracao">
            <div class="fw-semibold text-nowrap">{{designacao}}</div>
            {{#if andar}}<div class="small text-muted text-nowrap">{{andar}}{{#if porta}} · {{porta}}{{/if}}</div>{{/if}}
          </td>
          <td class="text-end text-nowrap">{{eur pago}}</td>
          <td class="text-end text-nowrap">{{eur enviado}}</td>
          <td class="text-end fw-semibold text-nowrap text-primary">
            {{eur porEmitir}}
            <div class="small text-muted fw-normal">{{#if mesesN}}{{mesesN}} mês/meses disponíveis{{#if nExtras}} · {{nExtras}} extra(s){{/if}}{{else}}{{nExtras}} extra(s){{/if}}</div>
          </td>
          <td class="text-center">
            <button type="button" class="btn btn-sm btn-outline-primary btn-emitir" data-bs-toggle="modal" data-bs-target="#modalEmitir" data-fracao="{{fracaoId}}" data-designacao="{{designacao}}">
              <span class="material-symbols-outlined me-1" style="font-size:1rem">receipt_long</span>Emitir recibo
            </button>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
<div class="alert alert-light border small">Sem valores pagos por emitir recibo. Os recibos são criados a partir dos pagamentos já recebidos.</div>
{{/if}}

{{!-- 3.2 Recibos emitidos --}}
<h2 class="section-title">Emitidos ({{resumo.emitidos}}) — ({{resumo.porEnviar}}) por enviar</h2>
{{#if recibos}}
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 qmap">
      <thead class="table-light">
        <tr>
          <th>Nº</th>
          <th>Fração / Morador</th>
          <th>Período</th>
          <th class="text-end">Valor</th>
          <th>Tipo</th>
          <th>Emitido</th>
          <th>Enviado</th>
          <th class="text-center">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each recibos}}
        <tr class="{{#unless (eq estado 'emitido')}}qmap-inativa{{/unless}}">
          <td>
            <div class="fw-semibold text-nowrap">{{numero}}</div>
            <div class="small text-muted text-nowrap" title="{{#if codigo_verificacao}}Verificação: {{codigo_verificacao}}{{else}}{{codigo}}{{/if}}">{{codigo}}</div>
          </td>
          <td class="qmap-fracao">
            <div class="fw-semibold text-nowrap">{{fracao}}</div>
            {{#if morador}}<div class="small text-muted text-nowrap">{{morador}}</div>{{/if}}
          </td>
          <td class="small text-nowrap">{{periodo}}</td>
          <td class="text-end fw-semibold text-nowrap">{{eur valor}}</td>
          <td class="small">{{#if (eq tipo 'extraordinario')}}Extraordinário{{else}}Ordinário{{/if}}</td>
          <td class="text-nowrap small">{{formatDate data_emissao}}</td>
          <td>
            {{#if (eq estado 'emitido')}}
              {{#if enviado_at}}<span class="text-success small fw-semibold text-nowrap">Enviado {{formatDate enviado_at}}</span>
              {{else}}<span class="text-danger small fw-semibold text-nowrap">Por enviar</span>{{/if}}
            {{else}}
              <span class="badge text-bg-secondary" title="{{#if motivo_anulacao}}Motivo: {{motivo_anulacao}}{{/if}}">Anulado</span>
            {{/if}}
          </td>
          <td class="text-center text-nowrap">
            <a href="/admin/quotas/recibos/{{id}}/pdf" target="_blank" class="btn btn-sm btn-outline-primary px-1" title="Ver PDF"><span class="material-symbols-outlined" style="font-size:1rem">picture_as_pdf</span></a>
            {{#if (eq estado 'emitido')}}
              {{#unless enviado_at}}
              <form action="/admin/quotas/recibos/{{id}}/enviar" method="POST" class="d-inline">
                <button class="btn btn-sm btn-outline-success px-1" title="Enviar recibo por email"><span class="material-symbols-outlined" style="font-size:1rem">mail</span></button>
              </form>
              {{/unless}}
              <button type="button" class="btn btn-sm btn-outline-danger px-1 btn-anular" data-bs-toggle="modal" data-bs-target="#modalAnular" data-id="{{id}}" data-codigo="{{codigo}}" title="Anular recibo"><span class="material-symbols-outlined" style="font-size:1rem">block</span></button>
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
<div class="alert alert-light border small">Ainda não há recibos emitidos.</div>
{{/if}}

{{!-- Dados por emitir (para a modal) — todos os meses da fração com saldos.
     IMPORTANTE: JSON em contexto <script> tem de ser INESCAPED (triple-stash);
     com {{json}} o Handlebars escapa para &quot; e o JSON.parse falha. --}}
<script type="application/json" id="dadosPorEmitir">{{{json porEmitirJson}}}</script>

{{!-- Modal Emitir recibo --}}
<style>
  /* Emissão de recibos: conteúdo com scroll vertical dentro do viewport;
     header/footer do modal permanecem acessíveis (desktop, tablet e mobile).
     dvh acompanha a barra do browser em mobile (fallback vh). */
  #modalEmitir .modal-dialog-scrollable .modal-content { max-height: calc(100vh - 3rem); max-height: calc(100dvh - 3rem); }
  #modalEmitir .modal-dialog-scrollable .modal-body { overflow-y: auto; -webkit-overflow-scrolling: touch; }
  /* Itens de Quota Extra no seletor: destaque discreto face aos meses. */
  #modalEmitir .mes-btn-extra { border-color: #a5770f; background: #fdf6e3; }
  #modalEmitir .mes-btn-extra.selected { background: #a5770f !important; border-color: #a5770f !important; color: #fff; }
  #modalEmitir .mes-btn-extra.selected .mes-btn-mes,
  #modalEmitir .mes-btn-extra.selected .mes-btn-valor { color: #fff !important; }
</style>
<div class="modal fade" id="modalEmitir" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <form id="formEmitir" method="POST" action="/admin/quotas/recibos/emitir" novalidate>
        <input type="hidden" name="fracao_id" id="emitirFracaoId" />
        <div class="modal-header">
          <h5 class="modal-title">Emitir recibo</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <p class="mb-3" id="emitirFracaoTexto"></p>

          <div class="row g-3 mb-3">
            <div class="col-12 col-lg-4">
              <div class="border rounded p-2 small">
                <div class="text-muted">Valor pago disponível</div>
                <div class="fs-6 fw-semibold" id="emitirDisponivelTotal">0,00 €</div>
              </div>
            </div>
            <div class="col-12 col-lg-4">
              <div class="border rounded p-2 small">
                <div class="text-muted">Valor máximo a emitir</div>
                <div class="fs-6 fw-semibold" id="emitirMaximo">0,00 €</div>
              </div>
            </div>
            <div class="col-12 col-lg-4">
              <label class="form-label small mb-1">Valor do recibo (€)</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control text-end" name="valor_global" id="emitirValor" value="0,00" inputmode="decimal" />
                <span class="input-group-text">€</span>
              </div>
              <div class="form-text">Não pode exceder o valor disponível para emissão.</div>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-12 col-lg-6">
              <label class="form-label small mb-1">Distribuição</label>
              <select class="form-select form-select-sm" name="modo" id="emitirModo">
                <option value="plano">Cadência do plano (1 recibo por mês)</option>
                <option value="unico">Um recibo (tudo junto)</option>
                <option value="mes">Um recibo por mês</option>
                <option value="selecionar">Selecionar meses</option>
              </select>
            </div>
            <div class="col-12 col-lg-6">
              <label class="form-label small mb-1">Tipo</label>
              <select class="form-select form-select-sm" name="tipo" id="emitirTipo">
                <option value="ordinario">Ordinário</option>
                <option value="extraordinario">Extraordinário</option>
              </select>
            </div>
          </div>

          <label class="form-label small mb-1">Meses e Quotas Extra disponíveis</label>
          <div id="emitirMeses" class="row g-2"></div>
          <div class="form-text mt-1">Clique num item (mês ou Quota Extra paga) para selecionar ou desmarcar. Itens sem valor disponível aparecem desativados. As Quotas Extra são sempre emitidas num único recibo (com os meses escolhidos).</div>

          <div class="alert alert-light border small mt-3 mb-0" id="emitirContagem">Selecione os meses a emitir.</div>
          <p class="text-danger small mt-2 mb-0 d-none" id="emitirErro"></p>

          <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" name="enviar_email" id="emitirEmail" />
            <label class="form-check-label small" for="emitirEmail">Enviar por email ao condómino (após a emissão)</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Emitir recibo</button>
        </div>
      </form>
    </div>
  </div>
</div>

{{!-- Modal Anular recibo --}}
<div class="modal fade" id="modalAnular" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="formAnular" method="POST">
        <div class="modal-header">
          <h5 class="modal-title" id="anularTitulo">Anular recibo</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <p class="small">Este recibo já foi enviado ao condómino. Ao anulá-lo, deixará de ser válido e os meses abrangidos voltarão a ficar disponíveis para emissão.</p>
          <div class="alert alert-light border small">
            <strong>A anulação remove a cobertura deste recibo.</strong> Os meses abrangidos voltam ao estado "Por emitir". O registo do recibo não é eliminado: fica permanentemente marcado como anulado.
          </div>
          <label class="form-label">Motivo (opcional)</label>
          <textarea class="form-control" name="motivo" rows="3" placeholder="Ex.: recibo emitido por engano, valor incorreto..."></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-danger">Anular recibo</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';
  var CURTO = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];

  var bruto = document.getElementById('dadosPorEmitir');
  var porFracao = {};
  try {
    var dados = JSON.parse(bruto.textContent);
    (dados || []).forEach(function (f) {
      porFracao[String(f.fracaoId)] = (f.meses || []).map(function (m) {
        return {
          quotaId: m.quotaId,
          mes: m.mes,
          ano: m.ano,
          rotulo: m.rotulo || (CURTO[(m.mes - 1)] + ' ' + m.ano),
          quota: Number(m.quota || 0),
          pago: Number(m.pago || 0),
          coberto: Number(m.coberto || 0),
          disponivel: Number(m.disponivel || 0),
          fcr: Number(m.fcr || 0),
          dispC: Math.round((Number(m.disponivel || 0)) * 100),
          pode: Boolean(m.pode),
        };
      });
    });
  } catch (e) { /* sem dados */ }

  var modalEmitir = document.getElementById('modalEmitir');
  var formEmitir = document.getElementById('formEmitir');
  var lista = document.getElementById('emitirMeses');
  var campoValor = document.getElementById('emitirValor');
  var selectModo = document.getElementById('emitirModo');
  var contagem = document.getElementById('emitirContagem');
  var erroEl = document.getElementById('emitirErro');
  var selectTipo = document.getElementById('emitirTipo');
  var disponivelTotal = document.getElementById('emitirDisponivelTotal');
  var maximoEl = document.getElementById('emitirMaximo');
  var fracaoTexto = document.getElementById('emitirFracaoTexto');
  var mesesAtuais = [];

  function eur(n) {
    return (Number(n) || 0).toFixed(2).replace('.', ',') + ' €';
  }
  function eurC(c) {
    return ((c || 0) / 100).toFixed(2).replace('.', ',') + ' €';
  }

  function paraCents(texto) {
    var t = String(texto || '').trim();
    if (!t) return NaN;
    var normalizado = t.includes(',')
      ? t.replace(/\./g, '').replace(',', '.')
      : t.replace(/,/g, '.');
    var n = parseFloat(normalizado);
    return Number.isFinite(n) ? Math.round(n * 100) : NaN;
  }

  var campoFracaoId = document.getElementById('emitirFracaoId');
  var atualFracaoId = null;

  function selecionados() {
    return mesesAtuais.filter(function (m) { return m.pode && m.ativo; });
  }

  function maxSelecionadoC() {
    return selecionados().reduce(function (s, m) { return s + m.dispC; }, 0);
  }

  function mostrarErro(msg) {
    if (!msg) { erroEl.classList.add('d-none'); return; }
    erroEl.textContent = msg;
    erroEl.classList.remove('d-none');
  }

  function atualizar() {
    var modo = selectModo.value;
    var sel = selecionados();
    var temExtra = sel.some(function (m) { return Number(m.quotaId) < 0; });
    var maxC = maxSelecionadoC();
    maximoEl.textContent = eurC(maxC);
    // Com Quotas Extra selecionadas a emissão é sempre UM recibo único
    // (quotas normais + extraordinárias discriminadas no mesmo RCP).
    if (temExtra) {
      selectModo.disabled = true;
      selectModo.value = 'unico';
      selectTipo.disabled = true;
      selectTipo.value = 'extraordinario';
      campoValor.disabled = true;
      campoValor.value = (maxC / 100).toFixed(2).replace('.', ',');
      contagem.textContent = sel.length > 0 ? 'Vai criar 1 recibo (quotas e/ou Quotas Extra).' : 'Selecione pelo menos um item (quota ou Quota Extra).';
    } else {
      selectModo.disabled = false;
      selectTipo.disabled = false;
      campoValor.disabled = modo !== 'unico';
      campoValor.value = (maxC / 100).toFixed(2).replace('.', ',');
      var haExtrasLista = mesesAtuais.some(function (m) { return Number(m.quotaId) < 0 && m.pode; });
      if (sel.length > 0) {
        contagem.textContent = modo === 'unico' ? 'Vai criar 1 recibo.' : 'Vai criar ' + sel.length + ' recibo(s).';
      } else {
        contagem.textContent = haExtrasLista ? 'Selecione pelo menos um item (mês ou Quota Extra).' : 'Selecione pelo menos um mês.';
      }
    }
    mostrarErro(null);
  }

  function atualizarCartao(m) {
    if (!m.btn) return;
    m.btn.classList.toggle('selected', m.pode && m.ativo);
    m.btn.setAttribute('aria-pressed', m.pode && m.ativo ? 'true' : 'false');
    var valor = m.btn.querySelector('.mes-btn-valor');
    if (valor) valor.textContent = m.pode ? eur(m.disponivel) : '0,00 €';
  }

  function criarCartao(m) {
    var eExtra = Number(m.quotaId) < 0;
    var col = document.createElement('div');
    col.className = 'col-6 col-md-4 col-lg-3';

    var botao = document.createElement('button');
    botao.type = 'button';
    botao.className = 'mes-btn btn btn-sm w-100 text-start p-2' + (eExtra ? ' mes-btn-extra' : '');
    // Identificação completa — a fração correta é sempre a do contexto aberto.
    botao.dataset.quotaId = String(m.quotaId);
    botao.dataset.fracaoId = atualFracaoId == null ? '' : String(atualFracaoId);
    botao.dataset.ano = String(m.ano);
    botao.dataset.mes = String(m.mes);
    botao.dataset.disponivel = (m.disponivel || 0).toFixed(2);
    botao.dataset.pode = m.pode ? '1' : '0';
    botao.setAttribute('aria-pressed', m.pode && m.ativo ? 'true' : 'false');
    botao.title = eExtra
      ? m.rotulo + ' · Pago ' + eur(m.pago) + ' · Disponível ' + eur(m.disponivel)
      : m.rotulo
        + ' · Quota ' + eur(m.quota)
        + ' · Pago ' + eur(m.pago)
        + ' · Já em recibo ' + eur(m.coberto)
        + ' · Disponível ' + eur(m.disponivel);

    var mesLinha = document.createElement('div');
    mesLinha.className = 'mes-btn-mes';
    mesLinha.textContent = m.rotulo;

    var valorLinha = document.createElement('div');
    valorLinha.className = 'mes-btn-valor';
    valorLinha.textContent = m.pode ? eur(m.disponivel) : '0,00 €';

    botao.appendChild(mesLinha);
    botao.appendChild(valorLinha);

    // Meses disponíveis entram pré-selecionados (cadência do plano antiga);
    // Quotas Extra ficam à escolha do administrador dentro do mesmo modal.
    m.ativo = m.pode && !eExtra;
    m.btn = botao;
    if (!m.pode) {
      botao.disabled = true;
      botao.classList.add('sem-valor');
    }
    botao.addEventListener('click', function () {
      if (!m.pode) return;
      m.ativo = !m.ativo;
      atualizarCartao(m);
      atualizar();
    });

    col.appendChild(botao);
    return col;
  }

  function abrirModal(fracaoId, designacao) {
    var meses = porFracao[String(fracaoId)] || [];
    atualFracaoId = fracaoId;
    mesesAtuais = [];
    lista.innerHTML = '';
    fracaoTexto.innerHTML = 'Fração: <strong>' + designacao + '</strong>';
    // A fração correta segue EXPLICITAMENTE no formulário da emissão.
    campoFracaoId.value = String(fracaoId);
    lista.dataset.fracaoId = String(fracaoId);

    var totalC = 0;
    if (!meses.length) {
      var colVazio = document.createElement('div');
      colVazio.className = 'col-12';
      colVazio.innerHTML = '<p class="text-muted small text-center py-2 mb-0">Sem quotas disponíveis para esta fração.</p>';
      lista.appendChild(colVazio);
    }
    meses.forEach(function (m) {
      if (m.pode) totalC += m.dispC;
      m.cbx = null;
      mesesAtuais.push(m);
      lista.appendChild(criarCartao(m));
    });
    disponivelTotal.textContent = eurC(totalC);
    selectModo.value = 'plano';
    atualizar();
  }

  formEmitir.addEventListener('submit', function (e) {
    var sel = selecionados();
    if (!campoFracaoId.value || !atualFracaoId) {
      mostrarErro('Fração em falta. Reabra a emissão e tente novamente.');
      e.preventDefault();
      return;
    }
    if (!sel.length) {
      mostrarErro('Selecione pelo menos um item disponível (mês ou Quota Extra).');
      e.preventDefault();
      return;
    }
    if (selectModo.value === 'unico') {
      var valorC = paraCents(campoValor.value);
      var maxC = maxSelecionadoC();
      if (!Number.isFinite(valorC) || valorC <= 0) {
        mostrarErro('Indique um valor válido a emitir.');
        e.preventDefault();
        return;
      }
      if (valorC > maxC) {
        mostrarErro('O valor não pode ser superior ao valor disponível para emissão.');
        e.preventDefault();
        return;
      }
    }
    var existentes = formEmitir.querySelectorAll('input[name="meses"]');
    for (var i = 0; i < existentes.length; i++) existentes[i].remove();
    sel.forEach(function (m) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'meses';
      input.value = String(m.quotaId);
      formEmitir.appendChild(input);
    });
    campoValor.disabled = false;
  });

  if (modalEmitir) {
    modalEmitir.addEventListener('show.bs.modal', function (e) {
      var btn = e.relatedTarget;
      if (!btn) return;
      abrirModal(btn.dataset.fracao, btn.dataset.designacao);
    });
  }
  if (selectModo) {
    selectModo.addEventListener('change', function () {
      if (selectModo.value === 'plano') {
        // "Plano" só re-seleciona meses (quotas mensais); Quotas Extra
        // permanecem como o utilizador as deixou (escolha explícita).
        mesesAtuais.forEach(function (m) {
          if (m.pode && Number(m.quotaId) >= 0) {
            m.ativo = true;
            atualizarCartao(m);
          }
        });
      }
      atualizar();
    });
  }
  if (campoValor) campoValor.addEventListener('input', function () { mostrarErro(null); });

  // Auto-abrir quando chega com ?emitir=<fracao> (aguarda o Bootstrap carregar).
  var auto = {{#if abrirEmitirFracaoId}}{{abrirEmitirFracaoId}}{{else}}null{{/if}};
  if (auto && porFracao[String(auto)]) {
    var tentarAbrirAuto = function (tentativas) {
      if (window.bootstrap) {
        var alvo = document.querySelector('.btn-emitir[data-fracao="' + auto + '"]');
        if (!alvo) return;
        var designacao = alvo.dataset.designacao || '';
        abrirModal(String(auto), designacao); // popula antes de abrir (sem flash)
        bootstrap.Modal.getOrCreateInstance(modalEmitir).show();
      } else if (tentativas < 20) {
        setTimeout(function () { tentarAbrirAuto(tentativas + 1); }, 50);
      }
    };
    tentarAbrirAuto(0);
  }

  // Modal anular
  var modalAnular = document.getElementById('modalAnular');
  var formAnular = document.getElementById('formAnular');
  var anularTitulo = document.getElementById('anularTitulo');
  if (modalAnular) {
    modalAnular.addEventListener('show.bs.modal', function (e) {
      var btn = e.relatedTarget;
      if (!btn) return;
      formAnular.action = '/admin/quotas/recibos/' + btn.dataset.id + '/anular';
      anularTitulo.textContent = 'Anular recibo ' + btn.dataset.codigo;
    });
  }
})();
</script>
