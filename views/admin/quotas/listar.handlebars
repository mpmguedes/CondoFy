<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>Quotas</h1>
    <p class="subtitle">Quotas emitidas por fração e período</p>
  </div>
  <a href="/admin/quotas/gerar" class="btn btn-primary"><span class="material-symbols-outlined me-1">auto_awesome</span>Gerar quotas</a>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="card stat-card h-100"><div class="card-body">
      <div class="stat-label">Valor por permilagem</div>
      <div class="stat-value">{{quotaConfig.valorPermilagem}} €</div>
      <button class="btn btn-sm btn-outline-primary mt-2" data-bs-toggle="modal" data-bs-target="#modalConfig"><span class="material-symbols-outlined me-1">tune</span>Alterar</button>
    </div></div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card h-100"><div class="card-body">
      <div class="stat-label">Fundo Comum de Reserva</div>
      <div class="stat-value">{{quotaConfig.fcrPercentagem}}%</div>
    </div></div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card h-100"><div class="card-body">
      <div class="stat-label">Quotas previstas / mês</div>
      <div class="stat-value">{{eur previstasMes}}</div>
    </div></div>
  </div>
</div>

<div class="modal fade" id="modalConfig" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/admin/quotas/config" method="POST">
        <div class="modal-header">
          <h5 class="modal-title">Configuração das Quotas</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Valor por permilagem (€ por 1‰)</label>
            <input type="text" class="form-control" name="valor_permilagem" value="{{quotaConfig.valorPermilagem}}" />
          </div>
          <div class="mb-3">
            <label class="form-label">Fundo Comum de Reserva (%)</label>
            <input type="number" class="form-control" name="fcr_percentagem" value="{{quotaConfig.fcrPercentagem}}" min="0" max="100" />
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="recalcular" id="recalcular" value="futuras" />
            <label class="form-check-label" for="recalcular">Recalcular quotas futuras ainda não pagas</label>
          </div>
          <p class="form-text mt-2">A alteração destes valores afeta o cálculo das quotas das frações. Deve ser suportada pela respetiva ata de assembleia de condóminos. Quotas já pagas nunca são alteradas.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form action="/admin/quotas" method="GET" class="row g-2 align-items-end">
      <div class="col-4 col-md-2">
        <label class="form-label">Ano</label>
        <select class="form-select" name="ano">
          <option value="">Todos</option>
          {{#each anos}}<option value="{{this}}" {{selected ../filtros.ano this}}>{{this}}</option>{{/each}}
        </select>
      </div>
      <div class="col-4 col-md-3">
        <label class="form-label">Mês</label>
        <select class="form-select" name="mes">
          <option value="">Todos</option>
          {{#each meses}}<option value="{{inc @index}}" {{selected ../filtros.mes (inc @index)}}>{{this}}</option>{{/each}}
        </select>
      </div>
      <div class="col-4 col-md-3">
        <label class="form-label">Estado</label>
        <select class="form-select" name="estado">
          <option value="">Todos</option>
          <option value="pendente" {{selected filtros.estado 'pendente'}}>Pendente</option>
          <option value="parcialmente_paga" {{selected filtros.estado 'parcialmente_paga'}}>Parcialmente paga</option>
          <option value="paga" {{selected filtros.estado 'paga'}}>Paga</option>
          <option value="vencida" {{selected filtros.estado 'vencida'}}>Vencida</option>
          <option value="anulada" {{selected filtros.estado 'anulada'}}>Anulada</option>
        </select>
      </div>
      <div class="col-12 col-md-2 d-grid">
        <button type="submit" class="btn btn-outline-primary"><span class="material-symbols-outlined me-1">filter_list</span>Filtrar</button>
      </div>
    </form>
  </div>
</div>

{{#if quotas}}
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>N.º</th>
          <th>Fração</th>
          <th>Período</th>
          <th>Vencimento</th>
          <th class="text-end">Valor</th>
          <th class="text-end">Pago</th>
          <th class="text-end">Em aberto</th>
          <th>Estado</th>
          <th class="text-end">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each quotas}}
        <tr>
          <td class="font-monospace small">{{numero_documento}}</td>
          <td class="fw-semibold">{{fracao.designacao}}</td>
          <td>{{monthName mes}} {{ano}}</td>
          <td>{{formatDate data_vencimento}}</td>
          <td class="text-end">{{eur valor}}</td>
          <td class="text-end">{{eur pago}}</td>
          <td class="text-end fw-semibold">{{eur emAberto}}</td>
          <td>
            {{#if (eq estadoEfetivo 'paga')}}<span class="badge text-bg-success">Paga</span>
            {{else if (eq estadoEfetivo 'parcialmente_paga')}}<span class="badge text-bg-info">Parcial</span>
            {{else if (eq estadoEfetivo 'vencida')}}<span class="badge text-bg-danger">Vencida</span>
            {{else if (eq estadoEfetivo 'anulada')}}<span class="badge text-bg-secondary">Anulada</span>
            {{else}}<span class="badge text-bg-warning">Pendente</span>{{/if}}
          </td>
          <td class="text-end text-nowrap">
            <a href="/admin/quotas/{{id}}/aviso" target="_blank" class="btn btn-sm btn-outline-primary" title="Aviso PDF"><span class="material-symbols-outlined">picture_as_pdf</span></a>
            <a href="/admin/quotas/{{id}}" class="btn btn-sm btn-outline-secondary" title="Ver"><span class="material-symbols-outlined">visibility</span></a>
            <a href="/admin/quotas/{{id}}/editar" class="btn btn-sm btn-outline-secondary" title="Editar"><span class="material-symbols-outlined">edit</span></a>
            <form action="/admin/quotas/{{id}}/anular" method="POST" class="d-inline" onsubmit="return confirm('Anular esta quota?');">
              <button class="btn btn-sm btn-outline-danger" title="Anular"><span class="material-symbols-outlined">block</span></button>
            </form>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
{{> _empty-state icon="receipt_long" titulo="Sem quotas" descricao="Ainda não há quotas para os filtros selecionados."}}
{{/if}}
