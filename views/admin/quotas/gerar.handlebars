<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>Gerar quotas</h1>
    <p class="subtitle">Quotas calculadas por permilagem + Fundo Comum de Reserva (FCR)</p>
  </div>
  <a href="/admin/quotas" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1" aria-hidden="true">arrow_back</span>Voltar</a>
</div>

<form action="/admin/quotas/gerar" method="POST" id="wizard">
  <ol class="stepper">
    <li class="step" data-step="1"><span class="step-circle">1</span><span class="step-label">Período</span></li>
    <li class="step" data-step="2"><span class="step-circle">2</span><span class="step-label">Pré-visualização</span></li>
    <li class="step" data-step="3"><span class="step-circle">3</span><span class="step-label">Confirmação</span></li>
  </ol>

  <div class="card">
    <div class="card-body">
      <div class="wizard-step" data-step="1">
        <h2 class="h5 mb-3">Período e método</h2>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">Método de cálculo</label>
            <div class="form-check py-2">
              <input class="form-check-input" type="radio" name="metodo" id="metodoPerm" value="permilagem" checked onchange="alternarMetodo()" />
              <label class="form-check-label" for="metodoPerm">Permilagem + FCR (configuração)</label>
            </div>
            <div class="form-check py-2">
              <input class="form-check-input" type="radio" name="metodo" id="metodoOrcamento" value="orcamento" onchange="alternarMetodo()" />
              <label class="form-check-label" for="metodoOrcamento">Orçamento define a receita</label>
            </div>
            <div id="campoOrcamento" class="d-none mt-2">
              <label class="form-label">Orçamento *</label>
              <select class="form-select" name="orcamento_id" id="wOrcamento">
                <option value="">— Selecionar —</option>
                {{#each orcamentos}}<option value="{{id}}">{{designacao}} ({{eur total}}/ano)</option>{{/each}}
              </select>
              <p class="form-text">O total anual de rubricas do orçamento é distribuído pelas frações por permilagem e dividido em 12 meses. O FCR é uma componente desse valor ({{quotaConfig.fcrPercentagem}}%), não uma rubrica adicional — o total da quota mantém-se.</p>
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label">Âmbito</label>
              <div class="form-check py-2">
                <input class="form-check-input" type="radio" name="escopo" id="escopoMes" value="mes" checked />
                <label class="form-check-label" for="escopoMes">Gerar para um mês</label>
              </div>
              <div class="form-check py-2">
                <input class="form-check-input" type="radio" name="escopo" id="escopoAno" value="ano" />
                <label class="form-check-label" for="escopoAno">Gerar para todo o ano</label>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label">Ano *</label>
              <input type="number" class="form-control" name="ano" id="wAno" value="{{currentYear}}" min="2020" max="2100" required />
            </div>
            <div class="mb-3" id="campoMes">
              <label class="form-label">Mês *</label>
              <select class="form-select" name="mes" id="wMes">
                <option value="1" {{selected currentMonth 1}}>Janeiro</option>
                <option value="2" {{selected currentMonth 2}}>Fevereiro</option>
                <option value="3" {{selected currentMonth 3}}>Março</option>
                <option value="4" {{selected currentMonth 4}}>Abril</option>
                <option value="5" {{selected currentMonth 5}}>Maio</option>
                <option value="6" {{selected currentMonth 6}}>Junho</option>
                <option value="7" {{selected currentMonth 7}}>Julho</option>
                <option value="8" {{selected currentMonth 8}}>Agosto</option>
                <option value="9" {{selected currentMonth 9}}>Setembro</option>
                <option value="10" {{selected currentMonth 10}}>Outubro</option>
                <option value="11" {{selected currentMonth 11}}>Novembro</option>
                <option value="12" {{selected currentMonth 12}}>Dezembro</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Dia de vencimento</label>
              <input type="number" class="form-control" name="vencimento_dia" id="wVencimento" value="8" min="1" max="28" />
            </div>
          </div>
        </div>
      </div>

      <div class="wizard-step d-none" data-step="2">
        <h2 class="h5 mb-3">Pré-visualização</h2>
        <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
          <span class="material-symbols-outlined">info</span>
          <span id="infoMetodo">Valor por 1000‰: <strong>{{quotaConfig.valorPor1000}} €</strong> · FCR: <strong>{{quotaConfig.fcrPercentagem}}%</strong></span>
        </div>
        <div class="table-responsive">
          <table class="table align-middle">
            <thead class="table-light">
              <tr><th>Fração</th><th class="text-end">Permilagem</th><th class="text-end">Base</th><th class="text-end">FCR</th><th class="text-end">Total</th></tr>
            </thead>
            <tbody id="previewBody"></tbody>
            <tfoot class="table-light">
              <tr><th>TOTAL</th><th></th><th></th><th></th><th class="text-end" id="previewTotal">0,00 €</th></tr>
            </tfoot>
          </table>
        </div>
      </div>

      <div class="wizard-step d-none" data-step="3">
        <h2 class="h5 mb-3">Confirmação</h2>
        <p class="mb-1" id="resumoGeracao"></p>
        <p class="text-muted mb-0">Quotas já existentes (fração + mês + ano) não serão duplicadas.</p>
      </div>
    </div>

    <div class="card-footer d-flex justify-content-between bg-white">
      <a href="/admin/quotas" class="btn btn-outline-secondary">Cancelar</a>
      <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary d-none" id="btnVoltar" onclick="wizard.go(-1)">Voltar</button>
        <button type="button" class="btn btn-primary d-none" id="btnContinuar" onclick="wizard.go(1)">Continuar</button>
        <button type="submit" class="btn btn-primary d-none" id="btnGerar" data-ajuda="Cria as quotas do período indicado para todas as frações ativas. As quotas já existentes para as mesmas frações e meses são ignoradas." data-ajuda-titulo="Gerar quotas"><span class="material-symbols-outlined me-1" aria-hidden="true">auto_awesome</span>Gerar quotas</button>
      </div>
    </div>
  </div>

{{!-- Documentos e comunicação (dentro do formulário — submetido com a geração) --}}
<div class="card mt-4">
  <div class="card-header bg-white"><i class="bi bi-file-earmark-plus me-1"></i>Documentos e comunicação</div>
  <div class="card-body">
    <div class="form-check form-switch mb-2">
      <input class="form-check-input" type="checkbox" role="switch" id="guardarDrive" name="guardar_drive" value="on" {{#if autoQuotas.drive}}checked{{/if}} {{#unless driveLigado}}disabled{{/unless}} data-ajuda="Guarda uma cópia do aviso de quota no serviço de armazenamento do condomínio, logo após a geração." data-ajuda-titulo="Guardar aviso no armazenamento" />
      <label class="form-check-label" for="guardarDrive"><i class="{{@root.armazenamentoIcone}} me-1"></i>Guardar automaticamente no {{@root.armazenamentoRotulo}}</label>
      {{#unless driveLigado}}<div class="form-text">Ligue um serviço de armazenamento em Configurações → Armazenamento e Backups para ativar esta opção.</div>{{/unless}}
    </div>
    <div class="form-check form-switch mb-2">
      <input class="form-check-input" type="checkbox" role="switch" id="enviarEmail" name="enviar_email" value="on" {{#if autoQuotas.email}}checked{{/if}} data-ajuda="Envia o aviso de quota por email a cada condómino logo após a geração. Sem esta opção, os avisos ficam apenas na aplicação." data-ajuda-titulo="Enviar quotas por email" />
      <label class="form-check-label" for="enviarEmail">Enviar quotas por email (imediatamente após gerar)</label>
    </div>
    {{!-- ⛔ P2 — indicador de LEITURA, não um controlo de formulário.
         Aqui estava um `<input type="checkbox" disabled name="envio_automatico">`:
         um controlo permanentemente desativado, que o browser nunca submete e
         que o servidor nunca lê. O `POST /quotas/gerar` decide o envio por
         `enviar_email` OU por `auto_quotas_automatico` (routes/financeiro.js),
         e o campo desativado não entra em nenhum dos lados. Como não é
         editável aqui, não deve parecer um controlo avariado — mostra-se o
         ESTADO e o atalho para onde é realmente configurado.
         O atalho só aparece a quem o pode ABRIR: `/admin/config/automacoes`
         exige `admin`, e esta vista é alcançável ao `gestor` — um link para uma
         página proibida é um beco sem saída. Mesmo idioma do dashboard
         (`views/admin/dashboard.handlebars`). O ESTADO fica visível aos dois. --}}
    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
      <span class="small text-muted">Envio automático (automação):</span>
      {{#if autoQuotas.automatico}}
      <span class="badge text-bg-success">Ativo</span>
      <span class="form-text mb-0">Com a automação ativa, o aviso é enviado por email mesmo sem marcar a opção acima.</span>
      {{else}}
      <span class="badge text-bg-secondary">Inativo</span>
      {{/if}}
      {{#if (ne condominioAtivo.role 'gestor')}}
      <a href="/admin/config/automacoes" class="small">Configurar em Documentos e Automações</a>
      {{/if}}
    </div>
    <p class="form-text mt-1 mb-0">
      Depois de gerar, pode enviar em lote (incluindo reenvios) em <strong>Quotas → Enviar por email</strong>.
    </p>
  </div>
</div>
</form>

<script>
  const FRACOES = {{{fracoesJson}}};
  const CFG = {{{json quotaConfig}}};
  const EXISTENTES = {{{existentesJson}}};
  // Valores JÁ CALCULADOS pelo servidor, com as mesmas funções que geram e
  // gravam as quotas (`calcularQuota` no método permilagem,
  // `calcularQuotasOrcamento` no método orçamento). Esta vista NÃO calcula
  // quotas: só formata e soma o que o servidor vai gravar — não existe uma
  // segunda implementação da fórmula no browser.
  const PREVISAO = {{{previsaoJson}}};
  const fmt = (n) => n.toLocaleString('pt-PT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';

  function ehOrcamento() { return document.getElementById('metodoOrcamento').checked; }

  // Bloco de pré-visualização de uma fração no método escolhido.
  // `mes` é o mês do período (1-12): no método permilagem o valor é o mesmo em
  // todos os meses, no método orçamento vem o mês concreto (o ano é que fecha
  // exatamente — ver `calcularQuotasOrcamento`).
  function calc(f, mes) {
    const bloco = ehOrcamento()
      ? ((PREVISAO.orcamento[document.getElementById('wOrcamento').value] || {})[f.id] || null)
      : (PREVISAO.permilagem[f.id] || null);
    if (!bloco) return { base: 0, fcr: 0, total: 0, anual: 0 };
    const doMes = (bloco.meses && bloco.meses[mes - 1]) || bloco;
    return { base: doMes.base, fcr: doMes.fcr, total: doMes.total, anual: bloco.anual };
  }

  const wizard = {
    step: 1,
    go(dir) {
      const prox = this.step + dir;
      if (prox < 1 || prox > 3) return;
      if (dir === 1 && prox === 2) this.previsualizar();
      this.step = prox;
      this.render();
    },
    render() {
      document.querySelectorAll('.wizard-step').forEach((s) => s.classList.toggle('d-none', Number(s.dataset.step) !== this.step));
      document.querySelectorAll('.stepper .step').forEach((s) => {
        const n = Number(s.dataset.step);
        s.classList.toggle('active', n === this.step);
        s.classList.toggle('done', n < this.step);
      });
      document.getElementById('btnContinuar').classList.toggle('d-none', this.step === 3);
      document.getElementById('btnVoltar').classList.toggle('d-none', this.step === 1);
      document.getElementById('btnGerar').classList.toggle('d-none', this.step !== 3);
    },
    ehAno() { return document.getElementById('escopoAno').checked; },
    previsualizar() {
      if (ehOrcamento() && !document.getElementById('wOrcamento').value) {
        alert('Selecione o orçamento que define a receita.');
        return;
      }
      const ano = parseInt(document.getElementById('wAno').value, 10);
      const nMeses = this.ehAno() ? 12 : 1;
      // No escopo anual o valor mensal mostrado é o do 1.º mês do período (no
      // método permilagem é igual em todos; no método orçamento o que conta é o
      // total ANUAL, que fecha exatamente).
      const mes = this.ehAno() ? 1 : parseInt(document.getElementById('wMes').value, 10);
      const tbody = document.getElementById('previewBody');
      let html = '';
      let totalMes = 0;
      let totalAno = 0;
      let novas = 0;
      let existentes = 0;
      for (const f of FRACOES) {
        const r = calc(f, mes);
        totalMes += r.total;
        totalAno += r.anual === undefined ? r.total : r.anual;
        html += `<tr><td>${f.designacao}</td><td class="text-end">${f.permilagem} ‰</td><td class="text-end">${fmt(r.base)}</td><td class="text-end">${fmt(r.fcr)}</td><td class="text-end fw-semibold">${fmt(r.total)}</td></tr>`;
        for (let m = 1; m <= 12; m++) {
          if (!this.ehAno() && m !== mes) continue;
          if (EXISTENTES[f.id + '|' + ano + '|' + m]) existentes++;
          else novas++;
        }
      }
      tbody.innerHTML = html;
      const possiveis = novas + existentes;
      // C3: no escopo anual mostra-se o TOTAL ANUAL exato (fecha com o
      // orçamento), não a soma dos mensais arredondados — que divergiria por
      // cêntimos. No escopo mensal mostra-se o mês.
      document.getElementById('previewTotal').textContent = fmt(this.ehAno() ? totalAno : totalMes);
      document.getElementById('resumoGeracao').innerHTML =
        '<strong>' + FRACOES.length + ' frações</strong> × <strong>' + nMeses + ' meses</strong> = ' +
        '<strong>' + possiveis + ' quotas possíveis</strong><br>' +
        existentes + ' quotas já existentes<br>' +
        '<strong>' + novas + ' novas quotas serão criadas.</strong>';
    },
  };

  function alternarEscopo() {
    document.getElementById('campoMes').classList.toggle('d-none', document.getElementById('escopoAno').checked);
  }
  function alternarMetodo() {
    const orc = ehOrcamento();
    document.getElementById('campoOrcamento').classList.toggle('d-none', !orc);
    document.getElementById('infoMetodo').innerHTML = orc
      ? 'A receita mensal é o total de rubricas do orçamento distribuído por permilagem, dividido em 12 meses. O FCR (<strong>' + CFG.fcrPercentagem + '%</strong>) é uma componente dessa quota, não um valor a somar.'
      : 'Valor por 1000‰: <strong>' + CFG.valorPor1000 + ' €</strong> · FCR: <strong>' + CFG.fcrPercentagem + '%</strong>';
  }
  document.getElementById('escopoMes').addEventListener('change', alternarEscopo);
  document.getElementById('escopoAno').addEventListener('change', alternarEscopo);
  alternarEscopo();
  alternarMetodo();
  wizard.render();
</script>
