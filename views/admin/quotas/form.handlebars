<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <h1>{{titulo}}</h1>
  <a href="/admin/quotas" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1">arrow_back</span>Voltar</a>
</div>

<div class="row">
  <div class="col-12 col-lg-7">
    <div class="card">
      <div class="card-body">
        <form action="/admin/quotas/{{quota.id}}" method="POST">
          <div class="mb-3">
            <label class="form-label">Fração</label>
            <input type="text" class="form-control" value="{{quota.fracao.designacao}}" disabled />
          </div>
          <div class="mb-3">
            <label class="form-label">Valor (€) *</label>
            <input type="text" class="form-control" name="valor" value="{{quota.valor}}" required />
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Data de emissão</label>
              <input type="date" class="form-control" name="data_emissao" value="{{dateInput quota.data_emissao}}" />
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Data de vencimento</label>
              <input type="date" class="form-control" name="data_vencimento" value="{{dateInput quota.data_vencimento}}" />
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Observações</label>
            <textarea class="form-control" name="observacoes" rows="2">{{quota.observacoes}}</textarea>
          </div>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </form>
      </div>
    </div>
  </div>
</div>
