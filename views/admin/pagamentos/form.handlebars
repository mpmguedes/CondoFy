<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><i class="bi bi-cash-coin me-2"></i>{{titulo}}</h1>
  <a href="/admin/pagamentos" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Voltar</a>
</div>

<div class="row">
  <div class="col-12 col-lg-7">
    <div class="card">
      <div class="card-body">
        <form action="/admin/pagamentos" method="POST">
          <div class="mb-3">
            <label class="form-label">Fração *</label>
            <select class="form-select" name="fracao_id" required>
              <option value="">— Selecionar fração —</option>
              {{#each fracoes}}
              <option value="{{id}}">{{designacao}}</option>
              {{/each}}
            </select>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Valor (€) *</label>
              <input type="text" class="form-control" name="valor" required />
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Data do pagamento</label>
              <input type="date" class="form-control" name="data_pagamento" value="{{currentYear}}-{{#if currentYear}}01-01{{/if}}" />
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Método de pagamento</label>
              <select class="form-select" name="metodo_pagamento_id">
                <option value="">— Sem método —</option>
                {{#each metodos}}
                <option value="{{id}}">{{nome}}</option>
                {{/each}}
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Conta bancária</label>
              <select class="form-select" name="conta_bancaria_id">
                <option value="">— Sem conta —</option>
                {{#each contas}}
                <option value="{{id}}">{{nome}}</option>
                {{/each}}
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Referência</label>
            <input type="text" class="form-control" name="referencia" placeholder="ex.: entidade/referência multibanco" />
          </div>
          <div class="mb-3">
            <label class="form-label">Observações</label>
            <textarea class="form-control" name="observacoes" rows="2"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Registar pagamento</button>
        </form>
      </div>
    </div>
  </div>
  <div class="col-12 col-lg-5">
    <div class="card">
      <div class="card-header bg-white"><i class="bi bi-info-circle me-1"></i>Como funciona</div>
      <div class="card-body text-muted small">
        <p class="mb-0">O valor é distribuído automaticamente pelas quotas em aberto da fração (da mais antiga para a mais recente). É gerado um recibo com número sequencial.</p>
      </div>
    </div>
  </div>
</div>
