<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <h1 class="h3 mb-0"><i class="bi bi-cash-coin me-2"></i>Pagamentos</h1>
  <a href="/admin/pagamentos/nova" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Registar pagamento</a>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Recibo</th>
          <th>Fração</th>
          <th>Data</th>
          <th>Método</th>
          <th class="text-end">Valor</th>
          <th>Estado</th>
          <th class="text-end">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each pagamentos}}
        <tr>
          <td class="font-monospace small">{{numero_documento}}</td>
          <td class="fw-semibold">{{fracao.designacao}}</td>
          <td>{{formatDate data_pagamento}}</td>
          <td>{{#if metodo_pagamento}}{{metodo_pagamento.nome}}{{else}}—{{/if}}</td>
          <td class="text-end fw-semibold">{{eur valor}}</td>
          <td>
            {{#if (eq estado 'confirmado')}}<span class="badge text-bg-success">Confirmado</span>
            {{else}}<span class="badge text-bg-secondary">Anulado</span>{{/if}}
          </td>
          <td class="text-end text-nowrap">
            <a href="/admin/pagamentos/{{id}}/recibo" target="_blank" class="btn btn-sm btn-outline-primary" title="Recibo PDF"><i class="bi bi-file-earmark-pdf"></i></a>
            <a href="/admin/pagamentos/{{id}}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
            {{#if (eq estado 'confirmado')}}
            <form action="/admin/pagamentos/{{id}}/anular" method="POST" class="d-inline" onsubmit="return confirm('Anular este pagamento?');">
              <button class="btn btn-sm btn-outline-danger"><i class="bi bi-slash-circle"></i></button>
            </form>
            {{/if}}
          </td>
        </tr>
        {{else}}
        <tr><td colspan="7" class="text-center text-muted py-4">Sem pagamentos.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
