<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>Pagamentos</h1>
    <p class="subtitle">Recebimentos de quotas e respetivos recibos</p>
  </div>
  <a href="/admin/pagamentos/enviar-recibos" class="btn btn-outline-primary"><span class="material-symbols-outlined me-1">mail</span>Enviar recibos</a>
  <a href="/admin/pagamentos/nova" class="btn btn-primary"><span class="material-symbols-outlined me-1">add</span>Registar pagamento</a>
</div>

{{#if pagamentos}}
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Recibo</th>
          <th>Fração</th>
          <th>Data</th>
          <th>Método</th>
          <th class="text-end">Valor</th>
          <th>Estado</th>
          <th class="text-end">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each pagamentos}}
        <tr>
          <td class="font-monospace small">{{numero_documento}}</td>
          <td class="fw-semibold">{{fracao.designacao}}</td>
          <td>{{formatDate data_pagamento}}</td>
          <td>{{#if metodo_pagamento}}{{metodo_pagamento.nome}}{{else}}—{{/if}}</td>
          <td class="text-end fw-semibold">{{eur valor}}</td>
          <td>
            {{#if (eq estado 'confirmado')}}<span class="badge text-bg-success">Confirmado</span>
            {{else}}<span class="badge text-bg-secondary">Anulado</span>{{/if}}
          </td>
          <td class="text-end text-nowrap">
            <a href="/admin/pagamentos/{{id}}/recibo" target="_blank" class="btn btn-sm btn-outline-primary" title="Recibo PDF"><span class="material-symbols-outlined">picture_as_pdf</span></a>
            {{#if ../driveLigado}}
            <form action="/admin/pagamentos/{{id}}/recibo/drive" method="POST" class="d-inline">
              <button class="btn btn-sm btn-outline-secondary" title="Guardar recibo no Google Drive"><span class="material-symbols-outlined">cloud_upload</span></button>
            </form>
            {{/if}}
            <a href="/admin/pagamentos/{{id}}" class="btn btn-sm btn-outline-secondary" title="Ver"><span class="material-symbols-outlined">visibility</span></a>
            {{#if (eq estado 'confirmado')}}
            <form action="/admin/pagamentos/{{id}}/anular" method="POST" class="d-inline" onsubmit="return confirm('Anular este pagamento?');">
              <button class="btn btn-sm btn-outline-danger" title="Anular"><span class="material-symbols-outlined">block</span></button>
            </form>
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
{{> _empty-state icon="payments" titulo="Sem pagamentos" descricao="Registe o primeiro pagamento de quota." link="/admin/pagamentos/nova" linkTexto="Registar pagamento"}}
{{/if}}
