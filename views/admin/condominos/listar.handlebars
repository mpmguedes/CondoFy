<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>Condóminos</h1>
    <p class="subtitle">Proprietários e arrendatários das frações</p>
  </div>
  <a href="/admin/condominos/nova" class="btn btn-primary"><span class="material-symbols-outlined me-1">person_add</span>Novo condómino</a>
</div>

{{#if pessoas}}
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Nome</th>
          <th>Email</th>
          <th>Telefone</th>
          <th>NIF</th>
          <th>Tipo</th>
          <th>Frações</th>
          <th class="text-end">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each pessoas}}
        <tr>
          <td class="fw-semibold">{{nome}}</td>
          <td>{{#if email}}{{email}}{{else}}—{{/if}}</td>
          <td>{{#if telefone}}{{telefone}}{{else}}—{{/if}}</td>
          <td>{{#if nif}}{{nif}}{{else}}—{{/if}}</td>
          <td>
            {{#if (eq tipo 'proprietario')}}<span class="badge text-bg-primary">Proprietário</span>
            {{else if (eq tipo 'arrendatario')}}<span class="badge text-bg-info">Arrendatário</span>
            {{else}}<span class="badge text-bg-secondary">Outro</span>{{/if}}
          </td>
          <td>
            {{#each fracoes}}
              <span class="badge text-bg-light border">{{designacao}}</span>
            {{else}}
              <span class="text-muted">—</span>
            {{/each}}
          </td>
          <td class="text-end">
            <a href="/admin/condominos/{{id}}/editar" class="btn btn-sm btn-outline-secondary" title="Editar"><span class="material-symbols-outlined">edit</span></a>
            <form action="/admin/condominos/{{id}}/eliminar" method="POST" class="d-inline" onsubmit="return confirm('Eliminar este condómino?');">
              <button class="btn btn-sm btn-outline-danger" title="Eliminar"><span class="material-symbols-outlined">delete</span></button>
            </form>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
{{> _empty-state icon="groups" titulo="Ainda não existem condóminos" descricao="Adicione o primeiro condómino (proprietário ou arrendatário) e associe-o às frações." link="/admin/condominos/nova" linkTexto="Novo condómino"}}
{{/if}}
