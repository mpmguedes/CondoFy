<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><i class="bi bi-people me-2"></i>{{titulo}}</h1>
  <a href="/admin/condominos" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Voltar</a>
</div>

<div class="row">
  <div class="col-12 col-lg-8">
    <div class="card">
      <div class="card-body">
        <form action="{{#if pessoa}}/admin/condominos/{{pessoa.id}}{{else}}/admin/condominos{{/if}}" method="POST">
          <div class="mb-3">
            <label class="form-label">Nome *</label>
            <input type="text" class="form-control" name="nome" value="{{pessoa.nome}}" required />
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Email</label>
              <input type="email" class="form-control" name="email" value="{{pessoa.email}}" />
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Telefone</label>
              <input type="text" class="form-control" name="telefone" value="{{pessoa.telefone}}" />
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">NIF</label>
              <input type="text" class="form-control" name="nif" value="{{pessoa.nif}}" />
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Tipo</label>
              <select class="form-select" name="tipo">
                <option value="proprietario" {{selected pessoa.tipo 'proprietario'}}>Proprietário</option>
                <option value="arrendatario" {{selected pessoa.tipo 'arrendatario'}}>Arrendatário</option>
                <option value="outro" {{selected pessoa.tipo 'outro'}}>Outro</option>
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Observações</label>
            <textarea class="form-control" name="observacoes" rows="2">{{pessoa.observacoes}}</textarea>
          </div>
          {{#if pessoa}}
          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="ativo" name="ativo" {{#if pessoa.ativo}}checked{{/if}} />
            <label class="form-check-label" for="ativo">Ativo</label>
          </div>
          {{/if}}
          <button type="submit" class="btn btn-primary">Guardar</button>
        </form>
      </div>
    </div>
  </div>

  {{#if pessoa}}
  <div class="col-12 col-lg-4">
    <div class="card">
      <div class="card-header bg-white"><i class="bi bi-building me-1"></i>Frações associadas</div>
      <div class="card-body">
        <ul class="list-group list-group-flush">
          {{#each pessoa.fracoes}}
          <li class="list-group-item d-flex justify-content-between align-items-center px-0">
            <span>{{designacao}}</span>
            <span class="badge text-bg-light border">{{this.FracaoPessoa.vinculo}}</span>
          </li>
          {{else}}
          <li class="list-group-item text-muted px-0">Sem frações associadas.</li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
  {{/if}}
</div>
