<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>Contas bancárias</h1>
    <p class="subtitle">Contas do condomínio e saldos</p>
  </div>
  <a href="/admin/contas/nova" class="btn btn-primary"><span class="material-symbols-outlined me-1">add</span>Nova conta</a>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-4 col-lg-3">
    <div class="card stat-card h-100"><div class="card-body">
      <div class="stat-label">Saldo total</div>
      <div class="stat-value">{{eur resumo.saldoContas}}</div>
    </div></div>
  </div>
  <div class="col-6 col-md-4 col-lg-3">
    <div class="card stat-card h-100"><div class="card-body">
      <div class="stat-label">Fundo de reserva</div>
      <div class="stat-value">{{eur resumo.fundoReserva}}</div>
    </div></div>
  </div>
</div>

{{#if contas}}
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Nome</th>
          <th>Banco</th>
          <th>IBAN</th>
          <th>Tipo</th>
          <th class="text-end">Saldo</th>
          <th>Estado</th>
          <th class="text-end">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each contas}}
        <tr>
          <td class="fw-semibold">{{nome}}</td>
          <td>{{#if banco}}{{banco}}{{else}}—{{/if}}</td>
          <td><span class="font-monospace small">{{#if iban}}{{iban}}{{else}}—{{/if}}</span></td>
          <td>
            {{#if (eq tipo 'fundo_reserva')}}<span class="badge text-bg-warning">Fundo de reserva</span>
            {{else if (eq tipo 'poupanca')}}<span class="badge text-bg-info">Poupança</span>
            {{else if (eq tipo 'corrente')}}<span class="badge text-bg-primary">Corrente</span>
            {{else}}<span class="badge text-bg-secondary">Outra</span>{{/if}}
          </td>
          <td class="text-end fw-semibold">{{eur saldo}}</td>
          <td>{{#if ativa}}<span class="badge text-bg-success">Ativa</span>{{else}}<span class="badge text-bg-secondary">Inativa</span>{{/if}}</td>
          <td class="text-end">
            <a href="/admin/contas/{{id}}/editar" class="btn btn-sm btn-outline-secondary" title="Editar"><span class="material-symbols-outlined">edit</span></a>
            <form action="/admin/contas/{{id}}/eliminar" method="POST" class="d-inline" onsubmit="return confirm('Eliminar esta conta?');">
              <button class="btn btn-sm btn-outline-danger" title="Eliminar"><span class="material-symbols-outlined">delete</span></button>
            </form>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
{{> _empty-state icon="account_balance" titulo="Sem contas bancárias" descricao="Adicione as contas do condomínio para acompanhar saldos e movimentos." link="/admin/contas/nova" linkTexto="Nova conta"}}
{{/if}}
