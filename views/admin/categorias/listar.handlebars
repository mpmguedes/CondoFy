<div class="page-heading">
  <h1>Categorias</h1>
  <p class="subtitle">Categorias de despesa e receita usadas no orçamento</p>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form action="/admin/categorias" method="POST" class="row g-2 align-items-end">
      <div class="col-12 col-md-5">
        <label class="form-label">Nome da categoria</label>
        <input type="text" class="form-control" name="nome" required />
      </div>
      <div class="col-6 col-md-3">
        <label class="form-label">Tipo</label>
        <select class="form-select" name="tipo">
          <option value="despesa">Despesa</option>
          <option value="receita">Receita</option>
        </select>
      </div>
      <div class="col-6 col-md-3 d-grid">
        <button type="submit" class="btn btn-primary"><span class="material-symbols-outlined me-1">add</span>Adicionar</button>
      </div>
    </form>
  </div>
</div>

{{#if categorias}}
<div class="card">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Nome</th>
          <th>Tipo</th>
          <th>Ativa</th>
          <th class="text-end">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each categorias}}
        <tr>
          <td><input form="cat-{{id}}" type="text" class="form-control form-control-sm" name="nome" value="{{nome}}" /></td>
          <td>
            <select form="cat-{{id}}" class="form-select form-select-sm" name="tipo">
              <option value="despesa" {{selected tipo 'despesa'}}>Despesa</option>
              <option value="receita" {{selected tipo 'receita'}}>Receita</option>
            </select>
          </td>
          <td>
            <div class="form-check form-switch">
              <input form="cat-{{id}}" class="form-check-input" type="checkbox" name="ativa" {{#if ativa}}checked{{/if}} />
            </div>
          </td>
          <td class="text-end">
            <button form="cat-{{id}}" class="btn btn-sm btn-outline-primary" title="Guardar"><span class="material-symbols-outlined">check</span></button>
            <form action="/admin/categorias/{{id}}/eliminar" method="POST" class="d-inline" onsubmit="return confirm('Eliminar esta categoria?');">
              <button class="btn btn-sm btn-outline-danger" title="Eliminar"><span class="material-symbols-outlined">delete</span></button>
            </form>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
{{> _empty-state icon="category" titulo="Sem categorias" descricao="Adicione categorias para organizar despesas e receitas."}}
{{/if}}

{{#each categorias}}<form id="cat-{{id}}" action="/admin/categorias/{{id}}" method="POST"></form>{{/each}}
