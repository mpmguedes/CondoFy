<div class="page-heading">
  <h1>{{saudacao}}, {{user.nome}}</h1>
  <p class="subtitle">Condomínio {{condominio.designacao}}</p>
</div>

<div class="quick-actions">
  <a class="quick-action" href="/admin/fracoes/nova"><span class="material-symbols-outlined" aria-hidden="true">add</span>Nova fração</a>
  <a class="quick-action" href="/admin/quotas/gerar"><span class="material-symbols-outlined" aria-hidden="true">euro</span>Gerar quotas</a>
  <a class="quick-action" href="/admin/assembleias/nova"><span class="material-symbols-outlined" aria-hidden="true">groups</span>Nova assembleia</a>
  <a class="quick-action" href="/admin/documentos/nova"><span class="material-symbols-outlined" aria-hidden="true">note_add</span>Novo documento</a>
  <a class="quick-action" href="/admin/pagamentos/nova"><span class="material-symbols-outlined" aria-hidden="true">payments</span>Registar pagamento</a>
  <a class="quick-action" href="/admin/despesas/nova"><span class="material-symbols-outlined" aria-hidden="true">credit_card</span>Nova despesa</a>
  <a class="quick-action" href="/admin/avisos/nova"><span class="material-symbols-outlined" aria-hidden="true">campaign</span>Novo aviso</a>
</div>

{{!-- SITUAÇÃO FINANCEIRA (uma área, cinco zonas) --}}
<div class="section-title">Situação financeira</div>
<div class="card mb-3">
  <div class="card-body py-3">
    <div class="painel-strip">
      <div class="strip-item"><div class="strip-label">Saldo das contas</div><div class="strip-value">{{eur resumo.saldoContas}}</div></div>
      <div class="strip-item"><div class="strip-label">Fundo de reserva</div><div class="strip-value">{{eur resumo.fundoReserva}}</div></div>
      <div class="strip-item"><div class="strip-label">Receitas</div><div class="strip-value">{{eur resumo.receitas}}</div></div>
      <div class="strip-item"><div class="strip-label">Despesas</div><div class="strip-value">{{eur resumo.despesas}}</div></div>
      <div class="strip-item"><div class="strip-label">Em dívida</div><div class="strip-value text-danger">{{eur resumo.emDividaGlobal}}</div></div>
    </div>
  </div>
</div>

{{!-- ESTE MÊS --}}
<div class="section-title">Este mês</div>
<div class="card mb-3">
  <div class="card-body py-3">
    <div class="painel-strip">
      <div class="strip-item"><div class="strip-label">Quotas previstas</div><div class="strip-value">{{eur financeiroMes.previstas}}</div></div>
      <div class="strip-item"><div class="strip-label">Recebidas</div><div class="strip-value text-success">{{eur financeiroMes.recebidas}}</div></div>
      <div class="strip-item"><div class="strip-label">Em atraso</div><div class="strip-value">{{emAtraso.count}} <span class="text-muted small">quotas</span></div></div>
      <div class="strip-item"><div class="strip-label">Total em atraso</div><div class="strip-value text-danger">{{eur emAtraso.total}}</div></div>
    </div>
  </div>
</div>

{{!-- ORÇAMENTO + ESTADO DO CONDOMÍNIO --}}
<div class="row g-3 mb-3">
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Orçamento {{anoAtual}}</span>
        {{#if orcamentoAno}}<a href="/admin/orcamento/{{orcamentoAno.id}}" class="small">Ver orçamento →</a>{{/if}}
      </div>
      <div class="card-body">
        {{#if orcamentoAno}}
        <dl class="row mb-2">
          <dt class="col-7 small text-muted">Receitas previstas (c/ FCR)</dt><dd class="col-5 text-end">{{eur orcamentoAno.receitasPrevistas}}</dd>
          <dt class="col-7 small text-muted">Despesas previstas</dt><dd class="col-5 text-end">{{eur orcamentoAno.despesasPrevistas}}</dd>
          <dt class="col-7 small text-muted">Saldo previsto</dt>
          <dd class="col-5 text-end fw-semibold {{#if (gt orcamentoAno.saldoPrevisto 0)}}text-success{{else if (lt orcamentoAno.saldoPrevisto 0)}}text-danger{{/if}}">{{eur orcamentoAno.saldoPrevisto}}</dd>
        </dl>
        <p class="text-muted small mb-2">Receitas previstas = total a cobrar aos condóminos (despesas do orçamento + FCR). O saldo previsto é a diferença para as despesas.</p>
        <span class="badge {{#if (eq orcamentoAno.estado 'rascunho')}}text-bg-secondary{{else if (eq orcamentoAno.estado 'encerrado')}}text-bg-dark{{else if (eq orcamentoAno.estado 'anulado')}}text-bg-danger{{else}}text-bg-success{{/if}}">Estado: {{#if (eq orcamentoAno.estado 'rascunho')}}Rascunho{{else if (eq orcamentoAno.estado 'encerrado')}}Fechado{{else if (eq orcamentoAno.estado 'anulado')}}Anulado{{else}}Ativo{{/if}}</span>
        {{else}}
        <p class="text-muted small mb-0">Não existe orçamento para {{anoAtual}}. <a href="/admin/orcamento/nova">Criar orçamento →</a></p>
        {{/if}}
      </div>
    </div>
  </div>
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header bg-white"><span class="fw-semibold">Estado do condomínio</span></div>
      <div class="card-body">
        <div class="d-flex flex-wrap gap-3 small">
          <div><strong>{{nFracoes}}</strong> frações</div>
          <div><strong>{{nPessoas}}</strong> condóminos</div>
          <div><strong>{{nPagas}}</strong> quotas pagas</div>
          <div class="text-muted">{{nPendentes}} pendentes · <span class="text-danger">{{nVencidas}} vencidas</span></div>
        </div>
        <hr class="my-2" />
        {{!-- Serviços: DOCUMENTOS (serviço principal deste condomínio) e
             CÓPIAS DE SEGURANÇA (a local existe sempre; a cloud é opcional e
             independente do serviço dos documentos) são linhas separadas —
             misturá-las fazia um condomínio com o Drive ligado aparecer como
             «Desligado» só porque a ligação da plataforma não existia. --}}
        <div class="small d-flex flex-column gap-1">
          <div><i class="{{@root.armazenamentoIcone}} me-1"></i>Documentos: {{#if sistema.documentos.ligado}}<span class="text-success">● {{@root.armazenamentoRotulo}}</span>{{else}}<span class="text-muted">○ Sem serviço ligado</span>{{/if}}</div>
          <div>Cópias de segurança: {{#if sistema.backups.cloud}}<i class="{{sistema.backups.cloud.icone}} me-1"></i><span class="text-success">● {{sistema.backups.cloud.rotulo}}</span>{{else}}<span class="text-muted">○ Apenas local</span>{{/if}}</div>
          <div>Último backup: {{#if sistema.ultimoBackup.data}}<span class="text-{{sistema.ultimoBackup.cor}}">● {{sistema.ultimoBackup.rotulo}}</span> · {{formatDate sistema.ultimoBackup.data}}{{#if sistema.ultimoBackup.detalhe}} <span class="text-muted">({{sistema.ultimoBackup.detalhe}})</span>{{/if}}{{else}}<span class="text-muted">○ {{sistema.ultimoBackup.rotulo}}</span>{{/if}}</div>
          <div>Email/SMTP: {{#if sistema.smtp}}<span class="text-success">● Configurado</span>{{else}}<span class="text-muted">○ Não configurado</span>{{/if}}</div>
        </div>
      </div>
    </div>
  </div>
</div>

{{!-- O QUE PRECISA DE ATENÇÃO HOJE (Fase 2H.2, A14 §9)

     Só PROBLEMAS e situações operacionais que exigem intervenção. O que falta
     CONFIGURAR não aparece aqui — está no bloco de preparação mais abaixo,
     para que «ainda não configurou X» nunca pareça um erro.

     ⛔ O texto deste comentário NÃO pode conter o rótulo da secção seguinte
     («Preparação» + «do condomínio» seguidos): testes e cortes de vista usam
     essa frase como âncora e apanhariam o comentário em vez do título.

     Só aparece o que existe realmente a tratar (nenhum zero é apresentado como
     problema) e cada linha leva à ação correspondente. A decisão de que sinais
     existem e a que lista pertencem é do ajudante `helpers/dashboard.js`
     (lógica pura, testada offline); aqui só se apresenta o que ele já separou.

     O estado dos serviços (armazenamento, email, backups) continua onde já
     estava — no cartão «Estado do condomínio» —, para não repetir a mesma
     informação em dois sítios. --}}
<div class="section-title">Precisa de atenção</div>
<div class="card mb-3">
  <div class="card-body py-2">
    {{#if sinaisAtencao.length}}
    <ul class="atencao-lista">
      {{#each sinaisAtencao}}
      <li class="atencao-item">
        <a class="atencao-sinal atencao-{{gravidade}}" href="{{destino.url}}">
          <span class="atencao-marca" aria-hidden="true"></span>
          <span class="atencao-texto">{{texto}}</span>
          <span class="atencao-acao">{{destino.texto}}<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></span>
        </a>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <div class="text-success small py-1"><i class="bi bi-check-circle me-1"></i>Nada a tratar neste momento.</div>
    {{/if}}

    {{#if (or (gt sistema.filaPendentes 0) (gt sistema.filaErros 0))}}
    <div class="atencao-estado small">
      {{!-- Emails exige `comPapel('admin')` (routes/emails.js): o gestor vê a
           contagem mas não um link que o expulsaria para `/`. O papel vem de
           `condominioAtivo.role` (associação ativa), nunca de `users.role`. --}}
      {{#if (ne condominioAtivo.role 'gestor')}}
      <div>Fila de emails: <a href="/admin/emails">{{sistema.filaPendentes}} por enviar · <span class="{{#if (gt sistema.filaErros 0)}}text-danger{{/if}}">{{sistema.filaErros}} com erro</span></a></div>
      {{else}}
      <div>Fila de emails: {{sistema.filaPendentes}} por enviar · <span class="{{#if (gt sistema.filaErros 0)}}text-danger{{/if}}">{{sistema.filaErros}} com erro</span></div>
      {{/if}}
    </div>
    {{/if}}
  </div>
</div>

{{!-- PREPARAÇÃO DO CONDOMÍNIO (A14 §9)

     O que ainda falta CONFIGURAR — e não o que está mal. Fica separado de
     «Precisa de atenção» de propósito: «ainda não configurou X» não é um
     problema e não deve ser lido como tal (nem com a mesma cor, nem na mesma
     lista).

     ⛔ ISTO NÃO É UM WIZARD: não há passos sequenciais, não há barra de
     progresso nem ordem obrigatória. É uma lista de orientação que persiste
     até cada item ficar concluído — e que desaparece quando deixa de ser
     precisa. Quando não falta nada, o bloco diz que está configurado em vez de
     mostrar uma lista vazia.

     Cada linha tem ÍCONE + TEXTO + COR (A14 §8): o estado nunca é só um ponto
     colorido, e o rótulo textual («Requer configuração») é o que o leitor de
     ecrã anuncia. --}}
<div class="section-title">Preparação do condomínio</div>
<div class="card mb-3">
  <div class="card-header">
    <span class="fw-semibold">O que falta configurar</span>
    <div class="small text-muted">Orientação permanente, não um problema do condomínio.</div>
  </div>
  <div class="card-body py-2">
    {{#if sinaisPreparacao.length}}
    <ul class="atencao-lista">
      {{#each sinaisPreparacao}}
      <li class="atencao-item">
        <a class="atencao-sinal atencao-info" href="{{destino.url}}">
          <span class="atencao-marca" aria-hidden="true"></span>
          <span class="atencao-texto">{{texto}}</span>
          <span class="estado estado-requer-config">{{estadoRotulo}}</span>
          <span class="atencao-acao">{{destino.texto}}<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></span>
        </a>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <div class="text-success small py-1"><i class="bi bi-check-circle me-1"></i>O condomínio está configurado — não falta nada de essencial.</div>
    {{/if}}
  </div>
</div>

{{!-- SUGESTÕES (tips contextuais)

     Orientação, não alarme: distinto de «Precisa de atenção» acima. Os sinais
     são factos operacionais que exigem decisão hoje; os tips explicam o que
     pode não ser óbvio (como se calcula a permilagem, porque é que a conta do
     Fundo de Reserva faz falta, o que muda com uma cópia externa dos backups).

     Só aparece o que a situação real justifica — a decisão é do motor
     `helpers/tips.js` (lógica pura, testada offline); aqui só se apresenta. --}}
{{> _tips}}

{{!-- TOP DEVEDORES + EVOLUÇÃO --}}
<div class="row g-3 mb-3">
  <div class="col-12 col-lg-5">
    <div class="card h-100">
      <div class="card-header bg-white">
        <div class="fw-semibold">Top devedores</div>
        <div class="small text-muted">Frações com quotas em atraso</div>
        <div class="text-end small"><a href="/admin/quotas">Ver todos →</a></div>
      </div>
      {{#if topDevedores}}
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light"><tr><th>Fração</th><th>Meses 2026</th><th>Transitada</th><th class="text-end">Total</th></tr></thead>
          <tbody>
            {{#each topDevedores}}
            <tr>
              <td class="fw-semibold">{{fracao}}</td>
              <td class="small">{{meses}}</td>
              <td class="small text-muted">—</td>
              <td class="text-end fw-semibold text-danger">{{eur total}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="card-body text-success small"><i class="bi bi-check-circle me-1"></i>Não existem quotas em atraso.</div>
      {{/if}}
    </div>
  </div>
  <div class="col-12 col-lg-7">
    <div class="row g-3">
      <div class="col-12 col-md-7">
        <div class="card h-100">
          <div class="card-header bg-white small fw-semibold">Evolução financeira {{anoAtual}}</div>
          <div class="card-body"><canvas id="chartFinanceiro" role="img" aria-label="Gráfico de barras com receitas e despesas por mês de {{anoAtual}}"></canvas></div>
        </div>
      </div>
      <div class="col-12 col-md-5">
        <div class="card h-100">
          <div class="card-header bg-white small fw-semibold">Despesas por categoria</div>
          <div class="card-body"><canvas id="chartCategorias" role="img" aria-label="Gráfico circular com a distribuição das despesas por categoria"></canvas></div>
        </div>
      </div>
    </div>
  </div>
</div>

{{!-- PRÓXIMAS ASSEMBLEIAS + ATIVIDADE RECENTE (Fase 2H.2) --}}
<div class="row g-3 mb-3">
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Próximas assembleias</span>
        <a href="/admin/assembleias" class="small">Ver todas →</a>
      </div>
      {{#if proximasAssembleias.length}}
      <ul class="list-group list-group-flush">
        {{#each proximasAssembleias}}
        <li class="list-group-item">
          <a class="painel-linha" href="/admin/assembleias/{{id}}">
            <span class="painel-linha-icone" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">forum</span></span>
            <span class="painel-linha-texto">
              <span class="painel-linha-titulo">{{#if numero}}Assembleia {{numero}}{{else}}Assembleia de condóminos{{/if}}</span>
              <span class="painel-linha-meta">{{formatDate data}}{{#if hora}} · {{hora}}{{/if}}{{#if local}} · {{local}}{{/if}}</span>
            </span>
            <span class="painel-linha-estado badge {{#if (eq estado 'convocada')}}text-bg-success{{else}}text-bg-secondary{{/if}}">{{#if (eq estado 'convocada')}}Convocada{{else}}Agendada{{/if}}</span>
          </a>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <div class="card-body text-muted small">Sem assembleias futuras agendadas. <a href="/admin/assembleias/nova">Agendar uma →</a></div>
      {{/if}}
    </div>
  </div>
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Atividade recente</span>
        {{!-- O registo de auditoria vive em `routes/configuracao.js`
             (`comPapel('admin')`): escondido ao gestor, como na navegação. --}}
        {{#if (ne condominioAtivo.role 'gestor')}}
        <a href="/admin/config/auditoria" class="small">Ver registo →</a>
        {{/if}}
      </div>
      {{#if atividade.length}}
      <ul class="list-group list-group-flush">
        {{#each atividade}}
        <li class="list-group-item">
          <a class="painel-linha" href="{{url}}">
            <span class="painel-linha-icone" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">{{icone}}</span></span>
            <span class="painel-linha-texto">
              <span class="painel-linha-titulo">{{rotulo}}</span>
              <span class="painel-linha-meta">{{formatDateTime data}}{{#if autor}} · {{autor}}{{/if}}</span>
            </span>
          </a>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <div class="card-body text-muted small">Sem atividade registada neste condomínio.</div>
      {{/if}}
    </div>
  </div>
</div>

{{!-- SERVIÇOS E DOCUMENTAÇÃO (faixa compacta) --}}
<div class="card mb-3">
  <div class="card-body py-2 small">
    <div class="painel-strip">
      <a class="strip-item text-decoration-none" href="/admin/documentos"><div class="strip-label">Documentos</div><div class="strip-value">{{nDriveDocs}}</div></a>
      {{!-- Emails e Automações exigem `comPapel('admin')` (routes/emails.js e
           routes/configuracao.js): escondidos ao gestor, como na navegação. O
           papel vem de `condominioAtivo.role` (associação ativa), nunca de
           `users.role`. Documentos e Fornecedores ficam: exigem só `gestor`. --}}
      {{#if (ne condominioAtivo.role 'gestor')}}
      <a class="strip-item text-decoration-none" href="/admin/emails"><div class="strip-label">Emails</div><div class="strip-value">{{nEmailsEnviados}}<span class="text-muted small"> · {{sistema.filaErros}} erros</span></div></a>
      {{/if}}
      <a class="strip-item text-decoration-none" href="/admin/fornecedores"><div class="strip-label">Fornecedores</div><div class="strip-value">{{nFornecedores}} <span class="text-muted small">ativos</span></div></a>
      {{!-- A14 §15 — «Automações: Configuradas» estava ESCRITO À MÃO na vista e
           continuava a dizê-lo depois de alguém desligar tudo. Agora o número
           vem de `helpers/automacoes.js` (`resumo`), que lê o estado real.
           Sem esse resumo (leitura indisponível) NÃO se inventa um valor:
           mostra-se só a ligação. --}}
      {{#if (ne condominioAtivo.role 'gestor')}}
      <a class="strip-item text-decoration-none" href="/admin/config/automacoes">
        <div class="strip-label">Automações</div>
        <div class="strip-value">
          {{#if automacoesResumo}}{{automacoesResumo.ativos}} <span class="text-muted small">de {{automacoesResumo.tipos}} tipos</span>{{else}}Configurar{{/if}}
        </div>
      </a>
      {{/if}}
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
  (function () {
    const financeiro = {{{chartFinanceiro}}};
    const categorias = {{{chartCategorias}}};

    // Cores lidas dos tokens da paleta (seguem automaticamente o tema).
    const cor = (token, alternativa) => {
      const v = getComputedStyle(document.documentElement).getPropertyValue(token).trim();
      return v || alternativa;
    };
    const texto = cor('--c-text-muted', '#567086');
    // Mobile: gráficos maiores e rótulos legíveis (mínimo 11px).
    const ecraPequeno = window.innerWidth < 768;
    const fonteLegenda = ecraPequeno ? 12 : 10;
    const fonteEixos = ecraPequeno ? 11 : 9;
    const legenda = { position: 'bottom', labels: { boxWidth: ecraPequeno ? 14 : 10, padding: ecraPequeno ? 10 : 6, font: { size: fonteLegenda }, color: texto } };

    new Chart(document.getElementById('chartFinanceiro'), {
      type: 'bar',
      data: {
        labels: financeiro.labels,
        datasets: [
          { label: 'Receitas', data: financeiro.receitas, backgroundColor: cor('--c-success', '#20C83F'), borderRadius: 3 },
          { label: 'Despesas', data: financeiro.despesas, backgroundColor: cor('--c-error', '#D8475C'), borderRadius: 3 },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false, // altura definida no CSS (maior em mobile)
        interaction: { mode: 'index', intersect: false }, // toque mostra o valor de cada série
        plugins: { legend: legenda, tooltip: { displayColors: true } },
        scales: {
          y: { beginAtZero: true, ticks: { font: { size: fonteEixos }, color: texto } },
          x: { ticks: { font: { size: fonteEixos }, color: texto } },
        },
      },
    });

    new Chart(document.getElementById('chartCategorias'), {
      type: 'doughnut',
      data: {
        labels: categorias.labels,
        datasets: [{
          data: categorias.valores,
          borderColor: cor('--c-surface', '#FFFFFF'),
          borderWidth: 2,
          backgroundColor: [
            cor('--c-primary', '#075B9B'),
            cor('--c-success', '#20C83F'),
            cor('--c-warning', '#D98A16'),
            cor('--c-text-subtle', '#7B91A2'),
            cor('--c-error', '#D8475C'),
            cor('--c-info', '#087FC2'),
          ],
        }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: legenda, tooltip: { displayColors: true } },
        cutout: '58%',
      },
    });
  })();
</script>
