<div class="page-heading">
  <h1>{{saudacao}}, {{user.nome}}</h1>
  <p class="subtitle">Painel do Administrador de Condomínio · {{condominio.designacao}}</p>
</div>

<div class="quick-actions">
  <a class="quick-action" href="/admin/fracoes/nova"><span class="material-symbols-outlined">add</span>Nova fração</a>
  <a class="quick-action" href="/admin/quotas/gerar"><span class="material-symbols-outlined">euro</span>Gerar quotas</a>
  <a class="quick-action" href="/admin/assembleias/nova"><span class="material-symbols-outlined">groups</span>Nova assembleia</a>
  <a class="quick-action" href="/admin/documentos/nova"><span class="material-symbols-outlined">note_add</span>Novo documento</a>
  <a class="quick-action" href="/admin/pagamentos/nova"><span class="material-symbols-outlined">payments</span>Registar pagamento</a>
  <a class="quick-action" href="/admin/despesas/nova"><span class="material-symbols-outlined">credit_card</span>Nova despesa</a>
  <a class="quick-action" href="/admin/avisos/nova"><span class="material-symbols-outlined">campaign</span>Novo aviso</a>
</div>

<div class="section-title">Finanças</div>
<div class="row g-3">
  <div class="col-6 col-md-4 col-lg">
    <div class="card stat-card"><div class="card-body">
      <div class="stat-label">Saldo das contas</div>
      <div class="stat-value">{{eur resumo.saldoContas}}</div>
    </div></div>
  </div>
  <div class="col-6 col-md-4 col-lg">
    <div class="card stat-card"><div class="card-body">
      <div class="stat-label">Fundo de reserva</div>
      <div class="stat-value">{{eur resumo.fundoReserva}}</div>
    </div></div>
  </div>
  <div class="col-6 col-md-4 col-lg">
    <div class="card stat-card"><div class="card-body">
      <div class="stat-label">Receitas</div>
      <div class="stat-value text-success">{{eur resumo.receitas}}</div>
    </div></div>
  </div>
  <div class="col-6 col-md-4 col-lg">
    <div class="card stat-card"><div class="card-body">
      <div class="stat-label">Despesas</div>
      <div class="stat-value">{{eur resumo.despesas}}</div>
    </div></div>
  </div>
  <div class="col-6 col-md-4 col-lg">
    <div class="card stat-card"><div class="card-body">
      <div class="stat-label">Em dívida</div>
      <div class="stat-value {{#if (gt resumo.emDividaGlobal 0)}}text-danger{{/if}}">{{eur resumo.emDividaGlobal}}</div>
    </div></div>
  </div>
</div>

<div class="section-title">Finanças do mês</div>
<div class="row g-3">
  <div class="col-6 col-md-3">
    <div class="card stat-card"><div class="card-body">
      <div class="stat-label">Quotas previstas (mês)</div>
      <div class="stat-value">{{eur financeiroMes.previstas}}</div>
      {{#if (gt financeiroMes.extra 0)}}<div class="stat-sub">+ {{eur financeiroMes.extra}} em quotas extra</div>{{/if}}
    </div></div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card"><div class="card-body">
      <div class="stat-label">Recebidas (mês)</div>
      <div class="stat-value text-success">{{eur financeiroMes.recebidas}}</div>
    </div></div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card"><div class="card-body">
      <div class="stat-label">Em atraso</div>
      <div class="stat-value {{#if (gt emAtraso.count 0)}}text-danger{{/if}}">{{emAtraso.count}} <span class="text-muted small">quotas</span></div>
    </div></div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card"><div class="card-body">
      <div class="stat-label">Total em atraso</div>
      <div class="stat-value {{#if (gt emAtraso.total 0)}}text-danger{{/if}}">{{eur emAtraso.total}}</div>
    </div></div>
  </div>
</div>

<div class="section-title">Orçamento {{anoAtual}}</div>
<div class="row g-3 mb-3">
  <div class="col-12">
    <div class="card">
      <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
        {{#if orcamentoAno}}
          <div>
            <div class="fw-semibold">{{orcamentoAno.designacao}}</div>
            <div class="text-muted small">
              {{#if (eq orcamentoAno.estado 'aprovado')}}Aprovado{{else if (eq orcamentoAno.estado 'em_execucao')}}Em execução{{else if (eq orcamentoAno.estado 'encerrado')}}Encerrado{{else if (eq orcamentoAno.estado 'rascunho')}}Rascunho{{else}}Anulado{{/if}}
            </div>
          </div>
          <a href="/admin/orcamento/{{orcamentoAno.id}}" class="btn btn-outline-primary">Ver orçamento</a>
        {{else}}
          <div>
            <div class="fw-semibold">Não existe orçamento para {{anoAtual}}</div>
            <div class="text-muted small">Crie o orçamento anual para definir as receitas previstas do condomínio.</div>
          </div>
          <a href="/admin/orcamento/nova" class="btn btn-primary"><span class="material-symbols-outlined me-1">add</span>Criar orçamento</a>
        {{/if}}
      </div>
    </div>
  </div>
</div>

<div class="section-title">Operação</div>
<div class="row g-3">
  <div class="col-6 col-md-3">
    <div class="card stat-card"><div class="card-body">
      <div class="stat-label">Frações &amp; Condóminos</div>
      <div class="stat-value">{{nFracoes}} <span class="text-muted small">frações</span></div>
      <div class="stat-sub">{{nPessoas}} condóminos</div>
    </div></div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card"><div class="card-body">
      <div class="stat-label">Quotas</div>
      <div class="stat-value">{{nPagas}} <span class="text-muted small">pagas</span></div>
      <div class="stat-sub">{{nPendentes}} pendentes · {{nVencidas}} vencidas</div>
    </div></div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card"><div class="card-body">
      <div class="stat-label">Backup</div>
      {{#if sistema.ultimoBackup}}
        {{#if (eq sistema.ultimoBackup.estado 'concluido')}}
        <div class="stat-value text-success">Concluído</div>
        {{else if (eq sistema.ultimoBackup.estado 'erro')}}
        <div class="stat-value text-danger">Erro</div>
        {{else}}
        <div class="stat-value text-warning">Em curso</div>
        {{/if}}
        <div class="stat-sub">{{formatDateTime sistema.ultimoBackup.data}}</div>
      {{else}}
        <div class="stat-value">—</div>
        <div class="stat-sub">Sem backups</div>
      {{/if}}
    </div></div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card"><div class="card-body">
      <div class="stat-label">Serviços</div>
      <div class="stat-sub">
        Google Drive: {{#if sistema.driveLigado}}<span class="text-success">ligado</span>{{else}}<span class="text-muted">desligado</span>{{/if}}
      </div>
      <div class="stat-sub">
        Email: {{#if sistema.smtp}}<span class="text-success">configurado</span>{{else}}<span class="text-muted">não configurado</span>{{/if}}
      </div>
    </div></div>
  </div>
</div>

<div class="section-title">Análise {{anoAtual}}</div>
<div class="row g-3">
  <div class="col-12 col-lg-7">
    <div class="card h-100">
      <div class="card-header"><span class="material-symbols-outlined me-2">bar_chart</span>Receitas vs Despesas</div>
      <div class="card-body"><canvas id="chartFinanceiro" height="120"></canvas></div>
    </div>
  </div>
  <div class="col-12 col-lg-5">
    <div class="card h-100">
      <div class="card-header"><span class="material-symbols-outlined me-2">pie_chart</span>Despesas por categoria</div>
      <div class="card-body"><canvas id="chartCategorias" height="200"></canvas></div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
  (function () {
    const financeiro = {{{chartFinanceiro}}};
    const categorias = {{{chartCategorias}}};

    new Chart(document.getElementById('chartFinanceiro'), {
      type: 'bar',
      data: {
        labels: financeiro.labels,
        datasets: [
          { label: 'Receitas', data: financeiro.receitas, backgroundColor: '#188038', borderRadius: 4 },
          { label: 'Despesas', data: financeiro.despesas, backgroundColor: '#d93025', borderRadius: 4 },
        ],
      },
      options: { responsive: true, plugins: { legend: { position: 'bottom' } }, scales: { y: { beginAtZero: true } } },
    });

    new Chart(document.getElementById('chartCategorias'), {
      type: 'doughnut',
      data: {
        labels: categorias.labels,
        datasets: [{ data: categorias.valores, backgroundColor: ['#1a73e8', '#188038', '#f9ab00', '#9aa0a6', '#d93025', '#7c4dff'] }],
      },
      options: { responsive: true, plugins: { legend: { position: 'bottom' } }, cutout: '60%' },
    });
  })();
</script>
