<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <h1>Configuração do condomínio</h1>
</div>

<div class="row g-4">
  <div class="col-12 col-lg-8">
    <div class="card">
      <div class="card-body">
        <form action="/admin/config" method="POST" enctype="multipart/form-data">
          <h5 class="mb-3">Dados do condomínio</h5>
          <div class="mb-3">
            <label class="form-label">Designação *</label>
            <input type="text" class="form-control" name="designacao" value="{{condominio.designacao}}" required />
          </div>
          <h5 class="mt-3 mb-3">Administração de condomínio</h5>
          <div class="mb-3">
            <label class="form-label">Nome da administração / empresa</label>
            <input type="text" class="form-control" name="administracao_nome" value="{{condominio.administracao_nome}}" placeholder="ex.: Gestão de Condomínios, Lda." />
          </div>
          <div class="mb-3">
            <label class="form-label">Website</label>
            <input type="text" class="form-control" name="website" value="{{condominio.website}}" placeholder="ex.: www.administracao.pt" />
          </div>
          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label">NIF</label>
              <input type="text" class="form-control" name="nif" value="{{condominio.nif}}" />
            </div>
            <div class="col-md-8 mb-3">
              <label class="form-label">Morada</label>
              <input type="text" class="form-control" name="morada" value="{{condominio.morada}}" />
            </div>
          </div>
          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label">Código postal</label>
              <input type="text" class="form-control" name="codigo_postal" value="{{condominio.codigo_postal}}" placeholder="0000-000" />
            </div>
            <div class="col-md-8 mb-3">
              <label class="form-label">Localidade</label>
              <input type="text" class="form-control" name="localidade" value="{{condominio.localidade}}" />
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Email</label>
              <input type="email" class="form-control" name="email" value="{{condominio.email}}" />
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Telefone</label>
              <input type="text" class="form-control" name="telefone" value="{{condominio.telefone}}" />
            </div>
          </div>

          <h5 class="mt-2 mb-3">Pagamentos</h5>
          <div class="mb-3">
            <label class="form-label">IBAN principal</label>
            <input type="text" class="form-control" name="iban_principal" value="{{condominio.iban_principal}}" placeholder="PT50 ..." />
          </div>
          <div class="mb-3">
            <label class="form-label">Outros meios de pagamento</label>
            <textarea class="form-control" name="outros_meios_pagamento" rows="2" placeholder="ex.: MB Way 912 345 678">{{condominio.outros_meios_pagamento}}</textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">Dados bancários / instruções adicionais</label>
            <textarea class="form-control" name="dados_bancarios_adicionais" rows="2">{{condominio.dados_bancarios_adicionais}}</textarea>
          </div>

          <h5 class="mt-2 mb-3">Identidade visual</h5>
          <div class="mb-3">
            <label class="form-label">Modo</label>
            <select class="form-select" name="identidade_visual">
              <option value="logo" {{selected condominio.identidade_visual 'logo'}}>Usar logótipo personalizado</option>
              <option value="designacao" {{selected condominio.identidade_visual 'designacao'}}>Usar apenas a designação oficial</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Logótipo (PNG/JPG, máx. 5 MB)</label>
            <input type="file" class="form-control" name="logotipo" accept="image/png,image/jpeg" />
            {{#if condominio.logotipo}}
            <div class="form-text">Logótipo atual: <code>{{condominio.logotipo}}</code></div>
            {{/if}}
          </div>

          <button type="submit" class="btn btn-primary">Guardar configuração</button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-4">
    <div class="card mb-3" id="google-drive">
      <div class="card-header bg-white"><i class="bi bi-cloud me-1"></i>Google Drive</div>
      <div class="card-body">
        {{#if driveEstado.ativo}}
          {{#if driveEstado.credenciais}}
            {{#if driveEstado.ligado}}
              {{#if driveEstado.viaEnv}}
                {{!-- Ligado através do .env (legado) --}}
                <p class="mb-2"><span class="badge text-bg-success">🟢 Ligado (via .env)</span></p>
                <p class="text-muted small mb-3">
                  A ligação está configurada através de <code>GOOGLE_REFRESH_TOKEN</code> no
                  <code>.env</code>. Pode mantê-la ou passar a usar a conta Google ligada pela
                  aplicação (recomendado).
                </p>
                <a href="/admin/config/drive/ligar" class="btn btn-primary w-100 mb-2">
                  <i class="bi bi-google me-1"></i>Ligar com a conta Google
                </a>
                <form action="/admin/config/drive/estrutura" method="POST">
                  <button type="submit" class="btn btn-outline-primary w-100 mb-2">
                    <i class="bi bi-diagram-3 me-1"></i>Criar estrutura de pastas
                  </button>
                </form>
                <p class="form-text mb-0">
                  Para desligar completamente, remova <code>GOOGLE_REFRESH_TOKEN</code> do
                  <code>.env</code>.
                </p>
              {{else}}
                {{!-- Ligado à conta Google --}}
                <p class="mb-2"><span class="badge text-bg-success">🟢 Ligado</span></p>
                {{#if driveEstado.conta}}
                <p class="mb-1 fw-semibold small"><i class="bi bi-person-circle me-1"></i>{{driveEstado.conta}}</p>
                {{/if}}
                <p class="text-muted small mb-3">
                  Ligado à conta Google. Os documentos do condomínio podem ser guardados no Drive.
                </p>
                <a href="https://drive.google.com" target="_blank" rel="noopener" class="btn btn-outline-primary w-100 mb-2">
                  <i class="bi bi-box-arrow-up-right me-1"></i>Abrir Google Drive
                </a>
                <form action="/admin/config/drive/estrutura" method="POST" class="mb-2">
                  <button type="submit" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-diagram-3 me-1"></i>Criar/verificar estrutura de pastas
                  </button>
                </form>
                <form action="/admin/config/drive/desligar" method="POST"
                      onsubmit="return confirm('Desligar o Google Drive? Os ficheiros já guardados no Drive não serão apagados.');">
                  <button type="submit" class="btn btn-outline-danger w-100">
                    <i class="bi bi-plug me-1"></i>Desligar
                  </button>
                </form>
              {{/if}}
            {{else}}
              {{!-- Não ligado --}}
              <p class="mb-2"><span class="badge text-bg-secondary">⚪ Não ligado</span></p>
              <p class="text-muted small mb-3">
                Ligue a conta Google para guardar documentos (convocatórias, atas, recibos,
                anexos e backups) no Google Drive.
              </p>
              {{#unless driveEstado.redirectUriDefinido}}
              <p class="alert alert-warning small py-2 px-3">
                Defina também <code>GOOGLE_REDIRECT_URI</code> no <code>.env</code> antes de ligar.
              </p>
              {{/unless}}
              <a href="/admin/config/drive/ligar" class="btn btn-primary w-100">
                <i class="bi bi-google me-1"></i>Ligar Google Drive
              </a>
            {{/if}}
          {{else}}
            {{!-- Credenciais em falta --}}
            <p class="mb-2"><span class="badge text-bg-secondary">⚪ Não configurado</span></p>
            <p class="text-muted small mb-0">
              Adicione as credenciais OAuth do Google no <code>.env</code>:
              <code>GOOGLE_CLIENT_ID</code>, <code>GOOGLE_CLIENT_SECRET</code> e
              <code>GOOGLE_REDIRECT_URI</code>.
            </p>
          {{/if}}
        {{else}}
          {{!-- Integração desativada --}}
          <p class="mb-2"><span class="badge text-bg-secondary">Desativado</span></p>
          <p class="text-muted small mb-0">
            A integração está desativada. Defina <code>GOOGLE_DRIVE_ENABLED=true</code> e as
            credenciais OAuth no <code>.env</code>.
          </p>
        {{/if}}
      </div>
    </div>
  </div>
</div>
