<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>Documentos e Automações</h1>
    <p class="subtitle">Defina o comportamento automático quando o GesCondu gera ou regista documentos</p>
  </div>
  <a href="/admin/config" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1">arrow_back</span>Configuração</a>
</div>

<div class="alert alert-info small">
  <span class="material-symbols-outlined me-1">info</span>
  “Guardar no Google Drive” e “Enviar automaticamente por email” são opções
  <strong>independentes</strong>. Nada é enviado ou guardado automaticamente sem uma
  configuração explícita aqui.
</div>

<form method="POST" action="/admin/config/automacoes">
  {{#each grupos}}
  <div class="card mb-4">
    <div class="card-header bg-white fw-semibold">{{rotulo}}</div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Documento</th>
            <th style="width:180px"><i class="bi bi-cloud-arrow-up me-1"></i>Guardar no Drive</th>
            <th style="width:180px"><i class="bi bi-send me-1"></i>Disponível para email</th>
            <th style="width:180px"><i class="bi bi-lightning-charge me-1"></i>Enviar automaticamente</th>
            <th style="width:110px">Estado</th>
          </tr>
        </thead>
        <tbody>
          {{#each tipos}}
          <tr>
            <td class="fw-semibold">{{rotulo}}</td>
            <td>
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="auto_{{tipo}}_drive" name="auto_{{tipo}}_drive" value="on" {{#if drive}}checked{{/if}} />
                <label class="form-check-label small" for="auto_{{tipo}}_drive">Drive</label>
              </div>
            </td>
            <td>
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="auto_{{tipo}}_email" name="auto_{{tipo}}_email" value="on" {{#if email}}checked{{/if}} />
                <label class="form-check-label small" for="auto_{{tipo}}_email">Email</label>
              </div>
            </td>
            <td>
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="auto_{{tipo}}_automatico" name="auto_{{tipo}}_automatico" value="on" {{#if automatico}}checked{{/if}} />
                <label class="form-check-label small" for="auto_{{tipo}}_automatico">Automático</label>
              </div>
            </td>
            <td>
              {{#if automatico}}<span class="badge text-bg-info">Automático</span>
              {{else if drive}}<span class="badge text-bg-primary">Drive</span>
              {{else}}<span class="badge text-bg-secondary">Manual</span>{{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  {{/each}}

  <div class="card">
    <div class="card-body">
      <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Guardar automações</button>
      <a href="/admin/config" class="btn btn-outline-secondary ms-2">Cancelar</a>
    </div>
  </div>
</form>
