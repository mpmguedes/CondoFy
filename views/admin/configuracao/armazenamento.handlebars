{{> _config-tabs ativo='armazenamento'}}

<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>Armazenamento e Backups</h1>
    <p class="subtitle">Serviços ligados, armazenamento dos documentos e destino dos backups</p>
  </div>
</div>

<div class="alert alert-info small">
  <span class="material-symbols-outlined me-1" aria-hidden="true">lock</span>
  Os documentos ficam <strong>privados</strong> no serviço de armazenamento e são sempre entregues pelo
  GesCondu, depois de verificar a sessão, o condomínio e as permissões do utilizador. O GesCondu não cria
  links públicos (“qualquer pessoa com o link”) nem envia links do serviço por email.
</div>

{{#unless armazenamento.cifra.configurada}}
<div class="alert alert-warning small">
  <span class="material-symbols-outlined me-1" aria-hidden="true">key</span>
  <strong>Credenciais de armazenamento indisponíveis.</strong>
  {{#if armazenamento.cifra.erroOperacional}}{{armazenamento.cifra.erroOperacional}}{{else}}A chave de cifragem das credenciais não está configurada nesta instalação.{{/if}}
  Esta é uma configuração da instalação (administrador do GesCondu): os serviços voltam a ficar ligados
  assim que a chave estiver configurada, sem ser preciso autorizar novamente as contas.
</div>
{{/unless}}

{{!-- ── 1. Ligações aos serviços (estado + conta) ───────────────────── --}}
<h2 class="h6 mt-3 mb-2">Ligações aos serviços</h2>
<div class="row g-3">
  {{#each armazenamento.provedores}}
  <div class="col-12 col-lg-4">
    <div class="card h-100" id="{{nome}}">
      <div class="card-body d-flex flex-column">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="fw-semibold"><i class="{{icone}} me-2" aria-hidden="true"></i>{{rotulo}}</span>
          {{#if ligado}}<span class="badge text-bg-success">Ligado ✓</span>{{else}}<span class="badge text-bg-secondary">Não ligado</span>{{/if}}
        </div>
        {{#if ligado}}
          <p class="small mb-3 text-truncate" title="{{conta}}">
            <i class="bi bi-person-circle me-1" aria-hidden="true"></i>{{#if conta}}{{conta}}{{else}}conta autorizada{{/if}}
            {{#if contaPlataforma}}<span class="badge text-bg-light border ms-1">conta da plataforma</span>{{/if}}
          </p>
          {{#if estado.viaEnv}}
          <p class="text-muted small">
            Esta ligação vem da configuração técnica da instalação (variável <code>GOOGLE_REFRESH_TOKEN</code>)
            e não pode ser desligada por esta página: remova-a no ficheiro <code>.env</code> do servidor e
            reinicie o GesCondu.
          </p>
          {{else if contaPlataforma}}
          <p class="text-muted small">
            Esta ligação é da instalação (a mesma usada pelos backups): desligá-la aqui remove-a em todo o GesCondu.
            Para usar uma conta Google só deste condomínio, ligue uma conta própria.
          </p>
          {{/if}}
          <div class="d-flex gap-2 mt-auto">
            <form action="/admin/config/armazenamento/{{nome}}/testar{{#if contaPlataforma}}?ambito=plataforma{{/if}}" method="POST">
              <button type="submit" class="btn btn-sm btn-outline-secondary" title="Testar ligação" aria-label="Testar ligação a {{rotulo}}">
                <i class="bi bi-plug" aria-hidden="true"></i>
              </button>
            </form>
            {{#unless estado.viaEnv}}
            <form action="/admin/config/armazenamento/{{nome}}/desligar{{#if contaPlataforma}}?ambito=plataforma{{/if}}" method="POST" class="flex-fill"
                  data-confirmar="{{#if contaPlataforma}}Desligar {{rotulo}} da plataforma? Esta ligação é usada por todos os condomínios e pelos backups. Os ficheiros já guardados não são apagados.{{else}}Desligar {{rotulo}} deste condomínio? Os ficheiros já guardados não são apagados e a conta não é afetada.{{/if}}" data-confirmar-perigo="1">
              <button type="submit" class="btn btn-sm btn-outline-danger w-100">Desligar</button>
            </form>
            {{/unless}}
          </div>
        {{else}}
          {{#if disponivel}}
            <p class="text-muted small">Associe uma conta para guardar documentos neste serviço.</p>
            <a href="/admin/config/armazenamento/{{nome}}/ligar" class="btn btn-primary w-100 mt-auto">
              <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Ligar {{rotulo}}
            </a>
          {{else}}
            <p class="text-muted small mb-0 mt-auto">Disponível após configuração pelo administrador do GesCondu.</p>
          {{/if}}
        {{/if}}
      </div>
    </div>
  </div>
  {{/each}}
</div>

{{!-- ── 2. Armazenamento dos documentos ─────────────────────────────── --}}
<h2 class="h6 mt-4 mb-2">Armazenamento dos documentos</h2>
<div class="card mb-4">
  <div class="card-body">
    <p class="text-muted small">
      Onde ficam os documentos deste condomínio. É este o serviço usado pelas automações de documentos —
      os documentos não são copiados para os outros serviços.
    </p>
    {{#if armazenamento.temLigacoes}}
    <form action="/admin/config/armazenamento/principal" method="POST">
      <div class="row g-2">
        {{#each armazenamento.provedores}}
        {{#if ligado}}
        <div class="col-12 col-md-4">
          <label class="border rounded p-3 d-flex align-items-center gap-2 w-100 h-100 {{#if principal}}border-primary border-2{{/if}}">
            <input class="form-check-input m-0" type="radio" name="provedor" value="{{nome}}" {{#if principal}}checked{{/if}} />
            <i class="{{icone}} fs-5" aria-hidden="true"></i>
            <span class="fw-semibold">{{rotulo}}</span>
            {{#if principal}}<span class="badge text-bg-primary ms-auto">Em uso</span>{{/if}}
          </label>
        </div>
        {{/if}}
        {{/each}}
      </div>
      <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-check2 me-1"></i>Guardar</button>
    </form>
    {{else}}
    <p class="mb-0 text-muted small">Ligue um serviço acima para escolher onde guardar os documentos.</p>
    {{/if}}
  </div>
</div>

{{!-- ── 3. Backups ──────────────────────────────────────────────────── --}}
<h2 class="h6 mt-4 mb-2">Backups</h2>
<div class="card mb-4">
  <div class="card-body">
    <p class="text-muted small">
      Os backups são da instalação e usam a ligação já existente do serviço escolhido — não é preciso
      autorizar outra vez. Escolha apenas onde quer guardar.
    </p>

    {{#if armazenamento.temLigacoes}}
    <form action="/admin/config/armazenamento/backups" method="POST">
      <div class="row g-2">
        <div class="col-12 col-md-4">
          <label class="border rounded p-3 d-flex align-items-center gap-2 w-100 h-100 {{#unless armazenamento.backup.destino}}border-primary border-2{{/unless}}">
            <input class="form-check-input m-0" type="radio" name="provedor" value="nenhum" {{#unless armazenamento.backup.destino}}checked{{/unless}} />
            <i class="bi bi-hdd fs-5" aria-hidden="true"></i>
            <span class="fw-semibold">Só neste servidor</span>
            {{#unless armazenamento.backup.destino}}<span class="badge text-bg-primary ms-auto">Em uso</span>{{/unless}}
          </label>
        </div>
        {{#each armazenamento.provedores}}
        {{#if ligado}}
        <div class="col-12 col-md-4">
          <label class="border rounded p-3 d-flex align-items-center gap-2 w-100 h-100 {{#if (eq nome ../armazenamento.backup.destino)}}border-primary border-2{{/if}}">
            <input class="form-check-input m-0" type="radio" name="provedor" value="{{nome}}" {{#if (eq nome ../armazenamento.backup.destino)}}checked{{/if}} />
            <i class="{{icone}} fs-5" aria-hidden="true"></i>
            <span class="fw-semibold">{{rotulo}}</span>
            {{#if (eq nome ../armazenamento.backup.destino)}}<span class="badge text-bg-primary ms-auto">Em uso</span>{{/if}}
          </label>
        </div>
        {{/if}}
        {{/each}}
      </div>
      <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-check2 me-1"></i>Guardar destino</button>
    </form>

    {{#if armazenamento.backup.avisoPartilhado}}
    <div class="alert alert-warning small mt-3 mb-0">
      <span class="material-symbols-outlined me-1" aria-hidden="true">info</span>
      Os backups contêm dados de <strong>todos os condomínios</strong> e vão para a conta
      {{#if armazenamento.backup.conta}}<strong>{{armazenamento.backup.conta}}</strong>{{else}}desse serviço{{/if}},
      que é a mesma usada pelos documentos. Se essa conta não for da administração da plataforma,
      escolha um serviço ligado diretamente à instalação ou mantenha os backups só no servidor.
    </div>
    {{/if}}
    {{else}}
    <p class="mb-0 text-muted small">Ligue um serviço acima para poder guardar backups fora do servidor.</p>
    {{/if}}

    <hr />
    <div class="row g-3">
      <div class="col-12 col-lg-6">
        <div class="fw-semibold small mb-1">Destino atual</div>
        <p class="small mb-0">
          {{#if armazenamento.backup.destino}}
            <i class="{{armazenamento.backup.icone}} me-1" aria-hidden="true"></i>{{armazenamento.backup.rotulo}}
            {{#if armazenamento.backup.conta}}<span class="text-muted">· {{armazenamento.backup.conta}}</span>{{/if}}
          {{else}}
            <i class="bi bi-hdd me-1" aria-hidden="true"></i>Só neste servidor
          {{/if}}
        </p>
      </div>
      <div class="col-12 col-lg-6">
        <div class="fw-semibold small mb-1">Último backup</div>
        {{#if ultimoBackup}}
        <p class="small mb-0">
          {{formatDateTime ultimoBackup.data}}
          <span class="text-muted">· {{ultimoBackup.tipo}}</span>
          {{#if (eq ultimoBackup.estado 'concluido')}}<span class="badge text-bg-success ms-1">Concluído</span>
          {{else if (eq ultimoBackup.estado 'erro')}}<span class="badge text-bg-danger ms-1" title="{{ultimoBackup.erro}}">Erro</span>
          {{else}}<span class="badge text-bg-warning ms-1">Em curso</span>{{/if}}
        </p>
        {{else}}
        <p class="small mb-0 text-muted">Ainda não existem backups registados.</p>
        {{/if}}
      </div>
    </div>
  </div>
</div>

{{!-- ── Opções avançadas do Google Drive ────────────────────────────── --}}
{{#if driveLigado}}
<h2 class="h6 mt-4 mb-2">Opções avançadas do Google Drive</h2>
<div class="card mb-4">
  <div class="card-body">
    <form action="/admin/config/drive/opcoes" method="POST" id="formPasta" class="row g-3 align-items-end">
      <div class="col-12 col-lg-7">
        <label class="form-label small" for="pastaRaiz">Pasta de destino no Google Drive</label>
        <input type="text" class="form-control" id="pastaRaiz" name="pasta_raiz" value="{{driveOpcoes.pastaRaiz}}" placeholder="ex.: GesCondu" />
        <div class="form-text">
          Pasta raiz da conta Google. Se já existir, é reutilizada (nunca são criadas pastas duplicadas).
          Os documentos de cada condomínio ficam sempre numa subpasta própria.
        </div>
      </div>
      <div class="col-12 col-lg-5">
        <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-check2 me-1"></i>Guardar pasta</button>
      </div>
    </form>
    <hr />
    <div class="d-flex flex-wrap gap-2">
      <form action="/admin/config/drive/estrutura" method="POST">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-diagram-3 me-1"></i>Criar/verificar estrutura de pastas</button>
      </form>
      <a href="/admin/documentos/drive/pasta" class="btn btn-outline-secondary"><i class="bi bi-folder2-open me-1"></i>Abrir pasta no Google Drive</a>
    </div>
  </div>
</div>
{{/if}}
