<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <h1>Auditoria</h1>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Data/hora</th>
          <th>Utilizador</th>
          <th>Ação</th>
          <th>Entidade</th>
          <th>ID</th>
          <th>Detalhes</th>
        </tr>
      </thead>
      <tbody>
        {{#each logs}}
        <tr>
          <td class="text-nowrap small">{{formatDateTime data_hora}}</td>
          <td>{{#if user}}{{user.nome}}{{else}}—{{/if}}</td>
          <td><span class="badge text-bg-light border">{{acao}}</span></td>
          <td>{{#if entidade}}{{entidade}}{{else}}—{{/if}}</td>
          <td>{{#if entidade_id}}{{entidade_id}}{{else}}—{{/if}}</td>
          <td class="small text-muted text-truncate" style="max-width:260px">{{detalhes}}</td>
        </tr>
        {{else}}
        <tr><td colspan="6" class="text-center text-muted py-4">Sem registos de auditoria.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
