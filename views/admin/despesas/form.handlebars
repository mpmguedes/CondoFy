<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>{{titulo}}</h1>
    <p class="subtitle">Defina os dados da despesa</p>
  </div>
  <a href="/admin/despesas" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1" aria-hidden="true">arrow_back</span>Voltar</a>
</div>

<div class="row">
  <div class="col-12 col-lg-8">
    <div class="card">
      <div class="card-body">
        <form action="{{#if despesa}}/admin/despesas/{{despesa.id}}{{else}}/admin/despesas{{/if}}" method="POST">
          <div class="mb-3">
            <label class="form-label">Descrição *</label>
            <input type="text" class="form-control" name="descricao" value="{{despesa.descricao}}" required />
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Categoria</label>
              <select class="form-select" name="categoria_id">
                <option value="">— Sem categoria —</option>
                {{#each categorias}}
                <option value="{{id}}" {{selected ../despesa.categoria_id id}}>{{nome}}</option>
                {{/each}}
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Valor (€) *</label>
              <input type="text" class="form-control" name="valor" value="{{despesa.valor}}" required />
            </div>
          </div>
          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label">Data</label>
              <input type="date" class="form-control" name="data" value="{{dateInput despesa.data}}" />
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Fornecedor</label>
              <select class="form-select" name="fornecedor_id">
                <option value="">— Sem fornecedor —</option>
                {{#each fornecedores}}
                <option value="{{id}}" {{selected ../despesa.fornecedor_id id}}>{{nome}}</option>
                {{/each}}
              </select>
              <div class="form-text">Ou, se não estiver registado:</div>
              <input type="text" class="form-control form-control-sm mt-1" name="fornecedor" value="{{despesa.fornecedor}}" placeholder="Nome do fornecedor (manual)" />
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Estado</label>
              <select class="form-select" name="estado">
                <option value="registada" {{selected despesa.estado 'registada'}}>Registada</option>
                <option value="paga" {{selected despesa.estado 'paga'}}>Paga</option>
              </select>
            </div>
          </div>
          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label">Conta bancária</label>
              <select class="form-select" name="conta_bancaria_id">
                <option value="">— Sem conta —</option>
                {{#each contas}}
                <option value="{{id}}" {{selected ../despesa.conta_bancaria_id id}}>{{nome}}</option>
                {{/each}}
              </select>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Método de pagamento</label>
              <select class="form-select" name="metodo_pagamento_id">
                <option value="">— Sem método —</option>
                {{#each metodos}}
                <option value="{{id}}" {{selected ../despesa.metodo_pagamento_id id}}>{{nome}}</option>
                {{/each}}
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Observações</label>
            <textarea class="form-control" name="observacoes" rows="2">{{despesa.observacoes}}</textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">Deliberação do Fundo de Reserva</label>
            <select class="form-select" name="deliberacao_id">
              <option value="">— Não é paga pelo Fundo de Reserva —</option>
              {{#if despesa.deliberacao_id}}
              {{#unless deliberacaoAtualIncluida}}
              <option value="{{despesa.deliberacao_id}}" selected>Deliberação associada (assembleia {{#if despesa.deliberacao.assembleia.numero}}{{despesa.deliberacao.assembleia.numero}}{{else}}—{{/if}} · ponto {{despesa.deliberacao.ordem}})</option>
              {{/unless}}
              {{/if}}
              {{#each deliberacoes}}
              <option value="{{id}}" {{selected id ../despesa.deliberacao_id}}>
                {{#if assembleia.numero}}Assembleia {{assembleia.numero}}{{else}}Assembleia{{/if}} · ponto {{ordem}}: {{descricao}} — disponível {{eur disponivel}}
              </option>
              {{/each}}
            </select>
            <div class="form-text">
              Só aparecem deliberações <strong>aprovadas</strong> com valor ainda disponível. Escolher uma liga a despesa à assembleia que a autorizou; a conta de pagamento não pode ser a própria conta do Fundo de Reserva (transfira primeiro o valor aprovado para a conta corrente).
            </div>
          </div>
          <button type="submit" class="btn btn-primary"><span class="material-symbols-outlined me-1" aria-hidden="true">save</span>Guardar</button>
        </form>
      </div>
    </div>
  </div>
</div>
