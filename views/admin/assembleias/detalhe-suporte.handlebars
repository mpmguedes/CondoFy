{{!--
  Vista de DIAGNÓSTICO (suporte read-only) do detalhe de uma assembleia.

  Mostra o que é necessário para diagnosticar: identificação, data/tipo/estado,
  ordem de trabalhos, deliberações e utilização de FCR, e metadados dos anexos.

  NUNCA expõe: lista de participantes com nome/email/telefone/NIF, formulários de
  escrita, geração de PDFs (convocatória/ata têm efeitos laterais) nem upload.
--}}
<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>{{titulo}}</h1>
    <p class="subtitle mb-0">Diagnóstico — apenas leitura</p>
  </div>
  <a href="/admin/assembleias" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1" aria-hidden="true">arrow_back</span>Voltar</a>
</div>

<div class="alert alert-info d-flex align-items-start gap-2">
  <span class="material-symbols-outlined">info</span>
  <div class="small">Vista de diagnóstico. A lista de participantes (com dados pessoais) e todas as ações estão ocultas.</div>
</div>

<div class="row g-3">
  <div class="col-12 col-lg-5">
    <div class="card mb-3">
      <div class="card-header bg-white">Identificação</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-5">ID</dt><dd class="col-7">#{{assembleia.id}}</dd>
          <dt class="col-5">Número</dt><dd class="col-7">{{#if assembleia.numero}}{{assembleia.numero}}{{else}}—{{/if}}</dd>
          <dt class="col-5">Data</dt><dd class="col-7">{{formatDate assembleia.data}}</dd>
          <dt class="col-5">Tipo</dt><dd class="col-7">{{assembleia.tipo}}</dd>
          <dt class="col-5">Estado</dt>
          <dd class="col-7">
            {{#if (eq assembleia.estado 'realizada')}}<span class="badge text-bg-success">Realizada</span>
            {{else if (eq assembleia.estado 'cancelada')}}<span class="badge text-bg-secondary">Cancelada</span>
            {{else if (eq assembleia.estado 'agendada')}}<span class="badge text-bg-info">Agendada</span>
            {{else}}<span class="badge text-bg-warning">{{assembleia.estado}}</span>{{/if}}
          </dd>
          <dt class="col-5">Local</dt><dd class="col-7">{{#if assembleia.local}}{{assembleia.local}}{{else}}—{{/if}}</dd>
          <dt class="col-5">Hora</dt><dd class="col-7">{{#if assembleia.hora}}{{assembleia.hora}}{{else}}—{{/if}}</dd>
        </dl>
      </div>
    </div>

    {{#if assembleia.ordem_trabalhos}}
    <div class="card mb-3">
      <div class="card-header bg-white">Ordem de trabalhos (texto)</div>
      <div class="card-body">
        <pre class="small mb-0" style="white-space:pre-wrap;word-break:break-word">{{assembleia.ordem_trabalhos}}</pre>
      </div>
    </div>
    {{/if}}

    <div class="card">
      <div class="card-header bg-white">Anexos (metadados)</div>
      <ul class="list-group list-group-flush">
        {{#each anexos}}
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <span class="fw-semibold">{{nome}}</span>
            <div class="small text-muted">
              #{{id}} · {{#if data}}{{formatDate data}}{{else}}—{{/if}}
              {{#if drive_status}} · armazenamento: {{drive_status}}{{/if}}
            </div>
          </div>
        </li>
        {{else}}
        <li class="list-group-item text-muted">Sem anexos.</li>
        {{/each}}
      </ul>
    </div>
  </div>

  <div class="col-12 col-lg-7">
    <div class="card mb-3">
      <div class="card-header bg-white">Ordem de trabalhos e deliberações</div>
      <ul class="list-group list-group-flush">
        {{#each assembleia.agenda_itens}}
        <li class="list-group-item">
          <div class="d-flex align-items-start gap-2">
            <span class="badge text-bg-light border">{{ordem}}</span>
            <div class="flex-grow-1">
              <div>{{descricao}}</div>
              <div class="small text-muted mt-1">
                {{#if sujeito_votacao}}Sujeito a votação{{else}}Sem votação{{/if}}
              </div>
              <div class="small mt-1">
                <span class="text-muted">Deliberação:</span>
                {{#if (eq deliberacao_estado 'aprovada')}}<span class="badge text-bg-success">Aprovada</span>
                {{else if (eq deliberacao_estado 'rejeitada')}}<span class="badge text-bg-danger">Rejeitada</span>
                {{else if deliberacao_estado}}<span class="badge text-bg-warning">{{deliberacao_estado}}</span>
                {{else}}<span class="badge text-bg-light border">Pendente</span>{{/if}}
                {{#if valor_aprovado}}<span class="ms-2">Valor aprovado: <strong>{{eur valor_aprovado}}</strong></span>{{/if}}
              </div>
              {{#if fcr}}
              <div class="small mt-2 ps-2 border-start">
                <div class="text-muted">Fundo de Reserva (FCR) deste ponto</div>
                <div>Aprovado: <strong>{{eur fcr.valorAprovado}}</strong></div>
                <div>Utilizado: <strong>{{eur fcr.utilizado}}</strong></div>
                <div>Disponível: <strong>{{eur fcr.disponivel}}</strong></div>
              </div>
              {{/if}}
            </div>
          </div>
        </li>
        {{else}}
        <li class="list-group-item text-muted">Sem pontos definidos.</li>
        {{/each}}
      </ul>
    </div>

    <div class="card">
      <div class="card-header bg-white">Participação (agregado)</div>
      <div class="card-body">
        <div class="text-muted small">
          A lista nominal de participantes não é apresentada nesta vista de diagnóstico.
        </div>
      </div>
    </div>
  </div>
</div>
