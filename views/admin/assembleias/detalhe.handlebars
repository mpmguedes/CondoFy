<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <h1>{{#if assembleia.numero}}Assembleia {{assembleia.numero}}{{else}}Assembleia{{/if}}</h1>
  <div class="d-flex gap-2">
    <a href="/admin/assembleias" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1">arrow_back</span>Voltar</a>
    <a href="/admin/assembleias/{{assembleia.id}}/editar" class="btn btn-outline-primary"><span class="material-symbols-outlined me-1">edit</span>Editar</a>
  </div>
</div>

<div class="row g-4">
  <div class="col-12 col-lg-5">
    <div class="card mb-3">
      <div class="card-header bg-white">Dados</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-5">Número</dt><dd class="col-7">{{#if assembleia.numero}}{{assembleia.numero}}{{else}}—{{/if}}</dd>
          <dt class="col-5">Tipo</dt><dd class="col-7">{{lookup tipos assembleia.tipo}}</dd>
          <dt class="col-5">Data</dt><dd class="col-7">{{formatDate assembleia.data}}</dd>
          <dt class="col-5">Hora</dt><dd class="col-7">{{assembleia.hora}}</dd>
          <dt class="col-5">Local</dt><dd class="col-7">{{assembleia.local}}</dd>
          <dt class="col-5">Estado</dt>
          <dd class="col-7">
            {{#if (eq assembleia.estado 'rascunho')}}<span class="badge text-bg-secondary">Rascunho</span>
            {{else if (eq assembleia.estado 'realizada')}}<span class="badge text-bg-success">Realizada</span>
            {{else if (eq assembleia.estado 'cancelada')}}<span class="badge text-bg-dark">Cancelada</span>
            {{else if (eq assembleia.estado 'convocada')}}<span class="badge text-bg-info">Convocada</span>
            {{else}}<span class="badge text-bg-warning">Agendada</span>{{/if}}
          </dd>
        </dl>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header bg-white">Documentos</div>
      <div class="card-body">
        <div class="d-grid gap-2">
          <a href="/admin/assembleias/{{assembleia.id}}/convocatoria" target="_blank" class="btn btn-outline-primary"><i class="bi bi-file-earmark-pdf me-1"></i>Gerar convocatória (PDF)</a>
          <a href="/admin/assembleias/{{assembleia.id}}/ata" target="_blank" class="btn btn-outline-primary"><i class="bi bi-file-earmark-pdf me-1"></i>Gerar ata (PDF)</a>
          <form action="/admin/assembleias/{{assembleia.id}}/convocatoria/drive" method="POST">
            <button class="btn btn-outline-secondary w-100" {{#unless driveLigado}}disabled{{/unless}}><i class="bi bi-cloud-arrow-up me-1"></i>Guardar convocatória no Drive</button>
          </form>
          <form action="/admin/assembleias/{{assembleia.id}}/ata/drive" method="POST">
            <button class="btn btn-outline-secondary w-100" {{#unless driveLigado}}disabled{{/unless}}><i class="bi bi-cloud-arrow-up me-1"></i>Guardar ata no Drive</button>
          </form>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header bg-white">Anexos</div>
      <div class="card-body border-bottom">
        <form action="/admin/assembleias/{{assembleia.id}}/anexos" method="POST" enctype="multipart/form-data" class="d-flex gap-2">
          <input type="file" class="form-control" name="ficheiro" accept=".pdf,.jpg,.jpeg,.png,.webp" />
          <button class="btn btn-outline-primary text-nowrap" {{#unless driveLigado}}disabled{{/unless}}><span class="material-symbols-outlined">upload</span></button>
        </form>
        <div class="form-text">PDF, JPG, PNG ou WebP até 20 MB.</div>
      </div>
      <ul class="list-group list-group-flush">
        {{#each anexos}}
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2">
            <span class="material-symbols-outlined text-muted">attach_file</span>
            <span class="fw-semibold">{{nome}}</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            {{#if url}}<a href="{{url}}" target="_blank" class="btn btn-sm btn-outline-primary" title="Ver"><span class="material-symbols-outlined">visibility</span></a>{{/if}}
            <form action="/admin/assembleias/{{../assembleia.id}}/anexos/{{id}}/eliminar" method="POST" onsubmit="return confirm('Eliminar este anexo?');">
              <button class="btn btn-sm btn-outline-danger" title="Eliminar"><span class="material-symbols-outlined">delete</span></button>
            </form>
          </div>
        </li>
        {{else}}
        <li class="list-group-item text-muted">Sem anexos.</li>
        {{/each}}
      </ul>
    </div>
  </div>

  <div class="col-12 col-lg-7">
    <div class="card mb-3">
      <div class="card-header bg-white">Ordem de trabalhos</div>
      <div class="card-body border-bottom">
        <form action="/admin/assembleias/{{assembleia.id}}/agenda" method="POST" class="row g-2 align-items-end">
          <div class="col-md-8">
            <label class="form-label">Novo ponto</label>
            <input type="text" class="form-control" name="descricao" required placeholder="Ex.: Aprovação do orçamento anual" />
          </div>
          <div class="col-md-3">
            <div class="form-check mt-4">
              <input class="form-check-input" type="checkbox" name="sujeito_votacao" id="sujeito_votacao" value="on" checked />
              <label class="form-check-label" for="sujeito_votacao">Sujeito a votação</label>
            </div>
          </div>
          <div class="col-md-1">
            <button class="btn btn-primary" title="Adicionar"><span class="material-symbols-outlined">add</span></button>
          </div>
        </form>
      </div>
      <ul class="list-group list-group-flush" id="listaAgenda">
        {{#each assembleia.agenda_itens}}
        <li class="list-group-item d-flex justify-content-between align-items-center gap-2" data-id="{{id}}">
          <div class="d-flex align-items-center gap-2 flex-grow-1">
            <span class="badge text-bg-light border">{{ordem}}</span>
            <form action="/admin/assembleias/{{../assembleia.id}}/agenda/{{id}}" method="POST" class="d-flex align-items-center gap-2 flex-grow-1">
              <input type="text" class="form-control form-control-sm flex-grow-1" name="descricao" value="{{descricao}}" />
              <div class="form-check text-nowrap">
                <input class="form-check-input" type="checkbox" name="sujeito_votacao" {{checked sujeito_votacao}} />
                <label class="form-check-label small">Votação</label>
              </div>
              <button class="btn btn-sm btn-outline-primary" title="Guardar"><span class="material-symbols-outlined">check</span></button>
            </form>
          </div>
          <form action="/admin/assembleias/{{../assembleia.id}}/agenda/{{id}}/eliminar" method="POST" onsubmit="return confirm('Remover este ponto?');">
            <button class="btn btn-sm btn-outline-danger" title="Remover"><span class="material-symbols-outlined">delete</span></button>
          </form>
        </li>
        {{else}}
        <li class="list-group-item text-muted">Sem pontos definidos.</li>
        {{/each}}
      </ul>
    </div>

    <div class="card">
      <div class="card-header bg-white"><i class="bi bi-person-plus me-1"></i>Participantes / representação</div>
      <div class="card-body border-bottom">
        <form action="/admin/assembleias/{{assembleia.id}}/participantes" method="POST" class="row g-2 align-items-end">
          <div class="col-md-4">
            <label class="form-label">Fração</label>
            <select class="form-select" name="fracao_id">
              {{#each fracoes}}<option value="{{id}}">{{designacao}}</option>{{/each}}
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label">Pessoa</label>
            <select class="form-select" name="pessoa_id">
              <option value="">—</option>
              {{#each pessoas}}<option value="{{id}}">{{nome}}</option>{{/each}}
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label">Permilagem</label>
            <input type="text" class="form-control" name="permilagem" placeholder="‰" />
          </div>
          <div class="col-md-2">
            <div class="form-check mt-4">
              <input class="form-check-input" type="checkbox" name="presente" id="presente" checked />
              <label class="form-check-label" for="presente">Presente</label>
            </div>
          </div>
          <div class="col-md-1">
            <button class="btn btn-outline-primary" title="Adicionar"><i class="bi bi-plus-lg"></i></button>
          </div>
        </form>
      </div>
      <ul class="list-group list-group-flush">
        {{#each participantes}}
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <span class="fw-semibold">{{#if fracao}}{{fracao.designacao}}{{else}}—{{/if}}</span>
            {{#if pessoa}}<span class="text-muted small ms-2">{{pessoa.nome}}</span>{{/if}}
            {{#if permilagem}}<span class="badge text-bg-light border ms-2">{{permilagem}}‰</span>{{/if}}
          </div>
          <div class="d-flex align-items-center gap-2">
            {{#if presente}}<span class="badge text-bg-success">Presente</span>{{else}}<span class="badge text-bg-secondary">Ausente</span>{{/if}}
            <form action="/admin/assembleias/{{../assembleia.id}}/participantes/{{id}}/eliminar" method="POST">
              <button class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i></button>
            </form>
          </div>
        </li>
        {{else}}
        <li class="list-group-item text-muted">Sem participantes.</li>
        {{/each}}
      </ul>
    </div>
  </div>
</div>
