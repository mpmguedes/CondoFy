{{> _assembleias-tabs ativo='assembleias'}}
<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <h1>{{#if assembleia.numero}}Assembleia {{assembleia.numero}}{{else}}Assembleia{{/if}}</h1>
  <div class="d-flex gap-2">
    <a href="/admin/assembleias" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1" aria-hidden="true">arrow_back</span>Voltar</a>
    <a href="/admin/assembleias/{{assembleia.id}}/editar" class="btn btn-outline-primary"><span class="material-symbols-outlined me-1" aria-hidden="true">edit</span>Editar</a>
  </div>
</div>

<div class="row g-4">
  <div class="col-12 col-lg-5">
    <div class="card mb-3">
      <div class="card-header bg-white">Dados</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-5">Número</dt><dd class="col-7">{{#if assembleia.numero}}{{assembleia.numero}}{{else}}—{{/if}}</dd>
          <dt class="col-5">Tipo</dt><dd class="col-7">{{lookup tipos assembleia.tipo}}</dd>
          <dt class="col-5">Data</dt><dd class="col-7">{{formatDate assembleia.data}}</dd>
          <dt class="col-5">Hora</dt><dd class="col-7">{{assembleia.hora}}</dd>
          <dt class="col-5">Local</dt><dd class="col-7">{{assembleia.local}}</dd>
          <dt class="col-5">Estado</dt>
          <dd class="col-7">
            {{#if (eq assembleia.estado 'rascunho')}}<span class="badge text-bg-secondary">Rascunho</span>
            {{else if (eq assembleia.estado 'realizada')}}<span class="badge text-bg-success">Realizada</span>
            {{else if (eq assembleia.estado 'cancelada')}}<span class="badge text-bg-dark">Cancelada</span>
            {{else if (eq assembleia.estado 'convocada')}}<span class="badge text-bg-info">Convocada</span>
            {{else}}<span class="badge text-bg-warning">Agendada</span>{{/if}}
          </dd>
        </dl>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header bg-white">Documentos</div>
      <div class="card-body">
        <div class="d-grid gap-2">
          <a href="/admin/assembleias/{{assembleia.id}}/convocatoria" target="_blank" class="btn btn-outline-primary"><i class="bi bi-file-earmark-pdf me-1"></i>Gerar convocatória (PDF)</a>
          <a href="/admin/assembleias/{{assembleia.id}}/ata" target="_blank" class="btn btn-outline-primary"><i class="bi bi-file-earmark-pdf me-1"></i>Gerar ata (PDF)</a>
          {{#if assembleia.convocatoria.url}}
          <a href="/admin/documentos/{{assembleia.convocatoria.id}}/email" class="btn btn-outline-secondary"><i class="bi bi-send me-1"></i>Enviar convocatória por email</a>
          {{/if}}
          {{#if assembleia.ata.url}}
          <a href="/admin/documentos/{{assembleia.ata.id}}/email" class="btn btn-outline-secondary"><i class="bi bi-send me-1"></i>Enviar ata por email</a>
          {{/if}}
          <form action="/admin/assembleias/{{assembleia.id}}/convocatoria/drive" method="POST">
            <button class="btn btn-outline-secondary w-100" {{#unless driveLigado}}disabled{{/unless}} data-ajuda="Copia a convocatória em PDF para a pasta deste condomínio no serviço de armazenamento ligado." data-ajuda-titulo="Guardar convocatória no armazenamento"><i class="bi bi-cloud-arrow-up me-1"></i>Guardar convocatória no Drive</button>
          </form>
          <form action="/admin/assembleias/{{assembleia.id}}/ata/drive" method="POST">
            <button class="btn btn-outline-secondary w-100" {{#unless driveLigado}}disabled{{/unless}} data-ajuda="Copia a ata em PDF para a pasta deste condomínio no serviço de armazenamento ligado." data-ajuda-titulo="Guardar ata no armazenamento"><i class="bi bi-cloud-arrow-up me-1"></i>Guardar ata no Drive</button>
          </form>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header bg-white">Anexos</div>
      <div class="card-body border-bottom">
        <form action="/admin/assembleias/{{assembleia.id}}/anexos" method="POST" enctype="multipart/form-data" class="d-flex gap-2">
          <input type="file" class="form-control" name="ficheiro" accept=".pdf,.jpg,.jpeg,.png,.webp" />
          <button class="btn btn-outline-primary text-nowrap" {{#unless driveLigado}}disabled{{/unless}} aria-label="Carregar anexo" data-ajuda="Carrega o ficheiro escolhido como anexo desta assembleia. PDF, JPG, PNG ou WebP até 20 MB." data-ajuda-titulo="Carregar anexo"><span class="material-symbols-outlined" aria-hidden="true">upload</span></button>
        </form>
        <div class="form-text">PDF, JPG, PNG ou WebP até 20 MB.</div>
      </div>
      <ul class="list-group list-group-flush">
        {{#each anexos}}
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2">
            <span class="material-symbols-outlined text-muted" aria-hidden="true">attach_file</span>
            <span class="fw-semibold">{{nome}}</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            {{#if (urlDocumento this 'gestao')}}<a aria-label="Ver" href="{{urlDocumento this 'gestao'}}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary" title="Ver"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></a>{{/if}}
            {{#if (urlDocumentoExterno this)}}<a aria-label="Link externo" href="{{urlDocumentoExterno this}}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary" title="Link externo"><span class="material-symbols-outlined" aria-hidden="true">link</span></a>{{/if}}
            <form action="/admin/assembleias/{{../assembleia.id}}/anexos/{{id}}/eliminar" method="POST" data-confirmar="Eliminar este anexo?" data-confirmar-perigo="1">
              <button class="btn btn-sm btn-outline-danger" title="Eliminar" aria-label="Eliminar anexo" data-ajuda="Remove o anexo desta assembleia. Não é possível desfazer." data-ajuda-titulo="Eliminar anexo"><span class="material-symbols-outlined" aria-hidden="true">delete</span></button>
            </form>
          </div>
        </li>
        {{else}}
        <li class="list-group-item text-muted">Sem anexos.</li>
        {{/each}}
      </ul>
    </div>
  </div>

  <div class="col-12 col-lg-7">
    <div class="card mb-3">
      <div class="card-header bg-white">Ordem de trabalhos</div>
      <div class="card-body border-bottom">
        <form action="/admin/assembleias/{{assembleia.id}}/agenda" method="POST" class="row g-2 align-items-end">
          <div class="col-md-8">
            <label class="form-label">Novo ponto</label>
            <input type="text" class="form-control" name="descricao" required placeholder="Ex.: Aprovação do orçamento anual" />
          </div>
          <div class="col-md-3">
            <div class="form-check mt-4">
              <input class="form-check-input" type="checkbox" name="sujeito_votacao" id="sujeito_votacao" value="on" checked />
              <label class="form-check-label" for="sujeito_votacao">Sujeito a votação</label>
            </div>
          </div>
          <div class="col-md-1">
            <button class="btn btn-primary" title="Adicionar" aria-label="Adicionar ponto à ordem de trabalhos" data-ajuda="Acrescenta um novo ponto à ordem de trabalhos da assembleia." data-ajuda-titulo="Adicionar ponto"><span class="material-symbols-outlined" aria-hidden="true">add</span></button>
          </div>
        </form>
      </div>
      <ul class="list-group list-group-flush" id="listaAgenda">
        {{#each assembleia.agenda_itens}}
        <li class="list-group-item" data-id="{{id}}">
          <div class="d-flex justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2 flex-grow-1">
              <span class="badge text-bg-light border">{{ordem}}</span>
              <form action="/admin/assembleias/{{../assembleia.id}}/agenda/{{id}}" method="POST" class="d-flex align-items-center gap-2 flex-grow-1">
                <input type="text" class="form-control form-control-sm flex-grow-1" name="descricao" value="{{descricao}}" />
                <div class="form-check text-nowrap">
                  <input class="form-check-input" type="checkbox" name="sujeito_votacao" {{checked sujeito_votacao}} />
                  <label class="form-check-label small">Votação</label>
                </div>
                <button class="btn btn-sm btn-outline-primary" title="Guardar" aria-label="Guardar ponto" data-ajuda="Guarda a descrição deste ponto da ordem de trabalhos." data-ajuda-titulo="Guardar ponto"><span class="material-symbols-outlined" aria-hidden="true">check</span></button>
              </form>
            </div>
            <form action="/admin/assembleias/{{../assembleia.id}}/agenda/{{id}}/eliminar" method="POST" data-confirmar="Remover este ponto?" data-confirmar-perigo="1">
              <button class="btn btn-sm btn-outline-danger" title="Remover" aria-label="Remover ponto" data-ajuda="Remove este ponto da ordem de trabalhos. Não é possível desfazer." data-ajuda-titulo="Remover ponto"><span class="material-symbols-outlined" aria-hidden="true">delete</span></button>
            </form>
          </div>

          {{!-- Deliberação deste ponto: decide se pode ser usado Fundo de Reserva --}}
          <div class="mt-2 ps-4 border-start">
            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
              <span class="small text-muted">Deliberação:</span>
              {{#if (eq deliberacao_estado 'aprovada')}}<span class="badge text-bg-success">Aprovada</span>
              {{else if (eq deliberacao_estado 'rejeitada')}}<span class="badge text-bg-danger">Rejeitada</span>
              {{else}}<span class="badge text-bg-secondary">Pendente</span>{{/if}}
              {{#unless sujeito_votacao}}<span class="badge text-bg-light border">não sujeito a votação</span>{{/unless}}
              {{!-- Só uma deliberação COM valor autorizado é uma deliberação de FCR:
                    um ponto como «Aprovação do orçamento anual» pode estar
                    aprovado sem autorizar o fundo (valor_aprovado NULL) e não
                    deve mostrar «FCR aprovado: 0,00 €». --}}
              {{#if (and (eq deliberacao_estado 'aprovada') fcr.valorAprovado)}}
              <span class="small">FCR aprovado: <strong>{{eur fcr.valorAprovado}}</strong> · utilizado <strong>{{eur fcr.utilizado}}</strong> · disponível <strong>{{eur fcr.disponivel}}</strong></span>
              {{/if}}
            </div>
            {{#if deliberacao_nota}}<div class="small text-muted mb-1">Finalidade: {{deliberacao_nota}}</div>{{/if}}
            <form action="/admin/assembleias/{{../assembleia.id}}/agenda/{{id}}/deliberacao" method="POST" class="row g-2 align-items-end">
              <div class="col-12 col-sm-3">
                <label class="form-label small mb-1">Resultado</label>
                <select class="form-select form-select-sm" name="deliberacao_estado">
                  <option value="pendente" {{selected deliberacao_estado 'pendente'}}>Pendente</option>
                  <option value="aprovada" {{selected deliberacao_estado 'aprovada'}}>Aprovada</option>
                  <option value="rejeitada" {{selected deliberacao_estado 'rejeitada'}}>Rejeitada</option>
                </select>
              </div>
              <div class="col-12 col-sm-3">
                <label class="form-label small mb-1">Valor aprovado (FCR)</label>
                <input type="number" step="0.01" min="0" class="form-control form-control-sm" name="valor_aprovado" value="{{valor_aprovado}}" placeholder="0,00" />
              </div>
              <div class="col-12 col-sm-4">
                <label class="form-label small mb-1">Finalidade</label>
                <input type="text" class="form-control form-control-sm" name="deliberacao_nota" value="{{deliberacao_nota}}" maxlength="255" placeholder="Ex.: substituição do elevador" />
              </div>
              <div class="col-12 col-sm-2">
                <button class="btn btn-sm btn-primary w-100" data-ajuda="Regista o resultado da deliberação deste ponto. Um resultado «aprovada» com valor autoriza a utilização do Fundo de Reserva até esse valor." data-ajuda-titulo="Registar deliberação">Registar</button>
              </div>
            </form>
            {{#if ../deliberacaoPendente}}
            <div class="form-text">Uma assembleia {{../estadosLabel}} não pode ter deliberação aprovada — a assembleia tem de estar convocada ou realizada.</div>
            {{/if}}
          </div>
        </li>
        {{else}}
        <li class="list-group-item text-muted">Sem pontos definidos.</li>
        {{/each}}
      </ul>
    </div>

    <div class="card">
      <div class="card-header bg-white"><i class="bi bi-person-plus me-1"></i>Participantes / representação</div>
      <div class="card-body border-bottom">
        <form action="/admin/assembleias/{{assembleia.id}}/participantes" method="POST" class="row g-2 align-items-end">
          <div class="col-md-4">
            <label class="form-label">Fração</label>
            <select class="form-select" name="fracao_id">
              {{#each fracoes}}<option value="{{id}}">{{designacao}}</option>{{/each}}
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label">Pessoa</label>
            <select class="form-select" name="pessoa_id">
              <option value="">—</option>
              {{#each pessoas}}<option value="{{id}}">{{nome}}</option>{{/each}}
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label">Permilagem</label>
            <input type="text" class="form-control" name="permilagem" placeholder="‰" />
          </div>
          <div class="col-md-2">
            <div class="form-check mt-4">
              <input class="form-check-input" type="checkbox" name="presente" id="presente" checked />
              <label class="form-check-label" for="presente">Presente</label>
            </div>
          </div>
          <div class="col-md-1">
            <button class="btn btn-outline-primary" title="Adicionar" aria-label="Adicionar participante" data-ajuda="Regista um participante nesta assembleia, com a fração e a presença indicadas." data-ajuda-titulo="Adicionar participante"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
          </div>
        </form>
      </div>
      <ul class="list-group list-group-flush">
        {{#each participantes}}
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <span class="fw-semibold">{{#if fracao}}{{fracao.designacao}}{{else}}—{{/if}}</span>
            {{#if pessoa}}<span class="text-muted small ms-2">{{pessoa.nome}}</span>{{/if}}
            {{#if permilagem}}<span class="badge text-bg-light border ms-2">{{permilagem}}‰</span>{{/if}}
          </div>
          <div class="d-flex align-items-center gap-2">
            {{#if presente}}<span class="badge text-bg-success">Presente</span>{{else}}<span class="badge text-bg-secondary">Ausente</span>{{/if}}
            <form action="/admin/assembleias/{{../assembleia.id}}/participantes/{{id}}/eliminar" method="POST">
              <button class="btn btn-sm btn-outline-danger" aria-label="Remover participante" data-ajuda="Retira este participante da lista da assembleia." data-ajuda-titulo="Remover participante"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </form>
          </div>
        </li>
        {{else}}
        <li class="list-group-item text-muted">Sem participantes.</li>
        {{/each}}
      </ul>
    </div>

    {{!-- Corpo da ata: é ESTE texto que o PDF imprime em «Deliberações».
          Sem ele, a ata sai com «(sem conteúdo registado)». --}}
    <div class="card mt-3">
      <div class="card-header bg-white"><i class="bi bi-journal-text me-1"></i>Ata — deliberações</div>
      <div class="card-body">
        <form action="/admin/assembleias/{{assembleia.id}}/ata/texto" method="POST">
          <label class="form-label" for="ata_texto">Texto da ata</label>
          <textarea class="form-control" id="ata_texto" name="ata_texto" rows="10" placeholder="Registe aqui o que foi deliberado na reunião." data-ajuda="Texto impresso na secção «Deliberações» do PDF da ata. Deixe vazio para gerar a ata sem corpo." data-ajuda-titulo="Texto da ata">{{assembleia.ata_texto}}</textarea>
          <div class="form-text">O PDF da ata («Gerar ata (PDF)») imprime este texto na secção «Deliberações». Sem texto, a ata indica «(sem conteúdo registado)».</div>
          <button class="btn btn-primary mt-2" data-ajuda="Guarda o texto da ata desta assembleia." data-ajuda-titulo="Guardar texto da ata"><span class="material-symbols-outlined me-1" aria-hidden="true">save</span>Guardar texto da ata</button>
        </form>
      </div>
    </div>
  </div>
</div>
