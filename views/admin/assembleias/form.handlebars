<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <h1>{{titulo}}</h1>
  <a href="/admin/assembleias" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1">arrow_back</span>Voltar</a>
</div>

<div class="row">
  <div class="col-12 col-lg-8">
    <div class="card">
      <div class="card-body">
        <form action="{{#if assembleia}}/admin/assembleias/{{assembleia.id}}{{else}}/admin/assembleias{{/if}}" method="POST">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label">Número</label>
              <input type="text" class="form-control" name="numero" value="{{#if assembleia}}{{assembleia.numero}}{{else}}{{numeroSugerido}}{{/if}}" />
              <div class="form-text">Gerado automaticamente; editável.</div>
            </div>
            <div class="col-md-4">
              <label class="form-label">Tipo</label>
              <select class="form-select" name="tipo">
                <option value="ordinaria" {{selected assembleia.tipo 'ordinaria'}}>Ordinária</option>
                <option value="extraordinaria" {{selected assembleia.tipo 'extraordinaria'}}>Extraordinária</option>
                <option value="urgencia" {{selected assembleia.tipo 'urgencia'}}>Urgência</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Estado</label>
              <select class="form-select" name="estado">
                <option value="rascunho" {{selected assembleia.estado 'rascunho'}}>Rascunho</option>
                <option value="agendada" {{selected assembleia.estado 'agendada'}}>Agendada</option>
                <option value="convocada" {{selected assembleia.estado 'convocada'}}>Convocada</option>
                <option value="realizada" {{selected assembleia.estado 'realizada'}}>Realizada</option>
                <option value="cancelada" {{selected assembleia.estado 'cancelada'}}>Cancelada</option>
              </select>
            </div>
          </div>
          <div class="row g-3 mt-1">
            <div class="col-md-4">
              <label class="form-label">Data</label>
              <input type="date" class="form-control" name="data" value="{{dateInput assembleia.data}}" />
            </div>
            <div class="col-md-4">
              <label class="form-label">Hora</label>
              <input type="text" class="form-control" name="hora" value="{{assembleia.hora}}" placeholder="ex.: 21:00" />
            </div>
            <div class="col-md-4">
              <label class="form-label">Local</label>
              <input type="text" class="form-control" name="local" value="{{assembleia.local}}" />
            </div>
          </div>
          <div class="mt-4">
            <button type="submit" class="btn btn-primary">{{#if assembleia}}Guardar alterações{{else}}Criar Assembleia{{/if}}</button>
            <a href="/admin/assembleias" class="btn btn-outline-secondary ms-2">Cancelar</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
