<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>Documentos</h1>
    <p class="subtitle">Biblioteca visual do condomínio — escolha uma categoria ou pasta</p>
  </div>
  <a href="/admin/documentos/nova" class="btn btn-primary"><span class="material-symbols-outlined me-1">upload</span>Novo documento</a>
</div>

{{#unless driveLigado}}
<div class="alert alert-warning"><span class="material-symbols-outlined me-1">info</span>Google Drive não configurado — o upload de ficheiros ficará indisponível até configurar o <code>.env</code>.</div>
{{/unless}}

{{#if categorias}}
<h2 class="h6 text-uppercase text-muted mb-2">Categorias</h2>
<div class="row g-3 mb-4">
  {{#each categorias}}
  <div class="col-12 col-sm-6 col-lg-4">
    <a href="{{{href}}}" class="card doc-card h-100 text-decoration-none">
      <div class="card-body d-flex flex-column">
        <div class="doc-card-topo d-flex align-items-start gap-3 mb-2">
          <span class="material-symbols-outlined doc-card-icone">{{icone}}</span>
        </div>
        <h3 class="h6 mb-1">{{titulo}}</h3>
        <p class="text-muted small mb-3">{{descricao}}</p>
        <div class="mt-auto d-flex align-items-center justify-content-between">
          <span class="small {{#if (eq contagem 0)}}text-muted{{else}}fw-semibold{{/if}}">
            {{#if (eq contagem 0)}}Sem documentos{{else}}{{contagem}} {{#if (eq contagem 1)}}documento{{else}}documentos{{/if}}{{/if}}
          </span>
          <span class="material-symbols-outlined doc-card-seta">arrow_forward</span>
        </div>
      </div>
    </a>
  </div>
  {{/each}}
</div>
{{/if}}

{{#if personalizadas}}
<h2 class="h6 text-uppercase text-muted mb-2">Pastas personalizadas</h2>
<div class="row g-3 mb-4">
  {{#each personalizadas}}
  <div class="col-12 col-sm-6 col-lg-4">
    <a href="{{{href}}}" class="card doc-card h-100 text-decoration-none">
      <div class="card-body d-flex flex-column">
        <div class="d-flex align-items-start gap-3 mb-2">
          <span class="material-symbols-outlined doc-card-icone">{{icone}}</span>
        </div>
        <h3 class="h6 mb-1">{{titulo}}</h3>
        <p class="text-muted small mb-3">{{descricao}}</p>
        <div class="mt-auto d-flex align-items-center justify-content-between">
          <span class="small {{#if (eq contagem 0)}}text-muted{{else}}fw-semibold{{/if}}">
            {{#if (eq contagem 0)}}Sem documentos{{else}}{{contagem}} {{#if (eq contagem 1)}}documento{{else}}documentos{{/if}}{{/if}}
          </span>
          <span class="material-symbols-outlined doc-card-seta">arrow_forward</span>
        </div>
      </div>
    </a>
  </div>
  {{/each}}
</div>
{{/if}}

{{#unless categorias}}{{#unless personalizadas}}
<div class="alert alert-light border small">Sem categorias nem pastas definidas.</div>
{{/unless}}{{/unless}}
