<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <h1>{{titulo}}</h1>
  <a href="/admin/documentos" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1">arrow_back</span>Voltar</a>
</div>

<div class="row">
  <div class="col-12 col-lg-7">
    <div class="card">
      <div class="card-body">
        <form action="/admin/documentos" method="POST" enctype="multipart/form-data">
          <div class="mb-3">
            <label class="form-label">Nome *</label>
            <input type="text" class="form-control" name="nome" required placeholder="ex.: Ata da assembleia de 10/01/2026" />
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Pasta</label>
              <select class="form-select" name="pasta">
                {{#each pastas}}<option value="{{@key}}">{{this}}</option>{{/each}}
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Tipo</label>
              <select class="form-select" name="tipo">
                <option value="ata">Ata</option>
                <option value="convocatoria">Convocatória</option>
                <option value="aviso_quota">Aviso de quota</option>
                <option value="recibo">Recibo</option>
                <option value="fatura">Fatura</option>
                <option value="contrato">Contrato</option>
                <option value="orcamento">Orçamento</option>
                <option value="relatorio">Relatório</option>
                <option value="outro">Outro</option>
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Categorias (opcional)</label>
            {{#if categoriasDoc}}
            <div class="d-flex flex-wrap gap-3 border rounded p-2">
              {{#each categoriasDoc}}
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="categorias" value="{{id}}" id="cat-doc-{{id}}" />
                <label class="form-check-label" for="cat-doc-{{id}}">{{nome}}</label>
              </div>
              {{/each}}
            </div>
            {{else}}
            <span class="form-text">Sem categorias de documentos — adicione em Categorias com tipo «Documento».</span>
            {{/if}}
          </div>
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="disp_cond" name="disponivel_condominos" value="1" />
            <label class="form-check-label" for="disp_cond">Disponível aos condóminos</label>
            <span class="form-text d-block">Por defeito não visível na área do Condómino. Convocatórias e atas são disponibilizadas automaticamente.</span>
          </div>
          <div class="mb-3">
            <label class="form-label">Data</label>
            <input type="date" class="form-control" name="data" />
          </div>
          <div class="mb-3">
            <label class="form-label">Ficheiro (guardado no {{armazenamentoRotulo}})</label>
            <input type="file" class="form-control" name="ficheiro" />
          </div>
          <div class="mb-3">
            <label class="form-label">Ou URL externa (opcional)</label>
            <input type="url" class="form-control" name="url" placeholder="https://..." />
          </div>
          <button type="submit" class="btn btn-primary">Guardar documento</button>
        </form>
      </div>
    </div>
  </div>
</div>
