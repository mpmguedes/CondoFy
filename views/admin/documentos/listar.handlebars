<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    {{#if rotulo}}
    <nav class="small mb-1" aria-label="breadcrumb">
      <a href="/admin/documentos" class="text-decoration-none">Biblioteca</a>
      <span class="text-muted mx-1">/</span>
      <span class="text-muted">{{rotulo}}</span>
    </nav>
    <h1>{{rotulo}}</h1>
    <p class="subtitle mb-0">Documentos nesta categoria/pasta{{#if nDocumentos}} ({{nDocumentos}}){{/if}}</p>
    {{else}}
    <h1>Documentos</h1>
    <p class="subtitle">Biblioteca documental do condomínio</p>
    {{/if}}
  </div>
  <div class="d-flex gap-2">
    {{#if rotulo}}<a href="/admin/documentos" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1">arrow_back</span>Voltar à biblioteca</a>{{/if}}
    <a href="/admin/documentos/nova" class="btn btn-primary"><span class="material-symbols-outlined me-1">upload</span>Novo documento</a>
  </div>
</div>

{{#unless driveLigado}}
<div class="alert alert-warning"><span class="material-symbols-outlined me-1">info</span>Google Drive não configurado — o upload de ficheiros ficará indisponível até configurar o <code>.env</code>.</div>
{{/unless}}

<div class="card mb-3">
  <div class="card-body">
    <div class="d-flex flex-wrap gap-2">
      <a href="/admin/documentos" class="btn btn-sm {{#unless pasta}}{{#unless pastasMulti}}btn-primary{{else}}btn-outline-secondary{{/unless}}{{else}}btn-outline-secondary{{/unless}}">Biblioteca</a>
      {{#each pastas}}
      <a href="/admin/documentos?pasta={{@key}}" class="btn btn-sm {{#if (eq ../pasta @key)}}btn-primary{{else}}btn-outline-secondary{{/if}}">{{this}}</a>
      {{/each}}
    </div>
    <hr class="my-2" />
    <div class="d-flex flex-wrap gap-2 align-items-center">
      <form action="/admin/documentos/pastas" method="POST" class="d-flex gap-2 align-items-center">
        <input type="text" class="form-control form-control-sm" name="nome" maxlength="40" required placeholder="Nova pasta…" style="max-width:220px" />
        <button class="btn btn-sm btn-outline-primary" title="Criar pasta personalizada">+ Pasta</button>
      </form>
      {{#if pastaCustom}}
      <form action="/admin/documentos/pastas/{{pastaCustom}}/eliminar" method="POST" onsubmit="return confirm('Eliminar esta pasta personalizada? Só é possível se estiver vazia.');">
        <button class="btn btn-sm btn-outline-danger">Eliminar esta pasta</button>
      </form>
      {{/if}}
    </div>
    <div class="small text-muted mt-1">A pasta «Outros» é obrigatória e não pode ser removida.</div>
  </div>
</div>

{{#if documentos}}
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Nome</th>
          <th>Pasta</th>
          <th>Categorias</th>
          <th>Tipo</th>
          <th>Data</th>
          <th>Drive</th>
          <th>Condóminos</th>
          <th class="text-end">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each documentos}}
        <tr>
          <td class="fw-semibold">{{nome}}</td>
          <td><span class="badge text-bg-light">{{lookup ../pastas pasta}}</span></td>
          <td>
            {{#if categorias}}
              {{#each categorias}}<span class="badge text-bg-info-subtle border me-1">{{nome}}</span>{{/each}}
            {{else}}<span class="text-muted small">—</span>{{/if}}
          </td>
          <td>
            {{#if (eq tipo 'ata')}}Ata
            {{else if (eq tipo 'convocatoria')}}Convocatória
            {{else if (eq tipo 'aviso_quota')}}Aviso de quota
            {{else if (eq tipo 'recibo')}}Recibo
            {{else if (eq tipo 'fatura')}}Fatura
            {{else if (eq tipo 'contrato')}}Contrato
            {{else if (eq tipo 'orcamento')}}Orçamento
            {{else if (eq tipo 'relatorio')}}Relatório
            {{else}}Outro{{/if}}
          </td>
          <td class="text-nowrap">{{formatDate data}}</td>
          <td>
            {{#if (eq drive_status 'guardado')}}<span class="badge text-bg-success" title="Guardado no Google Drive">☁ Guardado</span>
            {{else if (eq drive_status 'erro')}}<span class="badge text-bg-danger" title="{{drive_erro}}">Erro Drive</span>
            {{else if (eq drive_status 'pendente')}}<span class="badge text-bg-warning">A guardar</span>
            {{else}}<span class="badge text-bg-secondary">Não guardado</span>{{/if}}
          </td>
          <td class="text-nowrap">
            {{#if disponivel_condominos}}<span class="badge text-bg-success">Sim</span>
            {{else}}<span class="badge text-bg-secondary">Não</span>{{/if}}
            <form action="/admin/documentos/{{id}}/disponivel" method="POST" class="d-inline">
              <button class="btn btn-sm btn-outline-secondary px-1" title="{{#if disponivel_condominos}}Ocultar dos condóminos{{else}}Disponibilizar aos condóminos{{/if}}">
                {{#if disponivel_condominos}}Ocultar{{else}}Disponibilizar{{/if}}
              </button>
            </form>
          </td>
          <td class="text-end text-nowrap">
            {{#if url}}<a href="{{url}}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary" title="Ver/Descarregar"><span class="material-symbols-outlined">download</span></a>{{/if}}
            <a href="/admin/documentos/{{id}}/email" class="btn btn-sm btn-outline-secondary" title="Enviar por email"><span class="material-symbols-outlined">mail</span></a>
            <form action="/admin/documentos/{{id}}/eliminar" method="POST" class="d-inline" onsubmit="return confirm('Eliminar este documento?');">
              <button class="btn btn-sm btn-outline-danger" title="Eliminar"><span class="material-symbols-outlined">delete</span></button>
            </form>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
{{#if rotulo}}
{{> _empty-state icon="folder" titulo="Sem documentos" descricao="Esta categoria/pasta ainda não tem documentos." link="/admin/documentos/nova" linkTexto="Novo documento"}}
{{else}}
{{> _empty-state icon="folder" titulo="Esta pasta está vazia" descricao="Carregue documentos (atas, faturas, contratos…) para o repositório." link="/admin/documentos/nova" linkTexto="Novo documento"}}
{{/if}}
{{/if}}
