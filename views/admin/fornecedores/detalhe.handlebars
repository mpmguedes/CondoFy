<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>{{fornecedor.nome}}</h1>
    <p class="subtitle">Ficha do fornecedor</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/fornecedores/{{fornecedor.id}}/editar" class="btn btn-outline-primary"><span class="material-symbols-outlined me-1" aria-hidden="true">edit</span>Editar</a>
    <a href="/admin/fornecedores" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1" aria-hidden="true">arrow_back</span>Voltar</a>
  </div>
</div>

<div class="row g-4">
  <div class="col-12 col-lg-5">
    <div class="card mb-3">
      <div class="card-header bg-white"><i class="bi bi-shop me-1"></i>Fornecedor</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-5">Nome</dt><dd class="col-7">{{fornecedor.nome}}</dd>
          {{#if fornecedor.nif}}<dt class="col-5">NIF</dt><dd class="col-7">{{fornecedor.nif}}</dd>{{/if}}
          {{#if fornecedor.morada}}<dt class="col-5">Morada</dt><dd class="col-7">{{fornecedor.morada}}</dd>{{/if}}
          {{#if fornecedor.codigo_postal}}<dt class="col-5">Código postal</dt><dd class="col-7">{{fornecedor.codigo_postal}} {{fornecedor.localidade}}</dd>{{/if}}
          {{#if fornecedor.email}}<dt class="col-5">Email</dt><dd class="col-7">{{fornecedor.email}}</dd>{{/if}}
          {{#if fornecedor.telefone}}<dt class="col-5">Telefone</dt><dd class="col-7">{{fornecedor.telefone}}</dd>{{/if}}
          {{#if fornecedor.telemovel}}<dt class="col-5">Telemóvel</dt><dd class="col-7">{{fornecedor.telemovel}}</dd>{{/if}}
          {{#if fornecedor.iban}}<dt class="col-5">IBAN</dt><dd class="col-7 font-monospace">{{fornecedor.iban}}</dd>{{/if}}
          {{#if fornecedor.notas}}<dt class="col-5">Notas</dt><dd class="col-7">{{fornecedor.notas}}</dd>{{/if}}
          <dt class="col-5">Estado</dt>
          <dd class="col-7">{{#if fornecedor.ativo}}<span class="badge text-bg-success">Ativo</span>{{else}}<span class="badge text-bg-secondary">Inativo</span>{{/if}}</dd>
        </dl>
      </div>
    </div>

    {{!-- Situação com o condomínio (saldo inicial/transitado + faturado − pago) --}}
    <div class="card mb-3">
      <div class="card-header bg-white"><i class="bi bi-cash-coin me-1"></i>Situação com o condomínio</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-7 fw-normal text-muted">Saldo inicial / transitado</dt>
          <dd class="col-5 text-end mb-1">{{eur divida.saldoInicial}}</dd>
          <dt class="col-7 fw-normal text-muted">Total faturado</dt>
          <dd class="col-5 text-end mb-1">{{eur divida.faturado}}</dd>
          <dt class="col-7 fw-normal text-muted">Total pago</dt>
          <dd class="col-5 text-end mb-1">{{eur divida.pago}}</dd>
          {{#if divida.emDivida}}
          <dt class="col-7 fw-semibold">Em dívida</dt>
          <dd class="col-5 text-end mb-0 fw-semibold text-danger">{{eur divida.saldo}}</dd>
          {{else}}
          <dt class="col-7 fw-semibold">Crédito a favor do condomínio</dt>
          <dd class="col-5 text-end mb-0 fw-semibold text-success">{{eur divida.credito}}</dd>
          {{/if}}
        </dl>
      </div>
    </div>

    {{!-- Saldos iniciais / transitados (dívida anterior à plataforma) --}}
    <div class="card mb-3">
      <div class="card-header bg-white"><i class="bi bi-hourglass-split me-1"></i>Saldo inicial / transitado</div>
      <div class="card-body pb-0">
        <p class="text-muted small">
          Registe aqui a dívida (ou o crédito) que já existia antes de usar a plataforma. Não são criadas faturas nem pagamentos fictícios — este valor entra apenas no cálculo da dívida deste fornecedor.
        </p>
      </div>
      {{#if saldos.length}}
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr><th>Data</th><th>Descrição</th><th>Tipo</th><th class="text-end">Valor</th><th class="text-end">Ações</th></tr>
          </thead>
          <tbody>
            {{#each saldos}}
            <tr>
              <td class="text-nowrap">{{#if data}}{{formatDate data}}{{else}}—{{/if}}</td>
              <td>{{#if descricao}}{{descricao}}{{else}}—{{/if}}</td>
              <td>{{#if (eq tipo 'saldo_transitado')}}<span class="badge text-bg-info">Transitado</span>{{else}}<span class="badge text-bg-primary">Saldo inicial</span>{{/if}}</td>
              <td class="text-end fw-semibold">{{eur valor}}</td>
              <td class="text-end">
                <form action="/admin/fornecedores/{{../fornecedor.id}}/saldos/{{id}}/eliminar" method="POST" class="d-inline" data-confirmar="Remover este saldo inicial?" data-confirmar-perigo="1">
                  <button aria-label="Remover" class="btn btn-sm btn-outline-danger" title="Remover" data-ajuda="Remove este saldo inicial do fornecedor. Deixa de contar para o saldo em dívida." data-ajuda-titulo="Remover saldo inicial"><span class="material-symbols-outlined" aria-hidden="true">delete</span></button>
                </form>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{/if}}
      <div class="card-body">
        <form action="/admin/fornecedores/{{fornecedor.id}}/saldos" method="POST" class="row g-2 align-items-end">
          <div class="col-12 col-md-3">
            <label class="form-label small" for="saldo_data">Data</label>
            <input type="date" class="form-control form-control-sm" id="saldo_data" name="data" />
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label small" for="saldo_valor">Valor (€)</label>
            <input type="text" class="form-control form-control-sm" id="saldo_valor" name="valor" placeholder="0,00" required />
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label small" for="saldo_tipo">Tipo</label>
            <select class="form-select form-select-sm" id="saldo_tipo" name="tipo">
              <option value="saldo_inicial">Saldo inicial</option>
              <option value="saldo_transitado">Saldo transitado</option>
            </select>
          </div>
          <div class="col-12 col-md-3">
            <label class="form-label small" for="saldo_descricao">Descrição</label>
            <input type="text" class="form-control form-control-sm" id="saldo_descricao" name="descricao" placeholder="ex.: dívida de 2025" />
          </div>
          <div class="col-12">
            <button class="btn btn-sm btn-primary" data-ajuda="Cria um saldo inicial ou transitado no extrato deste fornecedor. Não movimenta contas bancárias." data-ajuda-titulo="Registar saldo"><span class="material-symbols-outlined me-1" aria-hidden="true">add</span>Registar saldo</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-7">
    {{!-- Despesas --}}
    <div class="card mb-3">
      <div class="card-header bg-white"><i class="bi bi-credit-card me-1"></i>Despesas</div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr><th>Data</th><th>Descrição</th><th>Categoria</th><th class="text-end">Valor</th><th>Estado</th></tr>
          </thead>
          <tbody>
            {{#each despesas}}
            <tr>
              <td class="text-nowrap">{{formatDate data}}</td>
              <td class="fw-semibold">{{descricao}}</td>
              <td>{{#if categoria}}{{categoria.nome}}{{else}}—{{/if}}</td>
              <td class="text-end">{{eur valor}}</td>
              <td>
                {{#if (eq estado 'paga')}}<span class="badge text-bg-success">Paga</span>
                {{else if (eq estado 'anulada')}}<span class="badge text-bg-secondary">Anulada</span>
                {{else}}<span class="badge text-bg-warning">Registada</span>{{/if}}
              </td>
            </tr>
            {{else}}
            <tr><td colspan="5" class="text-center text-muted py-3">Sem despesas associadas.</td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>

    {{!-- Documentos --}}
    <div class="card mb-3">
      <div class="card-header bg-white"><i class="bi bi-file-earmark me-1"></i>Documentos</div>
      <ul class="list-group list-group-flush">
        {{#each documentos}}
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <span class="fw-semibold">{{nome}}</span>
          <span>
            {{#if (urlDocumento this 'gestao')}}<a href="{{urlDocumento this 'gestao'}}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">Ver</a>{{/if}}
            {{#if (urlDocumentoExterno this)}}<a href="{{urlDocumentoExterno this}}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">Link externo</a>{{/if}}
            {{#if (eq drive_status 'guardado')}}<span class="badge text-bg-success ms-1">☁ Drive</span>{{/if}}
          </span>
        </li>
        {{else}}
        <li class="list-group-item text-muted">Sem documentos associados.</li>
        {{/each}}
      </ul>
    </div>

    {{!-- Pagamentos --}}
    <div class="card mb-3">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-cash-coin me-1"></i>Pagamentos</span>
        <a href="/admin/fornecedores/{{fornecedor.id}}/pagamentos/novo" class="btn btn-sm btn-outline-primary">+ Novo pagamento</a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr><th>Data</th><th>Valor</th><th>Método</th><th>Estado</th><th>Comprovativo</th><th class="text-end">Ações</th></tr>
          </thead>
          <tbody>
            {{#each pagamentos}}
            <tr>
              <td class="text-nowrap">{{formatDate data_pagamento}}</td>
              <td class="fw-semibold">{{eur valor}}</td>
              <td>{{#if metodo_pagamento}}{{metodo_pagamento.nome}}{{else}}—{{/if}}</td>
              <td>
                {{#if (eq estado 'pago')}}<span class="badge text-bg-success">Pago</span>
                {{else if (eq estado 'cancelado')}}<span class="badge text-bg-secondary">Cancelado</span>
                {{else}}<span class="badge text-bg-warning">Pendente</span>{{/if}}
              </td>
              <td>{{#if comprovativo}}<span class="badge text-bg-success">☁</span>{{else}}—{{/if}}</td>
              <td class="text-end">
                <a aria-label="Ver" href="/admin/fornecedores/{{../fornecedor.id}}/pagamentos/{{id}}" class="btn btn-sm btn-outline-secondary" title="Ver"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></a>
              </td>
            </tr>
            {{else}}
            <tr><td colspan="6" class="text-center text-muted py-3">Sem pagamentos registados.</td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>

    {{!-- Comunicações --}}
    <div class="card">
      <div class="card-header bg-white"><i class="bi bi-envelope me-1"></i>Comunicações (envios)</div>
      <ul class="list-group list-group-flush">
        {{#each comunicacoes}}
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <span class="fw-semibold small">{{assunto}}</span>
            <div class="small text-muted">para {{destinatario_email}}{{#if utilizador}} · por {{utilizador.nome}}{{/if}}</div>
          </div>
          {{#if (eq estado 'enviado')}}<span class="badge text-bg-success">Enviado</span>
          {{else if (eq estado 'erro')}}<span class="badge text-bg-danger">Erro</span>
          {{else}}<span class="badge text-bg-warning">{{estado}}</span>{{/if}}
        </li>
        {{else}}
        <li class="list-group-item text-muted">Ainda não foram enviados emails a este fornecedor.</li>
        {{/each}}
      </ul>
    </div>
  </div>
</div>
