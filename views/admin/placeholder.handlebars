{{#if (eq modulo 'Votações')}}{{> _assembleias-tabs ativo='votacoes'}}{{/if}}
<div class="page-heading">
  <h1>{{modulo}}</h1>
  <p class="subtitle">Este módulo ainda não está disponível</p>
</div>

<div class="card">
  <div class="card-body text-center py-5">
    <span class="material-symbols-outlined" style="font-size:3.5rem;color:var(--c-text-muted);opacity:.45">{{icono}}</span>
    <h2 class="h4 mt-3">Em desenvolvimento</h2>
    <p class="text-muted mb-0">O módulo «{{modulo}}» estará disponível numa próxima versão do GesCondu.</p>
    {{#if sugestao}}
    <div class="mx-auto mt-4 p-3 border rounded bg-light text-start" style="max-width:520px">
      <div class="small fw-semibold text-secondary mb-1">Entretanto, pode:</div>
      <p class="small text-muted mb-3">{{sugestao}}</p>
      <a href="{{link}}" class="btn btn-sm btn-outline-primary">{{linkTexto}}</a>
    </div>
    {{/if}}
  </div>
</div>
