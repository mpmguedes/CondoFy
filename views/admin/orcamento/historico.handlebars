<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><i class="bi bi-clock-history me-2"></i>{{titulo}}</h1>
  <a href="/admin/orcamento/{{orcamento.id}}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Voltar</a>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Data</th>
          <th>Utilizador</th>
          <th>Tipo</th>
          <th>Entidade</th>
          <th>Anterior</th>
          <th>Novo</th>
          <th>Justificação</th>
        </tr>
      </thead>
      <tbody>
        {{#each alteracoes}}
        <tr>
          <td class="text-nowrap small">{{formatDateTime data_alteracao}}</td>
          <td>{{#if utilizador}}{{utilizador.nome}}{{else}}—{{/if}}</td>
          <td><span class="badge text-bg-light border">{{tipo_alteracao}}</span></td>
          <td>{{entidade_alterada}} {{#if entidade_id}}#{{entidade_id}}{{/if}}</td>
          <td>{{#if valor_anterior}}{{eur valor_anterior}}{{else}}—{{/if}}</td>
          <td>{{#if valor_novo}}{{eur valor_novo}}{{else}}—{{/if}}</td>
          <td class="small text-muted">{{justificacao}}</td>
        </tr>
        {{else}}
        <tr><td colspan="7" class="text-center text-muted py-4">Sem alterações registadas.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
