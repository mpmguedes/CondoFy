{{!--
  Vista de DIAGNÓSTICO (suporte read-only) do detalhe de um orçamento.

  Mantém rubricas, valores, distribuição, periodicidade, estado e histórico de
  alterações. O autor de cada alteração aparece apenas com INICIAIS (o nome é
  substituído no router). Não há nenhuma ação de escrita.
--}}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h1 class="h3 mb-1">{{orcamento.designacao}}</h1>
    <p class="text-muted mb-0">
      {{formatDate orcamento.data_inicio}} — {{formatDate orcamento.data_fim}}
      {{#if (eq orcamento.estado 'rascunho')}}<span class="badge text-bg-secondary ms-2">Rascunho</span>
      {{else if (eq orcamento.estado 'aprovado')}}<span class="badge text-bg-success ms-2">Aprovado</span>
      {{else if (eq orcamento.estado 'em_execucao')}}<span class="badge text-bg-info ms-2">Em execução</span>
      {{else if (eq orcamento.estado 'encerrado')}}<span class="badge text-bg-dark ms-2">Fechado</span>
      {{else if (eq orcamento.estado 'anulado')}}<span class="badge text-bg-danger ms-2">Anulado</span>{{/if}}
    </p>
  </div>
  <a href="/admin/orcamento" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1">arrow_back</span>Voltar</a>
</div>

<div class="alert alert-info d-flex align-items-center gap-2 small">
  <span class="material-symbols-outlined">info</span>
  <div>Vista de diagnóstico — apenas leitura. O autor das alterações é apresentado só com iniciais.</div>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="card stat-card h-100"><div class="card-body">
      <div class="stat-label">Total do orçamento</div>
      <div class="stat-value">{{eur total}}</div>
    </div></div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card h-100"><div class="card-body">
      <div class="stat-label">Rubricas</div>
      <div class="stat-value">{{orcamento.rubricas.length}}</div>
    </div></div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card h-100"><div class="card-body">
      <div class="stat-label">Frações na distribuição</div>
      <div class="stat-value">{{nDistribuicoes}}</div>
    </div></div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card h-100"><div class="card-body">
      <div class="stat-label">Linhas no plano de quotas</div>
      <div class="stat-value">{{nPlano}}</div>
    </div></div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header bg-white"><i class="bi bi-list-ul me-1"></i>Rubricas</div>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Descrição</th>
          <th>Categoria</th>
          <th class="text-end">Valor anual</th>
          <th>Distribuição</th>
          <th>Periodicidade</th>
        </tr>
      </thead>
      <tbody>
        {{#each orcamento.rubricas}}
        <tr>
          <td class="fw-semibold">{{descricao}}</td>
          <td>{{#if categoria}}{{categoria.nome}}{{else}}—{{/if}}</td>
          <td class="text-end">{{eur valor_anual}}</td>
          <td>{{metodo_distribuicao}}</td>
          <td>{{periodicidade}}</td>
        </tr>
        {{else}}
        <tr><td colspan="5" class="text-muted">Sem rubricas.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

{{#if alteracoes}}
<div class="card">
  <div class="card-header bg-white"><i class="bi bi-clock-history me-1"></i>Últimas alterações</div>
  <ul class="list-group list-group-flush">
    {{#each alteracoes}}
    <li class="list-group-item d-flex justify-content-between">
      <span>{{tipo_alteracao}} {{#if entidade_alterada}}({{entidade_alterada}}){{/if}} {{#if valor_anterior}}{{eur valor_anterior}} → {{eur valor_novo}}{{/if}}</span>
      <span class="text-muted small">{{#if utilizador}}{{utilizador.nome}}{{/if}} · {{formatDateTime data_alteracao}}</span>
    </li>
    {{/each}}
  </ul>
</div>
{{/if}}
