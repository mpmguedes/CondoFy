<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <h1>{{titulo}}</h1>
  <a href="/admin/orcamento/{{orcamento.id}}" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1">arrow_back</span>Voltar</a>
</div>

<div class="row g-4">
  <div class="col-12 col-lg-6">
    <div class="card">
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-6">Orçamento ativo</dt><dd class="col-6">{{orcamento.designacao}}</dd>
          <dt class="col-6">Período</dt><dd class="col-6">{{formatDate orcamento.data_inicio}} — {{formatDate orcamento.data_fim}}</dd>
        </dl>
      </div>
    </div>

    {{#if meses}}
    <div class="card mt-3">
      <div class="card-header bg-white"><i class="bi bi-calendar-event me-1"></i>Emitir quotas</div>
      <div class="card-body">
        <form action="/admin/orcamento/{{orcamento.id}}/emitir" method="POST">
          <div class="mb-3">
            <label class="form-label">Período a emitir</label>
            <select class="form-select" name="periodo">
              {{#each meses}}
              <option value="{{ano}}-{{mes}}" {{#if (and (eq ano ../proximoAno) (eq mes ../proximoMes))}}selected{{/if}}>
                {{monthName mes}} {{ano}}
              </option>
              {{/each}}
            </select>
          </div>
          <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Emitir avisos</button>
        </form>
      </div>
    </div>
    {{else}}
    <div class="alert alert-info mt-3">Não há quotas planeadas por emitir. Gere primeiro o <strong>plano de quotas</strong>.</div>
    {{/if}}
  </div>

  <div class="col-12 col-lg-6">
    {{#if meses}}
    <div class="card">
      <div class="card-header bg-white"><i class="bi bi-list me-1"></i>Períodos no plano</div>
      <ul class="list-group list-group-flush">
        {{#each meses}}
        <li class="list-group-item small">{{monthName mes}} {{ano}}</li>
        {{/each}}
      </ul>
    </div>
    {{/if}}
  </div>
</div>
