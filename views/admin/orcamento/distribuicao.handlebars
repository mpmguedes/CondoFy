<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <h1>{{titulo}}</h1>
  <a href="/admin/orcamento/{{orcamento.id}}" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1">arrow_back</span>Voltar</a>
</div>

<p class="text-muted mb-3">Os valores são pré-calculados (permilagem/igual) mas podem ser ajustados manualmente. Ao guardar, fica registada a distribuição explícita.</p>

<form action="/admin/orcamento/{{orcamento.id}}/distribuicao" method="POST">
  <div class="card">
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Fração</th>
            {{#each rubricas}}<th class="text-end">{{descricao}} <span class="text-muted small">({{metodo}})</span></th>{{/each}}
          </tr>
        </thead>
        <tbody>
          {{#each linhas}}
          <tr>
            <td class="fw-semibold text-nowrap">{{designacao}} <span class="text-muted small">({{permilagem}}‰)</span></td>
            {{#each valores}}
            {{!-- Os ids levam prefixo (`r`/`f`) DE PROPÓSITO: o body-parser
                 (`qs`, via `express.urlencoded({extended:true})`) interpreta
                 chaves numéricas abaixo de 100 como ÍNDICES DE ARRAY. Com
                 `dist[11][21]` o corpo era convertido em `[[…],[…]]`, os ids
                 perdiam-se e a gravação tentava `rubrica_id = 0` →
                 `ER_NO_REFERENCED_ROW_2`. O prefixo torna a chave não numérica
                 e o valor chega intacto. --}}
            <td><input type="text" class="form-control form-control-sm text-end" name="dist[r{{rubricaId}}][f{{../id}}]" value="{{valor}}" /></td>
            {{/each}}
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    <div class="card-body border-top">
      <button type="submit" class="btn btn-primary" data-ajuda="Guarda como o valor de cada rubrica é repartido pelas frações. Aplica-se à emissão de quotas a partir deste orçamento." data-ajuda-titulo="Guardar distribuição"><i class="bi bi-check-lg me-1"></i>Guardar distribuição</button>
    </div>
  </div>
</form>
