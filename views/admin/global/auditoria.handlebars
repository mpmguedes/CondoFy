<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>Auditoria</h1>
    <p class="subtitle">Consulta global dos eventos de segurança e administração</p>
  </div>
  <a href="/admin/global" class="btn btn-outline-secondary btn-sm"><span class="material-symbols-outlined me-1" style="font-size:1rem">arrow_back</span>Global</a>
</div>

<form method="GET" action="/admin/global/auditoria" class="card mb-3">
  <div class="card-body row g-2 align-items-end">
    <div class="col-12 col-md-4">
      <label class="form-label">Ação</label>
      <select name="acao" class="form-select">
        <option value="">Todas as ações</option>
        {{#each acoes}}
        <option value="{{this}}" {{#if (eq ../filtros.acao this)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
    </div>
    <div class="col-12 col-md-4">
      <label class="form-label">Entidade</label>
      <input type="text" name="entidade" class="form-control" value="{{filtros.entidade}}" placeholder="Ex: Condominio, User…" />
    </div>
    <div class="col-12 col-md-4 d-flex gap-2">
      <button class="btn btn-primary flex-grow-1">Filtrar</button>
      <a href="/admin/global/auditoria" class="btn btn-outline-secondary">Limpar</a>
    </div>
  </div>
</form>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr><th>Data/hora</th><th>Utilizador</th><th>Ação</th><th>Entidade</th><th class="text-end">ID</th><th>Detalhes</th></tr>
      </thead>
      <tbody>
        {{#each registos}}
        <tr>
          <td class="small text-nowrap">{{formatDateTime data_hora}}</td>
          <td class="small">{{#if user}}{{user.nome}}<span class="text-muted"> ({{user.email}})</span>{{else}}<span class="text-muted">—</span>{{/if}}</td>
          <td><span class="badge text-bg-light border">{{acao}}</span></td>
          <td class="small">{{#if entidade}}{{entidade}}{{else}}—{{/if}}</td>
          <td class="text-end small">{{#if entidade_id}}{{entidade_id}}{{else}}—{{/if}}</td>
          <td class="small text-muted">{{#if detalhes}}{{detalhes}}{{else}}—{{/if}}</td>
        </tr>
        {{else}}
        <tr><td colspan="6" class="text-center text-muted py-4">Sem registos de auditoria.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
