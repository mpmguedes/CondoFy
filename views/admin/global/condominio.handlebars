<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>{{condominio.designacao}}</h1>
    <p class="subtitle">{{#if (eq condominio.estado 'ativo')}}Ativo{{else}}Desativado{{/if}} · {{nFracoes}} fração/frações{{#if condominio.nif}} · NIF {{condominio.nif}}{{/if}}{{#if condominio.localidade}} · {{condominio.localidade}}{{/if}}</p>
    {{#if condominio.morada}}
    <p class="subtitle mb-0">{{condominio.morada}}{{#if condominio.codigo_postal}} · {{condominio.codigo_postal}}{{/if}}</p>
    {{/if}}
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/global/condominios/{{condominio.id}}/suporte" class="btn btn-sm btn-primary"><span class="material-symbols-outlined me-1" style="font-size:1rem">support_agent</span>Acesso de suporte</a>
    <a href="/admin/global/condominios" class="btn btn-sm btn-outline-secondary"><span class="material-symbols-outlined me-1" style="font-size:1rem">arrow_back</span>Condomínios</a>
  </div>
</div>

<div class="row g-4">
  <div class="col-12 col-lg-6">
    {{!--
      Identificação do condomínio. Estes campos deixaram de ser imutáveis
      depois da criação: sem este formulário, corrigir a designação ou o NIF
      exigia um admin do condomínio (que pode ainda não existir) e, se o
      condomínio estivesse desativado, ninguém o podia fazer — nem o próprio
      admin, porque a edição do condomínio está atrás de um contexto ATIVO.
      Só se envia o que o servidor lê e valida (NIF incluído, no servidor).
    --}}
    <div class="card mb-4">
      <div class="card-header bg-white">Dados do condomínio</div>
      <div class="card-body">
        <form action="/admin/global/condominios/{{condominio.id}}/dados" method="POST" class="row g-2">
          <div class="col-12">
            <label class="form-label" for="dados_designacao">Nome do condomínio <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="dados_designacao" name="designacao" required maxlength="191" value="{{condominio.designacao}}" />
          </div>
          <div class="col-12 col-md-8">
            <label class="form-label" for="dados_morada">Morada</label>
            <input type="text" class="form-control" id="dados_morada" name="morada" maxlength="255" value="{{condominio.morada}}" />
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label" for="dados_codigo_postal">Código postal</label>
            <input type="text" class="form-control" id="dados_codigo_postal" name="codigo_postal" maxlength="20" value="{{condominio.codigo_postal}}" />
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label" for="dados_localidade">Localidade</label>
            <input type="text" class="form-control" id="dados_localidade" name="localidade" maxlength="120" value="{{condominio.localidade}}" />
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label" for="dados_nif">NIF</label>
            <input type="text" class="form-control" id="dados_nif" name="nif" maxlength="20" autocomplete="off" value="{{condominio.nif}}" />
          </div>
          <div class="col-12">
            <button class="btn btn-primary" data-ajuda="Guarda a identificação do condomínio. Este formulário existe para o Super Admin poder corrigir dados de um condomínio sem administrador associado ou já desativado. Os dados bancários e a identidade visual continuam a ser geridos pelo próprio condomínio." data-ajuda-titulo="Guardar dados do condomínio">Guardar dados</button>
          </div>
        </form>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-header bg-white">Associar utilizador</div>
      <div class="card-body">
        <form action="/admin/global/condominios/{{condominio.id}}/associacoes" method="POST" class="row g-2 align-items-end">
          <div class="col-12 col-md-5"><label class="form-label">Email do utilizador</label><input type="email" class="form-control" name="email" required placeholder="Ex: geral@empresa.pt" /></div>
          <div class="col-12 col-md-4"><label class="form-label">Papel</label>
            <select class="form-select" name="role"><option value="admin">Admin</option><option value="gestor">Gestor</option><option value="leitura">Leitura</option></select>
          </div>
          <div class="col-12 col-md-3 d-grid"><button class="btn btn-primary" data-ajuda="Associa um utilizador já existente a este condomínio com o papel escolhido. Só com o acesso ativo é que o utilizador consegue entrar." data-ajuda-titulo="Associar utilizador">Associar</button></div>
          <div class="col-12">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="reativar_acesso_global" name="reativar_acesso" value="1" />
              <label class="form-check-label small" for="reativar_acesso_global">
                <strong>Reativar acesso</strong> — só é preciso se o acesso deste utilizador a este condomínio
                estiver encerrado; sem esta marcação o acesso mantém-se encerrado.
              </label>
            </div>
          </div>
        </form>
        <p class="form-text mb-0 mt-2">O utilizador tem de existir (criado pelo administrador).</p>
      </div>
    </div>

    <div class="card">
      <div class="card-header bg-white">Membros</div>
      <ul class="list-group list-group-flush">
        {{#each associacoes}}
        <li class="list-group-item d-flex flex-wrap align-items-center gap-2">
          <div class="me-auto">
            <span class="fw-semibold">{{utilizador.nome}}</span>
            <span class="small text-muted ms-2">{{utilizador.email}}</span>
          </div>
          <form action="/admin/global/associacoes/{{id}}/estado" method="POST" class="d-flex gap-1 align-items-center">
            <select class="form-select form-select-sm" name="role">
              <option value="admin" {{#if (eq role 'admin')}}selected{{/if}}>Admin</option>
              <option value="gestor" {{#if (eq role 'gestor')}}selected{{/if}}>Gestor</option>
              <option value="leitura" {{#if (eq role 'leitura')}}selected{{/if}}>Leitura</option>
            </select>
            <select class="form-select form-select-sm" name="estado">
              <option value="ativo" {{#if (eq estado 'ativo')}}selected{{/if}}>Ativo</option>
              <option value="inativo" {{#if (eq estado 'inativo')}}selected{{/if}}>Inativo</option>
            </select>
            <button class="btn btn-sm btn-outline-secondary" data-ajuda="Guarda o papel e o estado deste acesso. As permissões do utilizador neste condomínio mudam de imediato." data-ajuda-titulo="Guardar acesso">Guardar</button>
          </form>
          <form action="/admin/global/associacoes/{{id}}/eliminar" method="POST" data-confirmar="Remover esta associação?" data-confirmar-perigo="1">
            <button class="btn btn-sm btn-outline-danger" data-ajuda="Remove o acesso deste utilizador a este condomínio. Os registos que ele criou mantêm-se." data-ajuda-titulo="Remover associação">Remover</button>
          </form>
        </li>
        {{else}}
        <li class="list-group-item text-muted small">Sem membros associados.</li>
        {{/each}}
      </ul>
    </div>
  </div>

  <div class="col-12 col-lg-6">
    <div class="card border-danger-subtle">
      <div class="card-header bg-danger-subtle text-danger">Zona destrutiva</div>
      <div class="card-body">
        <p class="small text-muted">Ciclo recomendado: <strong>Ativo → Desativado → Eliminação permanente</strong>. A eliminação remove os dados do condomínio e não pode ser anulada.</p>
        {{#unless (eq condominio.estado 'inativo')}}
        {{!--
          Desativação: exige MOTIVO (o servidor recusa sem ele, e audita a
          recusa) e INTENÇÃO explícita. O campo `acao` viaja no formulário —
          sem ele o POST a `/:id/estado` é recusado, porque a rota deixou de
          ser um toggle cego.
        --}}
        <form action="/admin/global/condominios/{{condominio.id}}/estado" method="POST" id="estado">
          <input type="hidden" name="acao" value="desativar" />
          <label class="form-label" for="motivo_desativacao">Motivo da desativação <span class="text-danger">*</span></label>
          <input type="text" class="form-control mb-2" id="motivo_desativacao" name="motivo" required maxlength="255" autocomplete="off" placeholder="Ex: obras estruturais no edifício" />
          <button class="btn btn-outline-danger" data-ajuda="Desativa o condomínio: os utilizadores deixam de conseguir entrar e os acessos de suporte em vigor são encerrados. O motivo é obrigatório e fica registado na auditoria." data-ajuda-titulo="Desativar condomínio">Desativar condomínio</button>
        </form>
        {{else}}
        <form action="/admin/global/condominios/{{condominio.id}}/estado" method="POST" class="mb-3">
          <input type="hidden" name="acao" value="reativar" />
          <button class="btn btn-outline-success" data-ajuda="Reativa o condomínio e volta a permitir a entrada aos utilizadores associados. O histórico mantém-se." data-ajuda-titulo="Reativar condomínio">Reativar condomínio</button>
        </form>
        <form action="/admin/global/condominios/{{condominio.id}}/eliminar" method="POST">
          <label class="form-label">Para eliminar permanentemente escreva <strong>ELIMINAR</strong>:</label>
          <input type="text" class="form-control mb-2" name="confirmo" required placeholder="ELIMINAR" autocomplete="off" />
          <button class="btn btn-danger" data-ajuda="Apaga permanentemente todos os dados deste condomínio: frações, quotas, pagamentos, documentos e histórico. Não pode ser anulado." data-ajuda-titulo="Eliminar condomínio">Eliminar permanentemente</button>
        </form>
        {{/unless}}
      </div>
    </div>
  </div>
</div>
