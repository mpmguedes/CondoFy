<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <h1 class="h3 mb-0"><i class="bi bi-megaphone me-2"></i>Avisos e comunicações</h1>
  <a href="/admin/avisos/nova" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Novo aviso</a>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Assunto</th>
          <th>Tipo</th>
          <th>Programado</th>
          <th>Criado</th>
          <th class="text-end">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each avisos}}
        <tr>
          <td class="fw-semibold">{{assunto}}</td>
          <td>
            {{#if (eq tipo 'automatico')}}<span class="badge text-bg-info">Automático</span>
            {{else if (eq tipo 'programado')}}<span class="badge text-bg-warning">Programado</span>
            {{else}}<span class="badge text-bg-primary">Manual</span>{{/if}}
          </td>
          <td>{{#if data_programada}}{{formatDate data_programada}}{{else}}—{{/if}}</td>
          <td>{{formatDateTime createdAt}}</td>
          <td class="text-end">
            <a href="/admin/avisos/{{id}}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
          </td>
        </tr>
        {{else}}
        <tr><td colspan="5" class="text-center text-muted py-4">Sem avisos.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
