<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>Avisos</h1>
    <p class="subtitle">Comunicações e avisos aos condóminos</p>
  </div>
  <a href="/admin/avisos/nova" class="btn btn-primary"><span class="material-symbols-outlined me-1">add</span>Novo aviso</a>
</div>

{{#if avisos}}
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Assunto</th>
          <th>Tipo</th>
          <th>Programado</th>
          <th>Criado</th>
          <th class="text-end">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each avisos}}
        <tr>
          <td class="fw-semibold">{{assunto}}</td>
          <td>
            {{#if (eq tipo 'automatico')}}<span class="badge text-bg-info">Automático</span>
            {{else if (eq tipo 'programado')}}<span class="badge text-bg-warning">Programado</span>
            {{else}}<span class="badge text-bg-primary">Manual</span>{{/if}}
          </td>
          <td>{{#if data_programada}}{{formatDate data_programada}}{{else}}—{{/if}}</td>
          <td>{{formatDateTime createdAt}}</td>
          <td class="text-end">
            <a href="/admin/avisos/{{id}}" class="btn btn-sm btn-outline-secondary" title="Ver"><span class="material-symbols-outlined">visibility</span></a>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
{{> _empty-state icon="campaign" titulo="Sem avisos" descricao="Crie avisos para comunicar com os condóminos." link="/admin/avisos/nova" linkTexto="Novo aviso"}}
{{/if}}
