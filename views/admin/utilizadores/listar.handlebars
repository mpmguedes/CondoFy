<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>Utilizadores</h1>
    <p class="subtitle">Contas de acesso à aplicação</p>
  </div>
  <a href="/admin/utilizadores/nova" class="btn btn-primary"><span class="material-symbols-outlined me-1">person_add</span>Novo utilizador</a>
</div>

{{#if users}}
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Nome</th>
          <th>Email</th>
          <th>Papel</th>
          <th>Condómino associado</th>
          <th>Estado</th>
          <th class="text-end">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each users}}
        <tr>
          <td class="fw-semibold">{{nome}}</td>
          <td>{{email}}</td>
          <td>
            {{#if (eq role 'admin')}}<span class="badge text-bg-dark">Administrador</span>
            {{else}}<span class="badge text-bg-light border">Condómino</span>{{/if}}
          </td>
          <td>{{#if pessoa}}{{pessoa.nome}}{{else}}<span class="text-muted">—</span>{{/if}}</td>
          <td>
            {{#if ativo}}<span class="badge text-bg-success">Ativo</span>{{else}}<span class="badge text-bg-secondary">Inativo</span>{{/if}}
            {{#if convite_token}}
              {{#if (eq estadoConvite 'aceite')}}<span class="badge text-bg-success-subtle border">Convite aceite</span>
              {{else if (eq estadoConvite 'revogado')}}<span class="badge text-bg-light border">Convite revogado</span>
              {{else if (eq estadoConvite 'expirado')}}<span class="badge text-bg-warning-subtle border">Convite expirado</span>
              {{else}}<span class="badge text-bg-info-subtle border">Convite enviado</span>{{/if}}
            {{/if}}
          </td>
          <td class="text-end">
            {{#if podeConvite}}
            <form action="/admin/utilizadores/{{id}}/reenviar-convite" method="POST" class="d-inline">
              <button class="btn btn-sm btn-outline-primary" title="Reenviar convite"><span class="material-symbols-outlined">forward_to_inbox</span></button>
            </form>
            <form action="/admin/utilizadores/{{id}}/revogar-convite" method="POST" class="d-inline" data-confirmar="Revogar este convite?" data-confirmar-perigo="1">
              <button class="btn btn-sm btn-outline-secondary" title="Revogar convite"><span class="material-symbols-outlined">block</span></button>
            </form>
            {{/if}}
            <a href="/admin/utilizadores/{{id}}/editar" class="btn btn-sm btn-outline-secondary" title="Editar"><span class="material-symbols-outlined">edit</span></a>
            <form action="/admin/utilizadores/{{id}}/eliminar" method="POST" class="d-inline" data-confirmar="Eliminar este utilizador?" data-confirmar-perigo="1">
              <button class="btn btn-sm btn-outline-danger" title="Eliminar"><span class="material-symbols-outlined">delete</span></button>
            </form>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
{{> _empty-state icon="manage_accounts" titulo="Ainda não existem utilizadores" descricao="Crie contas de acesso para os condóminos ou administradores." link="/admin/utilizadores/nova" linkTexto="Novo utilizador"}}
{{/if}}
