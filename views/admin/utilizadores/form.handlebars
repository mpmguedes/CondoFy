<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <h1>{{titulo}}</h1>
  <a href="/admin/utilizadores" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1" aria-hidden="true">arrow_back</span>Voltar</a>
</div>

{{!-- Três coisas distintas nesta página: os dados/conta (formulário de guardar),
     o acesso a ESTE condomínio (ações próprias) e as titularidades das frações
     (que se gerem na ficha de cada fração, nunca aqui). --}}
<div class="row">
  <div class="col-12 col-lg-8">
    <div class="card">
      <div class="card-body">
        <form action="{{#if user}}/admin/utilizadores/{{user.id}}{{else}}/admin/utilizadores{{/if}}" method="POST">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Nome *</label>
              <input type="text" class="form-control" name="nome" value="{{user.nome}}" required />
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Email *</label>
              <input type="email" class="form-control" name="email" value="{{user.email}}" required />
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Papel</label>
              <select class="form-select" name="role">
                <option value="condomino" {{selected user.role 'condomino'}}>Condómino</option>
                <option value="admin" {{selected user.role 'admin'}}>Administrador</option>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Condómino associado (Pessoa)</label>
              <select class="form-select" name="pessoa_id">
                <option value="">— Sem associação —</option>
                {{#each pessoas}}
                <option value="{{id}}" {{selected ../user.pessoa_id id}}>{{nome}}</option>
                {{/each}}
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">{{#if user}}Nova palavra-passe (deixar em branco para manter){{else}}Palavra-passe (opcional se enviar convite){{/if}}</label>
            <input type="password" class="form-control" name="password" autocomplete="new-password" />
          </div>
          {{#unless user}}
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="enviar_convite" name="enviar_convite" value="1" />
            <label class="form-check-label" for="enviar_convite">
              <strong>Enviar convite por email</strong> — o utilizador escolhe a palavra-passe ao aceitar o convite
              (link válido por 30 dias; não é preciso definir palavra-passe agora).
            </label>
          </div>
          {{/unless}}
          {{#if user}}
          <hr class="my-4" />
          <h2 class="h6 mb-1">Conta</h2>
          <p class="text-muted small mb-3">
            A conta é <strong>global</strong>: ativa ou inativa, vale para todos os condomínios a que a
            pessoa esteja associada — e é independente do acesso a cada condomínio.
          </p>
          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="ativo" name="ativo" {{#if user.ativo}}checked{{/if}} />
            <label class="form-check-label" for="ativo">
              <strong>Conta ativa</strong>
              <span class="text-muted small">— desativar impede a entrada na plataforma em todos os condomínios</span>
            </label>
          </div>
          <div class="mb-3">
            <label class="form-label" for="motivo_conta">Motivo (obrigatório para desativar a conta)</label>
            <input type="text" class="form-control" id="motivo_conta" name="motivo_conta" maxlength="180"
                   placeholder="Ex.: pedido do condómino, conta duplicada, cessação de funções" autocomplete="off" />
            <div class="form-text">Fica registado na auditoria, com o estado anterior e o novo.</div>
          </div>
          {{/if}}
          <button type="submit" class="btn btn-primary">Guardar</button>
        </form>
      </div>
    </div>

    {{#if user}}
    <div class="card mt-3">
      <div class="card-body">
        <h2 class="h6 mb-1">Acesso a este condomínio</h2>
        <p class="text-muted small mb-2">
          O acesso é <strong>por condomínio</strong> e depende da associação, não da conta: uma conta
          ativa pode ter o acesso encerrado a este condomínio e continuar a entrar nos restantes.
          As titularidades das frações gerem-se na ficha de cada fração e não são alteradas aqui.
        </p>
        <p class="mb-3">
          Estado atual:
          {{#if assocAtiva}}<span class="badge text-bg-success">Ativo</span>
          {{else}}<span class="badge text-bg-warning-subtle border">Encerrado</span>{{/if}}
        </p>

        {{#if assocAtiva}}
        <form action="/admin/utilizadores/{{user.id}}/encerrar-acesso" method="POST"
              data-confirmar="Encerrar o acesso deste utilizador a este condomínio? A conta e as titularidades não são alteradas."
              data-confirmar-perigo="1"
              class="border rounded p-3">
          <label class="form-label" for="motivo_encerrar">Encerrar acesso a este condomínio</label>
          <div class="text-muted small mb-2">
            Só encerra o acesso desta conta a <strong>este</strong> condomínio. A conta, as titularidades e
            toda a informação do condomínio ficam como estão; a associação mantém-se registada e pode ser
            reaberta. Para o próprio utilizador deixar o condomínio, com exportação da sua informação,
            existe «Preparar saída do condomínio» na área dele.
          </div>
          <div class="row g-2 align-items-end">
            <div class="col-12 col-md-8">
              <input type="text" class="form-control" id="motivo_encerrar" name="motivo" maxlength="180" required
                     placeholder="Motivo do encerramento do acesso" autocomplete="off" />
              <div class="form-text">O motivo é obrigatório e fica registado na auditoria.</div>
            </div>
            <div class="col-12 col-md-4 d-grid">
              <button class="btn btn-outline-danger">Encerrar acesso</button>
            </div>
          </div>
        </form>
        {{else}}
        <form action="/admin/utilizadores/{{user.id}}/reativar-acesso" method="POST" class="border rounded p-3">
          <label class="form-label" for="motivo_reativar">Reativar acesso a este condomínio</label>
          <div class="text-muted small mb-2">
            Volta a dar acesso a <strong>este</strong> condomínio a esta conta (por exemplo, depois de o
            próprio utilizador ter preparado a saída, ou de o acesso ter sido encerrado por engano).
            Não altera a conta nem as titularidades.
          </div>
          <div class="row g-2 align-items-end">
            <div class="col-12 col-md-8">
              <input type="text" class="form-control" id="motivo_reativar" name="motivo" maxlength="180"
                     placeholder="Motivo (opcional)" autocomplete="off" />
            </div>
            <div class="col-12 col-md-4 d-grid">
              <button class="btn btn-outline-success">Reativar acesso</button>
            </div>
          </div>
        </form>
        {{/if}}
      </div>
    </div>
    {{/if}}
  </div>
</div>
