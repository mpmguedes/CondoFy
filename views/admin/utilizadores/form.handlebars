<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <h1>{{titulo}}</h1>
  <a href="/admin/utilizadores" class="btn btn-outline-secondary"><span class="material-symbols-outlined me-1">arrow_back</span>Voltar</a>
</div>

<div class="row">
  <div class="col-12 col-lg-8">
    <div class="card">
      <div class="card-body">
        <form action="{{#if user}}/admin/utilizadores/{{user.id}}{{else}}/admin/utilizadores{{/if}}" method="POST">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Nome *</label>
              <input type="text" class="form-control" name="nome" value="{{user.nome}}" required />
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Email *</label>
              <input type="email" class="form-control" name="email" value="{{user.email}}" required />
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Papel</label>
              <select class="form-select" name="role">
                <option value="condomino" {{selected user.role 'condomino'}}>Condómino</option>
                <option value="admin" {{selected user.role 'admin'}}>Administrador</option>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Condómino associado (Pessoa)</label>
              <select class="form-select" name="pessoa_id">
                <option value="">— Sem associação —</option>
                {{#each pessoas}}
                <option value="{{id}}" {{selected ../user.pessoa_id id}}>{{nome}}</option>
                {{/each}}
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">{{#if user}}Nova palavra-passe (deixar em branco para manter){{else}}Palavra-passe{{/if}}</label>
            <input type="password" class="form-control" name="password" autocomplete="new-password" {{#unless user}}required{{/unless}} />
          </div>
          {{#if user}}
          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="ativo" name="ativo" {{#if user.ativo}}checked{{/if}} />
            <label class="form-check-label" for="ativo">Ativo</label>
          </div>
          {{/if}}
          <button type="submit" class="btn btn-primary">Guardar</button>
        </form>
      </div>
    </div>
  </div>
</div>
