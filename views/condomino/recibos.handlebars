{{> _condomino-quotas-tabs ativo='recibos'}}
{{!-- Recibos emitidos para a fração do condómino.

     Cartões por recibo no telemóvel (sem tabela horizontal); a partir de 768px a
     tabela compacta. O PDF é sempre servido por `/condomino/recibos/:id/pdf`,
     que revalida a sessão, o condomínio ativo e a fração em cada pedido. --}}
<div class="page-heading portal-cabecalho">
  <h1>Os meus recibos</h1>
  <p class="subtitle">Recibos emitidos para a sua fração{{#if nRecibos}} · {{nRecibos}} recibo(s){{/if}}</p>
</div>

{{#if acesso}}
{{> _portal-estado-associacao}}
{{else}}
{{#if linhas}}

{{#if listaTruncada}}{{> _portal-lista-limitada}}{{/if}}

{{!-- Telemóvel: um recibo por bloco, identificável sem abrir o PDF. --}}
<ul class="portal-quota-lista">
  {{#each linhas}}
  <li class="portal-quota">
    <div class="portal-quota-topo">
      <span class="portal-quota-periodo">Recibo {{codigo}}{{#if (and ../temVariasFracoes fracaoDesignacao)}} · {{fracaoDesignacao}}{{/if}}</span>
      {{#if (eq estado 'anulado')}}<span class="badge text-bg-secondary">Anulado</span>
      {{else}}<span class="badge text-bg-success">Emitido</span>{{/if}}
    </div>
    <div class="portal-quota-valor">{{eur valor}}</div>
    <div class="portal-quota-meta">
      {{#if data_emissao}}<span>Emitido {{formatDate data_emissao}}</span>{{/if}}
      {{#if periodos}}<span>{{periodos}}</span>{{/if}}
      {{#if temExtras}}<span>Inclui quota extraordinária</span>{{/if}}
    </div>
    <div class="portal-doc-acoes">
      <a class="btn btn-primary portal-btn" href="/condomino/recibos/{{id}}/pdf" target="_blank" rel="noopener">
        <span class="material-symbols-outlined" aria-hidden="true">picture_as_pdf</span>Ver recibo (PDF)
      </a>
    </div>
  </li>
  {{/each}}
</ul>

{{!-- Desktop: tabela compacta com a mesma informação. --}}
<div class="card portal-quota-tabela"><div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <caption class="visually-hidden">Recibos emitidos para a sua fração: número, data, período, valor, estado e acesso ao PDF</caption>
    <thead class="table-light">
      <tr>
        <th scope="col">Recibo</th><th scope="col">Data</th>
        {{#if temVariasFracoes}}<th scope="col">Fração</th>{{/if}}
        <th scope="col">Período(s)</th><th scope="col">Valor</th><th scope="col">Estado</th><th scope="col" class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      {{#each linhas}}
      <tr>
        <td class="fw-semibold">{{codigo}}</td>
        <td class="text-nowrap">{{formatDate data_emissao}}</td>
        {{#if ../temVariasFracoes}}<td>{{fracaoDesignacao}}</td>{{/if}}
        <td class="small">{{periodos}}{{#if temExtras}} <span class="badge text-bg-light border">Extra</span>{{/if}}</td>
        <td>{{eur valor}}</td>
        <td>{{#if (eq estado 'anulado')}}<span class="badge text-bg-secondary">Anulado</span>{{else}}<span class="badge text-bg-success">Emitido</span>{{/if}}</td>
        <td class="text-end text-nowrap">
          <a href="/condomino/recibos/{{id}}/pdf" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary" title="Ver recibo (PDF)" aria-label="Ver recibo {{codigo}} (PDF)">
            <span class="material-symbols-outlined" aria-hidden="true">picture_as_pdf</span>
          </a>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div></div>

{{else}}
<div class="card"><div class="card-body text-center text-muted py-4">
  <span class="material-symbols-outlined" aria-hidden="true" style="font-size:2rem">receipt_long</span>
  <div class="fw-semibold mt-1">Ainda não tem recibos emitidos</div>
  <div class="small">Quando o condomínio emitir um recibo para a sua fração, ele aparece aqui.</div>
</div></div>
{{/if}}
{{/if}}
