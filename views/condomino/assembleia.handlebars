<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>{{#if assembleia.numero}}Assembleia {{assembleia.numero}}{{else}}Assembleia{{/if}}</h1>
    <p class="subtitle">
      {{formatDate assembleia.data}}{{#if assembleia.hora}} · {{assembleia.hora}}{{/if}}{{#if assembleia.local}} · {{assembleia.local}}{{/if}}
    </p>
  </div>
  <a href="/condomino/assembleias" class="btn btn-outline-secondary btn-sm">Voltar</a>
</div>

{{#if agenda}}
<h2 class="h6 mt-3 mb-2">Ordem de trabalhos</h2>
<div class="card mb-3">
  <ol class="list-group list-group-numbered">
    {{#each agenda}}
    <li class="list-group-item">{{descricao}}{{#if sujeito_votacao}} <span class="badge text-bg-light border">sujeito a votação</span>{{/if}}</li>
    {{/each}}
  </ol>
</div>
{{/if}}

<h2 class="h6 mt-3 mb-2">Documentos disponíveis</h2>
<div class="card"><div class="list-group list-group-flush">
  {{#if convocatoriaDisponivel}}
  <a class="list-group-item d-flex justify-content-between align-items-center" href="{{assembleia.convocatoria.url}}" target="_blank" rel="noopener">
    Convocatória <span class="material-symbols-outlined">picture_as_pdf</span>
  </a>
  {{/if}}
  {{#if ataDisponivel}}
  <a class="list-group-item d-flex justify-content-between align-items-center" href="{{assembleia.ata.url}}" target="_blank" rel="noopener">
    Ata <span class="material-symbols-outlined">picture_as_pdf</span>
  </a>
  {{/if}}
  {{#each anexos}}
  <a class="list-group-item d-flex justify-content-between align-items-center" href="{{url}}" target="_blank" rel="noopener">{{nome}}</a>
  {{else}}
  {{#unless convocatoriaDisponivel}}{{#unless ataDisponivel}}
  <div class="list-group-item text-muted small">Sem documentos disponibilizados para esta assembleia.</div>
  {{/unless}}{{/unless}}
  {{/each}}
</div></div>
