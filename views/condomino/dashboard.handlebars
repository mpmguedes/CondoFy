{{!-- Início da área do condómino (mobile-first).

     Sequência pensada para telemóvel, respondendo por esta ordem a
     «qual é a situação da minha fração e há alguma coisa que eu precise de
     consultar ou tratar?»:
        identidade → a minha situação → acesso rápido → atividade recente
        → próximos eventos → situação do condomínio

     Todas as informações vêm de dados que já existem (quotas, pagamentos,
     recibos, avisos, documentos e assembleias do condomínio ativo). Nada é
     apresentado quando não existe: cada bloco tem a sua mensagem neutra.
     Com várias frações, cada cartão mostra exclusivamente a sua própria
     informação (a próxima quota é consultada por fração em routes/condomino.js). --}}
<div class="page-heading portal-cabecalho">
  <h1>Olá, {{user.nome}}</h1>
  <p class="subtitle">
    {{condominio.designacao}}{{#if fracoesComResumo.length}} · {{#each fracoesComResumo}}{{designacao}}{{#unless @last}}, {{/unless}}{{/each}}{{#if fracoesComResumo.0.permilagem}} · {{fracoesComResumo.0.permilagem}}‰{{/if}}{{/if}}
  </p>
</div>

{{#unless pessoa}}
<div class="alert alert-warning">
  <i class="bi bi-info-circle me-1"></i>
  A sua conta ainda não está associada a um condómino neste condomínio. Contacte a administração.
</div>
{{else}}

<div class="portal-conteudo">
<div class="row g-3 portal-inicio">
  <div class="col-12 col-lg-7">

    {{!-- ── A minha situação (bloco de maior destaque do Início) ───── --}}
    {{#if fracoesComResumo}}
    {{#each fracoesComResumo}}
    <div class="card portal-hero mb-3 {{#if (gt resumo.emDivida 0)}}portal-hero-divida{{else}}portal-hero-ok{{/if}}">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
          <div>
            <div class="stat-label">Fração {{designacao}}</div>
            {{#if vinculo}}<div class="portal-hero-vinculo">{{vinculo}}</div>{{/if}}
          </div>
          {{#if (gt resumo.emDivida 0)}}
          <span class="badge text-bg-danger">Quota em atraso</span>
          {{else}}
          <span class="badge text-bg-success">Tudo pago</span>
          {{/if}}
        </div>

        <div class="portal-hero-valor {{#if (gt resumo.emDivida 0)}}text-danger{{else}}text-success{{/if}}">
          {{eur resumo.emDivida}}
        </div>
        <div class="stat-label">{{#if (gt resumo.emDivida 0)}}Valores por regularizar{{else}}Nada a pagar{{/if}}</div>

        <div class="portal-linhas portal-hero-linhas">
          {{!-- Com dívida, o que importa é regularizar: o detalhe está na área das
               quotas (histórico, recibos e pagamentos registados). Sem dívida,
               mostra-se o próximo vencimento desta fração, quando existe. Se não
               houver quota por vencer, diz-se — sem inventar uma próxima quota. --}}
          {{#if proximaQuota}}
          <div class="portal-linha">
            <span class="material-symbols-outlined" aria-hidden="true">event_upcoming</span>
            <span class="portal-linha-texto">
              Próxima quota: <strong>{{eur proximaQuota.valor}}</strong> até {{formatDate proximaQuota.data_vencimento}}
            </span>
          </div>
          {{else}}
          {{#unless (gt resumo.emDivida 0)}}
          <div class="portal-linha">
            <span class="material-symbols-outlined" aria-hidden="true">event_available</span>
            <span class="portal-linha-texto">Sem quotas por vencer registadas</span>
          </div>
          {{/unless}}
          {{/if}}
          <div class="portal-linha">
            <span class="material-symbols-outlined" aria-hidden="true">payments</span>
            <span class="portal-linha-texto">
              {{#if resumo.ultimoPagamento}}
              Último pagamento: <strong>{{eur resumo.ultimoPagamento.valor}}</strong> em {{formatDate resumo.ultimoPagamento.data}}
              {{else}}
              Ainda sem pagamentos registados
              {{/if}}
            </span>
          </div>
          <div class="portal-linha">
            <span class="material-symbols-outlined" aria-hidden="true">checklist</span>
            <span class="portal-linha-texto">{{resumo.quotasPagas}} quota(s) paga(s) · {{resumo.quotasPendentes}} pendente(s)</span>
          </div>
          {{#if extrasPendentes}}
          <div class="portal-linha">
            <span class="material-symbols-outlined" aria-hidden="true">savings</span>
            <span class="portal-linha-texto">
              Extraordinárias por pagar:
              {{#each extrasPendentes}}<strong>{{eur valor}}</strong> ({{designacao}}, parcela {{parcela}}){{#unless @last}} · {{/unless}}{{/each}}
            </span>
          </div>
          {{/if}}
        </div>

        <div class="portal-hero-acoes">
          <a class="btn btn-primary portal-btn" href="/condomino/quotas">
            <span class="material-symbols-outlined" aria-hidden="true">receipt_long</span>
            {{#if (gt resumo.emDivida 0)}}Consultar quotas{{else}}Ver quotas{{/if}}
          </a>
        </div>
      </div>
    </div>
    {{/each}}
    {{else}}
    <div class="alert alert-info">Não tem frações associadas neste condomínio.</div>
    {{/if}}

    {{!-- ── Acesso rápido (as seis áreas reais, a um toque) ─────────── --}}
    <h2 class="h6 text-uppercase portal-titulo-seccao">Acesso rápido</h2>
    <div class="portal-atalhos mb-4">
      <a class="quick-action portal-atalho" href="/condomino/quotas"><span class="material-symbols-outlined" aria-hidden="true">receipt_long</span>Quotas<span class="portal-atalho-meta">{{#if (gt fracoesComResumo.0.resumo.emDivida 0)}}Em dívida{{else}}Em dia{{/if}}</span></a>
      <a class="quick-action portal-atalho" href="/condomino/recibos"><span class="material-symbols-outlined" aria-hidden="true">confirmation_number</span>Recibos<span class="portal-atalho-meta">{{#if fracoesComResumo.0.resumo.ultimoPagamento}}Último pagamento{{else}}Sem recibos{{/if}}</span></a>
      <a class="quick-action portal-atalho" href="/condomino/documentos"><span class="material-symbols-outlined" aria-hidden="true">folder</span>Documentos<span class="portal-atalho-meta">Do condomínio</span></a>
      <a class="quick-action portal-atalho" href="/condomino/avisos"><span class="material-symbols-outlined" aria-hidden="true">campaign</span>Avisos<span class="portal-atalho-meta">{{#if avisosRecentes}}{{avisosRecentes}} recente(s){{else}}Sem novidades{{/if}}</span></a>
      <a class="quick-action portal-atalho" href="/condomino/assembleias"><span class="material-symbols-outlined" aria-hidden="true">forum</span>Assembleias<span class="portal-atalho-meta">Convocatórias e atas</span></a>
      <a class="quick-action portal-atalho" href="/condomino/situacao-financeira"><span class="material-symbols-outlined" aria-hidden="true">monitoring</span>Situação<span class="portal-atalho-meta">Financeira</span></a>
    </div>
  </div>

  <div class="col-12 col-lg-5">
    {{!-- ── Atividade recente ──────────────────────────────────────── --}}
    <div class="card mb-3">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="stat-label">Atividade recente</span>
        <a class="small" href="/condomino/avisos">Ver avisos</a>
      </div>
      {{#if atividadeRecente.length}}
      <ul class="list-group list-group-flush">
        {{#each atividadeRecente}}
        <li class="list-group-item">
          {{#if this.documento}}
          {{!-- Documentos: o ficheiro é sempre servido pelo GesCondu (rota
               interna verificada em cada pedido). --}}
          {{#if (urlDocumento this.documento 'condomino')}}
          <a class="portal-item" href="{{urlDocumento this.documento 'condomino'}}">{{> _portal-item this}}</a>
          {{else}}
          <span class="portal-item">{{> _portal-item this}}</span>
          {{/if}}
          {{else if this.link}}
          <a class="portal-item" href="{{this.link}}">{{> _portal-item this}}</a>
          {{else}}
          <span class="portal-item">{{> _portal-item this}}</span>
          {{/if}}
        </li>
        {{/each}}
      </ul>
      {{else}}
      <div class="card-body text-muted small">Ainda sem atividade recente neste condomínio.</div>
      {{/if}}
    </div>

    {{!-- ── Próximos eventos ───────────────────────────────────────── --}}
    <div class="card mb-3">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="stat-label">Próximos eventos</span>
        <a class="small" href="/condomino/calendario">Calendário</a>
      </div>
      {{#if proximosEventos.length}}
      <ul class="list-group list-group-flush">
        {{#each proximosEventos}}
        <li class="list-group-item">
          <a class="portal-item" href="{{link}}">{{> _portal-item this}}</a>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <div class="card-body text-muted small">Sem eventos agendados neste condomínio.</div>
      {{/if}}
    </div>
  </div>
</div>

{{!-- ── Situação do condomínio (resumo; detalhe na área Condomínio) ─── --}}
<div class="mt-4">
<h2 class="h6 text-uppercase portal-titulo-seccao">O condomínio em resumo</h2>
<div class="card portal-transparencia">
  <div class="card-body">
    <div class="row g-3 align-items-center">
      <div class="col-6 col-md-3">
        <div class="stat-label">Saldo das contas</div>
        <div class="stat-value">{{eur resumo.saldoContas}}</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-label">Fundo de reserva</div>
        <div class="stat-value">{{eur resumo.fundoReserva}}</div>
      </div>
      <div class="col-12 col-md-6">
        <div class="d-flex justify-content-between align-items-center">
          <span class="stat-label">Execução do orçamento {{orcamento.ano}}</span>
          <span class="fw-semibold">{{orcamento.percentagem}}%</span>
        </div>
        <div class="progress mt-1" style="height:10px">
          <div class="progress-bar {{#if (gt orcamento.percentagem 100)}}bg-danger{{else}}bg-primary{{/if}}" style="width: {{orcamento.percentagem}}%"></div>
        </div>
        <div class="text-muted small mt-1">{{eur orcamento.executado}} de {{eur orcamento.orcamentado}}</div>
      </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3">
      <a class="btn btn-outline-secondary btn-sm portal-btn" href="/condomino/situacao-financeira">Situação financeira</a>
      <a class="btn btn-outline-secondary btn-sm portal-btn" href="/condomino/orcamento">Orçamento</a>
    </div>
  </div>
</div>
</div>

{{#unless fracoesComResumo.length}}
{{#if titularidadesTerminadas.length}}
{{!-- Deixou de ser titular (ex.: venda da fração): explica-se o que aconteceu,
     permite-se descarregar a informação e oferece-se a saída. O acesso ao
     condomínio não se mantém sem razão. --}}
<div class="card mt-3">
  <div class="card-body">
    <div class="fw-semibold">Deixou de ser titular das frações que tinha neste condomínio.</div>
    <div class="text-muted small mb-3">
      O histórico destas relações mantém-se registado no condomínio; a sua conta GesCondu continua ativa
      e os restantes condomínios não são afetados. Se já não tem qualquer relação com este condomínio,
      pode encerrar aqui o seu acesso.
    </div>
    <ul class="list-group list-group-flush mb-3">
      {{#each titularidadesTerminadas}}
      <li class="list-group-item d-flex justify-content-between px-0">
        <span>Fração {{fracao}} <span class="badge text-bg-light border ms-1">{{vinculo}}</span></span>
        <span class="text-muted small">{{#if data_fim}}até {{formatDate data_fim}}{{else}}relação encerrada{{/if}}</span>
      </li>
      {{/each}}
    </ul>
    <form action="/condomino/saida/exportar" method="POST" class="row g-2 align-items-end border-top pt-3 mb-3">
      <div class="col-12">
        <label class="form-label" for="password_exportar_dash">Descarregar a minha informação</label>
        <div class="text-muted small">
          Inclui o histórico das relações que teve com este condomínio (com datas) e os documentos pessoais que
          o condomínio guarda sobre si. Não inclui dados de outros condóminos nem documentos internos da administração.
        </div>
      </div>
      <div class="col-12 col-md-5">
        <input type="password" class="form-control" id="password_exportar_dash" name="password" required autocomplete="current-password" placeholder="Palavra-passe" />
      </div>
      <div class="col-12 col-md-auto">
        <button class="btn btn-outline-primary">
          <span class="material-symbols-outlined me-1" aria-hidden="true">download</span>Descarregar
        </button>
      </div>
    </form>
    <a href="/condomino/saida" class="btn btn-outline-secondary">
      <span class="material-symbols-outlined me-1" aria-hidden="true">logout</span>Preparar saída do condomínio
    </a>
  </div>
</div>
{{/if}}
{{/unless}}
</div>
{{/unless}}
