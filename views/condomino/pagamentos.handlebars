<div class="page-heading">
  <h1>Os meus pagamentos</h1>
  <p class="subtitle">Histórico dos pagamentos da sua fração</p>
</div>

{{#unless pessoa}}
<div class="alert alert-warning">A sua conta ainda não está associada a um condómino neste condomínio.</div>
{{else}}
{{#if linhas}}
<div class="card"><div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light">
      <tr><th>Data</th><th>Fração</th><th>Valor</th><th>Período(s)</th><th>Método</th><th>Referência</th></tr>
    </thead>
    <tbody>
      {{#each linhas}}
      <tr>
        <td class="text-nowrap">{{formatDate data_pagamento}}</td>
        <td>{{fracaoDesignacao}}</td>
        <td>{{eur valor}}</td>
        <td class="small">{{periodos}}</td>
        <td>{{#if metodoNome}}{{metodoNome}}{{else}}—{{/if}}</td>
        <td class="small">{{#if referencia}}{{referencia}}{{else}}—{{/if}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div></div>
{{else}}
<div class="alert alert-light border small">Sem pagamentos registados para a sua fração.</div>
{{/if}}
{{/unless}}
