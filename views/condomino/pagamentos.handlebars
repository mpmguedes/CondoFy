{{> _condomino-quotas-tabs ativo='pagamentos'}}
<div class="page-heading">
  <h1>Os meus pagamentos</h1>
  <p class="subtitle">Histórico dos pagamentos da sua fração</p>
</div>

{{#if acesso}}
{{> _portal-estado-associacao}}
{{else}}
{{#if linhas}}
{{#if listaTruncada}}{{> _portal-lista-limitada}}{{/if}}
<div class="card"><div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <caption class="visually-hidden">Pagamentos registados para a sua fração: data, fração, valor, período, método, referência e comprovativo</caption>
    <thead class="table-light">
      <tr><th scope="col">Data</th><th scope="col">Fração</th><th scope="col">Valor</th><th scope="col">Período(s)</th><th scope="col">Método</th><th scope="col">Referência</th><th scope="col">Comprovativo</th></tr>
    </thead>
    <tbody>
      {{#each linhas}}
      <tr>
        <td class="text-nowrap">{{formatDate data_pagamento}}</td>
        <td>{{fracaoDesignacao}}</td>
        <td>{{eur valor}}</td>
        <td class="small">{{periodos}}</td>
        <td>{{#if metodoNome}}{{metodoNome}}{{else}}—{{/if}}</td>
        <td class="small">{{#if referencia}}{{referencia}}{{else}}—{{/if}}</td>
        {{!-- Comprovativo (P31/C1): o condómino é quem submete o comprovativo,
             por isso tem de o poder voltar a ver. A rota revalida o condomínio
             ativo e a fração em cada pedido. --}}
        <td class="text-nowrap">
          {{#if comprovativo_ficheiro}}
          <a href="/condomino/pagamentos/{{id}}/comprovativo" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary" title="Ver comprovativo" aria-label="Ver comprovativo do pagamento de {{formatDate data_pagamento}}">
            <span class="material-symbols-outlined" aria-hidden="true">description</span>
          </a>
          {{else}}<span class="text-muted">—</span>{{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div></div>
{{else}}
{{> _empty-state icon="payments" titulo="Sem pagamentos registados" descricao="Ainda não há pagamentos registados para a sua fração. Aparecem aqui assim que a administração os registar."}}
{{/if}}
{{/if}}
