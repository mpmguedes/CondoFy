{{> _condomino-quotas-tabs ativo='quotas'}}
<div class="page-heading">
  <h1>As minhas quotas</h1>
  <p class="subtitle">Consulta das quotas da sua fração — não pode ser alterada aqui</p>
</div>

{{#if acesso}}
{{> _portal-estado-associacao}}
{{else}}

{{!-- ── Resumo por fração ──────────────────────────────────────────────
     Um bloco por fração (nunca um agregado): estado, próximo vencimento e o
     resumo do ano em curso, tudo calculado sobre as quotas já carregadas.
     Com várias frações, cada bloco mostra apenas a sua própria informação. --}}
{{#if listaTruncada}}{{> _portal-lista-limitada}}{{/if}}
{{#if resumoAno.length}}
<h2 class="h6 text-uppercase portal-titulo-seccao">A minha situação</h2>
<div class="portal-inicio">
  {{#each resumoAno}}
  <div class="card portal-hero mb-3 {{#if vencidas}}portal-hero-divida{{else}}portal-hero-ok{{/if}}">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div class="stat-label">Fração {{designacao}}</div>
        {{!-- Estado do ano segundo os valores reais: em atraso > por regularizar >
             tudo pago. «Tudo pago» só quando nada está por pagar no ano em causa
             (uma quota futura por vencer ainda não é «tudo pago»). --}}
        {{#if vencidas}}
        <span class="badge text-bg-danger">{{vencidas}} quota(s) em atraso</span>
        {{else if pendentes}}
        <span class="badge text-bg-warning">Valores por regularizar</span>
        {{else if parciais}}
        <span class="badge text-bg-info">Pagamento parcial</span>
        {{else}}
        <span class="badge text-bg-success">Tudo pago</span>
        {{/if}}
      </div>

      {{#if pendentes}}
      <div class="portal-hero-valor text-danger">{{eur pago}}</div>
      {{else}}
      <div class="portal-hero-valor text-success">{{eur pago}}</div>
      {{/if}}
      <div class="stat-label">Total pago no ano</div>

      <div class="portal-linhas portal-hero-linhas">
        <div class="portal-linha">
          <span class="material-symbols-outlined" aria-hidden="true">event_upcoming</span>
          <span class="portal-linha-texto">
            {{#if proximaQuota}}
            Próxima quota: <strong>{{eur proximaQuota.valor}}</strong> até {{formatDate proximaQuota.data_vencimento}}
            {{else}}
            Sem quotas por vencer registadas
            {{/if}}
          </span>
        </div>
        <div class="portal-linha">
          <span class="material-symbols-outlined" aria-hidden="true">checklist</span>
          <span class="portal-linha-texto">
            {{pagas}} paga(s){{#if parciais}} · {{parciais}} parcialmente paga(s){{/if}} · {{pendentes}} pendente(s){{#if vencidas}} · {{vencidas}} em atraso{{/if}}
          </span>
        </div>
        {{#if total}}
        <div class="portal-linha">
          <span class="material-symbols-outlined" aria-hidden="true">request_quote</span>
          <span class="portal-linha-texto">{{eur pago}} de {{eur total}} no ano{{#if anuladas}} · {{anuladas}} anulada(s){{/if}}</span>
        </div>
        {{/if}}
      </div>

      <div class="portal-hero-acoes">
        <a class="btn btn-primary portal-btn" href="/condomino/quotas{{#if ../filtros.ano}}?ano={{../filtros.ano}}{{/if}}">
          <span class="material-symbols-outlined" aria-hidden="true">receipt_long</span>Ver quotas
        </a>
      </div>
    </div>
  </div>
  {{/each}}
</div>
{{else}}
<div class="alert alert-info">Ainda não existem quotas registadas para a sua fração.</div>
{{/if}}

{{!-- ── Filtros e resumo do ano ───────────────────────────────────────── --}}
<form method="GET" class="card mb-3"><div class="card-body row g-2 align-items-end">
  <div class="col-6 col-md-3"><label class="form-label" for="filtroAno">Ano</label>
    <select class="form-select" id="filtroAno" name="ano"><option value="">Todos</option>{{#each anos}}<option value="{{this}}" {{#if (eq ../filtros.ano this)}}selected{{/if}}>{{this}}</option>{{/each}}</select>
  </div>
  <div class="col-6 col-md-3"><label class="form-label" for="filtroEstado">Estado</label>
    <select class="form-select" id="filtroEstado" name="estado">
      <option value="">Todos</option>
      <option value="pendente" {{#if (eq filtros.estado 'pendente')}}selected{{/if}}>Pendente</option>
      <option value="vencida" {{#if (eq filtros.estado 'vencida')}}selected{{/if}}>Vencida</option>
      <option value="paga" {{#if (eq filtros.estado 'paga')}}selected{{/if}}>Paga</option>
    </select>
  </div>
  <div class="col-12 col-md-2 d-grid"><button class="btn btn-primary portal-btn">Filtrar</button></div>
</div></form>

{{!-- ── Quotas ───────────────────────────────────────────────────────── --}}
<h2 class="h6 text-uppercase portal-titulo-seccao">Quotas{{#if filtros.ano}} de {{filtros.ano}}{{/if}}</h2>

{{#if linhas}}
{{!-- Telemóvel: uma quota por bloco (sem scroll horizontal). --}}
<ul class="portal-quota-lista">
  {{#each linhas}}
  <li class="portal-quota {{#if (eq ano ../currentYear)}}{{#if (eq mes ../currentMonth)}}portal-quota-atual{{/if}}{{/if}}">
    <div class="portal-quota-topo">
      <span class="portal-quota-periodo">{{mesNome}} {{ano}}{{#if ../temVariasFracoes}} · {{fracaoDesignacao}}{{/if}}</span>
      {{#if (eq estadoApresentado 'paga')}}<span class="badge text-bg-success">Paga</span>
      {{else if (eq estadoApresentado 'parcialmente_paga')}}<span class="badge text-bg-info">Parcialmente paga</span>
      {{else if (eq estadoApresentado 'vencida')}}<span class="badge text-bg-danger">Vencida</span>
      {{else if (eq estadoApresentado 'anulada')}}<span class="badge text-bg-secondary">Anulada</span>
      {{else}}<span class="badge text-bg-warning">Pendente</span>{{/if}}
    </div>
    <div class="portal-quota-valor">{{eur valor}}</div>
    <div class="portal-quota-meta">
      <span>Vence {{formatDate data_vencimento}}</span>
      {{#if pago}}<span>Pago {{eur pago}}{{#if dataPagamento}} em {{formatDate dataPagamento}}{{/if}}</span>{{/if}}
      {{#if referencia}}<span>Ref. {{referencia}}</span>{{/if}}
      {{#if (eq ano ../currentYear)}}{{#if (eq mes ../currentMonth)}}<span class="portal-quota-selo">Mês atual</span>{{/if}}{{/if}}
    </div>
  </li>
  {{/each}}
</ul>

{{!-- Desktop: a tabela detalhada, com a mesma informação. --}}
<div class="card portal-quota-tabela"><div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light">
      <tr><th>Fração</th><th>Período</th><th>Valor</th><th>Vencimento</th><th>Estado</th><th>Pago</th><th>Data de pagamento</th><th>Referência</th></tr>
    </thead>
    <tbody>
      {{#each linhas}}
      <tr class="{{#if (eq ano ../currentYear)}}{{#if (eq mes ../currentMonth)}}portal-quota-atual{{/if}}{{/if}}">
        <td>{{fracaoDesignacao}}</td>
        <td>{{mesNome}} {{ano}}{{#if (eq ano ../currentYear)}}{{#if (eq mes ../currentMonth)}} <span class="portal-quota-selo">Mês atual</span>{{/if}}{{/if}}</td>
        <td>{{eur valor}}</td>
        <td class="text-nowrap">{{formatDate data_vencimento}}</td>
        <td>
          {{#if (eq estadoApresentado 'paga')}}<span class="badge text-bg-success">Paga</span>
          {{else if (eq estadoApresentado 'parcialmente_paga')}}<span class="badge text-bg-info">Parcialmente paga</span>
          {{else if (eq estadoApresentado 'vencida')}}<span class="badge text-bg-danger">Vencida</span>
          {{else if (eq estadoApresentado 'anulada')}}<span class="badge text-bg-secondary">Anulada</span>
          {{else}}<span class="badge text-bg-warning">Pendente</span>{{/if}}
        </td>
        <td>{{#if pago}}{{eur pago}}{{else}}—{{/if}}</td>
        <td class="text-nowrap">{{#if dataPagamento}}{{formatDate dataPagamento}}{{else}}—{{/if}}</td>
        <td class="small">{{#if referencia}}{{referencia}}{{else}}—{{/if}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div></div>
{{else}}
<div class="alert alert-light border small">Sem quotas com estes filtros.</div>
{{/if}}

{{!-- ── Quotas extraordinárias (separadas das quotas normais) ────────── --}}
{{#if extras}}
<h2 class="h5 mt-4 mb-2">Quotas extraordinárias</h2>

{{!-- Telemóvel: um bloco por parcela. --}}
<ul class="portal-quota-lista">
  {{#each extras}}
  <li class="portal-quota">
    <div class="portal-quota-topo">
      <span class="portal-quota-periodo">{{designacao}}{{#if fracaoDesignacao}} · {{fracaoDesignacao}}{{/if}}</span>
      {{#if (eq estado 'paga')}}<span class="badge text-bg-success">Paga</span>
      {{else if (eq estado 'anulada')}}<span class="badge text-bg-dark">Anulada</span>
      {{else if (eq estado 'cobrada')}}<span class="badge text-bg-info">Em cobrança</span>
      {{else if (eq extraEstado 'pendente')}}<span class="badge text-bg-warning">Pendente de aprovação</span>
      {{else if (eq extraEstado 'aprovada')}}<span class="badge text-bg-secondary">Aprovada (aguarda cobrança)</span>
      {{else}}<span class="badge text-bg-warning">Pendente</span>{{/if}}
    </div>
    <div class="portal-quota-valor">{{eur valor}}</div>
    <div class="portal-quota-meta">
      <span>Parcela {{parcela_numero}}</span>
      <span>Vence {{formatDate vencimento}}</span>
      {{#if valorPago}}<span>Pago {{eur valorPago}}</span>{{/if}}
    </div>
  </li>
  {{/each}}
</ul>

<div class="card portal-quota-tabela"><div class="table-responsive">
  <table class="table table-sm align-middle mb-0">
    <thead class="table-light"><tr><th>Designação</th><th>Fração</th><th>Parcela</th><th>Valor</th><th>Vencimento</th><th>Estado</th><th>Pago</th></tr></thead>
    <tbody>
      {{#each extras}}
      <tr>
        <td>{{designacao}}</td><td>{{fracaoDesignacao}}</td><td>{{parcela_numero}}</td>
        <td>{{eur valor}}</td><td class="text-nowrap">{{formatDate vencimento}}</td>
        <td>{{#if (eq estado 'paga')}}<span class="badge text-bg-success">Paga</span>
        {{else if (eq estado 'anulada')}}<span class="badge text-bg-dark">Anulada</span>
        {{else if (eq estado 'cobrada')}}<span class="badge text-bg-info">Em cobrança</span>
        {{else if (eq extraEstado 'pendente')}}<span class="badge text-bg-warning">Pendente de aprovação</span>
        {{else if (eq extraEstado 'aprovada')}}<span class="badge text-bg-secondary">Aprovada (aguarda cobrança)</span>
        {{else}}<span class="badge text-bg-warning">Pendente</span>{{/if}}</td>
        <td>{{#if valorPago}}{{eur valorPago}}{{else}}—{{/if}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div></div>
{{/if}}
{{/if}}
