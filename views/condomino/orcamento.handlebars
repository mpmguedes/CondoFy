<div class="page-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h1>Orçamento {{ano}}</h1>
    <p class="subtitle">Acompanhamento da execução orçamental do condomínio</p>
  </div>
  {{!-- Seletor de ano (P31/C5): a página já aceitava `?ano=`, mas a única
       navegação era o botão «Ano atual». Com a lista de anos com orçamento
       publicado — mais o ano em curso — o condómino pode recuar no histórico
       sem editar o endereço. Formulário GET simples: funciona sem JavaScript e
       o botão submete sempre (não depende de `onchange`). --}}
  <form method="GET" class="d-flex gap-2 align-items-end">
    <div>
      <label class="form-label mb-1 small text-muted" for="filtroAnoOrcamento">Ano</label>
      <select class="form-select form-select-sm" id="filtroAnoOrcamento" name="ano">
        {{#each anos}}<option value="{{this}}" {{#if (eq this ../ano)}}selected{{/if}}>{{this}}</option>{{/each}}
      </select>
    </div>
    <button class="btn btn-sm btn-outline-secondary portal-btn">Ver</button>
  </form>
</div>

{{#if acesso}}
{{> _portal-estado-associacao}}
{{else}}
{{#if orcamento}}
<div class="row g-3 mb-3">
  <div class="col-6 col-md-3"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">Total previsto</div><div class="stat-value">{{eur totais.orcamentado}}</div></div></div></div>
  <div class="col-6 col-md-3"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">Total realizado</div><div class="stat-value">{{eur totais.executado}}</div></div></div></div>
  <div class="col-6 col-md-3"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">Saldo</div><div class="stat-value {{#if (lt totais.saldo 0)}}text-danger{{else}}text-success{{/if}}">{{eur totais.saldo}}</div></div></div></div>
  <div class="col-6 col-md-3"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">Execução</div><div class="stat-value">{{#if totais.orcamentado}}{{totais.percentagem}}%{{else}}—{{/if}}</div></div></div></div>
</div>

{{#unless totais.orcamentado}}
<div class="alert alert-light border small mb-3">O orçamento de {{ano}} está publicado mas ainda não tem rubricas com valor previsto. Os totais aparecem quando a administração preencher o orçamento.</div>
{{/unless}}

<div class="card"><div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <caption class="visually-hidden">Execução do orçamento de {{ano}} por categoria: valor orçamentado, valor realizado e percentagem de execução</caption>
    <thead class="table-light"><tr><th scope="col">Categoria</th><th scope="col" class="text-end">Orçamentado</th><th scope="col" class="text-end">Realizado</th><th scope="col" style="width:180px">Execução</th></tr></thead>
    <tbody>
      {{#each linhas}}
      <tr>
        <td>{{nome}}</td>
        <td class="text-end">{{eur orcamentado}}</td>
        <td class="text-end">{{eur executado}}</td>
        <td>
          <div class="progress" style="height:8px"><div class="progress-bar {{#if (gt percentagem 100)}}bg-danger{{else}}bg-primary{{/if}}" style="width:{{percentagem}}%"></div></div>
          <span class="small text-muted">{{percentagem}}%</span>
        </td>
      </tr>
      {{else}}
      <tr><td colspan="4" class="text-center text-muted py-4">Sem rubricas no orçamento deste ano.</td></tr>
      {{/each}}
    </tbody>
  </table>
</div></div>
{{else}}
<div class="alert alert-light border small">Não existe orçamento publicado para o ano {{ano}}.</div>
{{/if}}
{{/if}}
