<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{#if titulo}}{{titulo}} · {{/if}}GesCondu</title>
  <script>
    // Tema (claro/escuro) antes do CSS: evita flash de tema errado.
    (function () {
      try {
        var t = localStorage.getItem('gescondu-tema');
        if (t !== 'claro' && t !== 'escuro') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'escuro' : 'claro';
        }
        document.documentElement.setAttribute('data-theme', t === 'escuro' ? 'dark' : 'light');
      } catch (e) {}
    })();
  </script>
  <link rel="icon" type="image/png" href="/img/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0" rel="stylesheet" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/css/styles.css?v=20260212a" rel="stylesheet" />
  <style>
    /* Casca auth (página independente): fundo e flash. A composição
       (logo/slogan/cartão/rodapé) vive nas classes .auth-* do styles.css. */
    body.blank-page {
      background: var(--auth-bg);
      background-attachment: fixed;
      color: var(--nav-text);
      margin: 0;
    }
    .blank-flash { width: 100%; max-width: 640px; margin: 0 auto; padding: 1rem 1rem 0; }
  </style>
</head>
<body class="blank-page">
  <div class="blank-flash">
    {{> _flash}}
  </div>
  {{{body}}}

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/tema.js?v=20260209a" defer></script>
</body>
</html>
