<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{#if titulo}}{{titulo}} · {{/if}}{{condominio.designacao}}</title>
  <link rel="icon" type="image/png" href="/img/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
  {{#if user}}
  <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
    <div class="container-fluid">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="/img/logo.png" alt="Condofy" class="brand-logo" />
        <span class="brand-text">{{condominio.designacao}}</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain" aria-controls="navMain" aria-expanded="false" aria-label="Alternar navegação">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMain">
        <ul class="navbar-nav me-auto">
          {{#if isAdmin}}
          <li class="nav-item"><a class="nav-link" href="/admin"><i class="bi bi-speedometer2 me-1"></i>Painel</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/fracoes"><i class="bi bi-building me-1"></i>Frações</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/condominos"><i class="bi bi-people me-1"></i>Condóminos</a></li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="ddFinanceiro" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-wallet2 me-1"></i>Financeiro</a>
            <ul class="dropdown-menu" aria-labelledby="ddFinanceiro">
              <li><a class="dropdown-item" href="/admin/quotas"><i class="bi bi-receipt me-2"></i>Quotas</a></li>
              <li><a class="dropdown-item" href="/admin/pagamentos"><i class="bi bi-cash-coin me-2"></i>Pagamentos</a></li>
              <li><a class="dropdown-item" href="/admin/despesas"><i class="bi bi-credit-card me-2"></i>Despesas</a></li>
              <li><a class="dropdown-item" href="/admin/contas"><i class="bi bi-bank me-2"></i>Contas bancárias</a></li>
              <li><a class="dropdown-item" href="/admin/orcamento"><i class="bi bi-graph-up me-2"></i>Orçamento</a></li>
              <li><hr class="dropdown-divider" /></li>
              <li><a class="dropdown-item" href="/admin/categorias"><i class="bi bi-tags me-2"></i>Categorias</a></li>
            </ul>
          </li>
          <li class="nav-item"><a class="nav-link" href="/admin/assembleias"><i class="bi bi-people-fill me-1"></i>Assembleias</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/avisos"><i class="bi bi-megaphone me-1"></i>Avisos</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/documentos"><i class="bi bi-folder2-open me-1"></i>Documentos</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/utilizadores"><i class="bi bi-person-gear me-1"></i>Utilizadores</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/auditoria"><i class="bi bi-shield-lock me-1"></i>Auditoria</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/config"><i class="bi bi-gear me-1"></i>Configuração</a></li>
          {{else}}
          <li class="nav-item"><a class="nav-link" href="/condomino"><i class="bi bi-house me-1"></i>A minha área</a></li>
          {{/if}}
        </ul>
        <div class="d-flex align-items-center gap-2 text-light">
          <span class="small text-white-50">{{user.nome}}</span>
          <a class="btn btn-outline-light btn-sm" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Sair</a>
        </div>
      </div>
    </div>
  </nav>
  {{/if}}

  <main class="app-main">
    <div class="container-fluid px-3 px-md-4">
      {{#if success_msg}}
        {{#each success_msg}}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <i class="bi bi-check-circle me-1"></i>{{this}}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
        {{/each}}
      {{/if}}
      {{#if error_msg}}
        {{#each error_msg}}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="bi bi-exclamation-triangle me-1"></i>{{this}}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
        {{/each}}
      {{/if}}
      {{#if error}}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="bi bi-exclamation-triangle me-1"></i>{{error}}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
      {{/if}}

      {{{body}}}
    </div>
  </main>

  <footer class="app-footer text-center py-3">
    <span class="text-muted small">Condofy · Gestão de condomínios · {{currentYear}}</span>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js" defer></script>
</body>
</html>
