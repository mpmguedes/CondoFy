{{!-- Verificação em duas etapas (segundo fator do login).

     Faz parte do MESMO sistema de autenticação da entrada: usa a composição
     .auth-page / .auth-stage / .auth-message / .auth-panel definida em
     public/css/styles.css (bloco «casca de entrada e 2FA») e a classe
     `auth-shell` que o layout sem sessão coloca no <main>. Sem sidebar, sem
     barra inferior, sem seletor de condomínio e sem qualquer identidade
     autenticada: nesta fase ainda não há sessão (ver routes/auth.js). --}}
<div class="auth-page">
  <div class="auth-stage">
    <section class="auth-message">
      <a class="auth-logo" href="/" title="GesCondu">
        <img src="/img/gescondu-logo-ativo.png" alt="GesCondu" />
      </a>
      <h2>Um passo de segurança,<br />antes de entrar</h2>
      <p class="auth-message-apoio">Confirme o código do segundo fator para concluir a autenticação.</p>
    </section>

    <section class="auth-panel-col">
      <div class="auth-panel">
        <div class="auth-panel-inner auth-panel-center">
          <h1 class="auth-titulo">Verificação em duas etapas</h1>
          <p class="auth-sub">{{#if metodoTotp}}Aplicação autenticadora{{else}}Código por email{{/if}}</p>
          <p class="auth-hint">
            {{#if metodoTotp}}
            Introduza o código de 6 dígitos da aplicação autenticadora.
            {{else}}
            Introduza o código de 6 dígitos enviado para o seu email (válido 10 minutos).
            {{/if}}
          </p>

          <form action="/2fa/entrar" method="POST" class="auth-form">
            <div class="mb-3">
              <label for="codigo" class="form-label">Código de verificação</label>
              <input type="text" class="form-control auth-codigo" id="codigo" name="codigo"
                     inputmode="numeric" maxlength="6" autocomplete="one-time-code"
                     placeholder="······" aria-describedby="codigoAjuda" required autofocus />
              <small class="text-muted d-block mt-2" id="codigoAjuda">Seis dígitos, sem espaços.</small>
            </div>
            <button type="submit" class="btn btn-primary w-100 auth-btn">Continuar</button>
          </form>

          <div class="auth-divisor">Perdeu o acesso ao código?</div>
          <div class="auth-opcoes">
            <button type="button" class="auth-opcao" data-bs-toggle="collapse" data-bs-target="#codigoRecuperacao"
                    aria-expanded="false" aria-controls="codigoRecuperacao">
              <span class="material-symbols-outlined">key</span>
              <span>
                <span class="d-block fw-semibold">Usar um código de recuperação</span>
                <span class="small text-muted">Código de uso único, no formato 12345-67890</span>
              </span>
              <span class="material-symbols-outlined ms-auto text-muted">expand_more</span>
            </button>
            <div class="collapse" id="codigoRecuperacao">
              <div class="auth-colapso">
                {{!-- Formulário próprio: envia `tipo=recovery`, que o POST
                     /2fa/entrar já distingue (mecanismo inalterado). --}}
                <form action="/2fa/entrar" method="POST">
                  <input type="hidden" name="tipo" value="recovery" />
                  <label class="form-label" for="codigoRecuperacaoCampo">Código de recuperação</label>
                  <div class="input-group">
                    <input type="text" id="codigoRecuperacaoCampo" class="form-control" name="codigo"
                           maxlength="12" autocomplete="off" placeholder="12345-67890" required />
                    <button type="submit" class="btn btn-outline-primary">Usar</button>
                  </div>
                  <small class="text-muted d-block mt-2">Cada código de recuperação só pode ser usado uma vez.</small>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <footer class="auth-foot">© 2026 GesCondu. Todos os direitos reservados. · <a href="/politica-privacidade">Política de Privacidade</a> · <a href="/termos">Termos de Utilização</a></footer>
</div>
