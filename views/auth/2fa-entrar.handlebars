<div class="auth-wrap">
  <div class="auth-card card shadow-sm">
    <div class="card-body p-4 p-md-5">
      <div class="text-center mb-4">
        <img src="/img/logo_gescondu.png" alt="GesCondu" class="login-logo mx-auto d-block mb-3" />
        <h1 class="h4 mb-1">Verificação em duas etapas</h1>
        <p class="text-muted mb-0">Introduza o código enviado para o seu email (válido 10 minutos) ou um código de recuperação.</p>
      </div>

      <form action="/2fa/entrar" method="POST">
        <div class="mb-3">
          <label for="codigo" class="form-label">Código</label>
          <input type="text" class="form-control" id="codigo" name="codigo" inputmode="numeric" maxlength="12" required autofocus autocomplete="one-time-code" />
        </div>
        <div class="form-check form-switch mb-3">
          <input class="form-check-input" type="checkbox" id="tipo_recovery" name="tipo" value="recovery" />
          <label class="form-check-label" for="tipo_recovery">Usar código de recuperação (formato XXXXX-XXXXX)</label>
        </div>
        <button type="submit" class="btn btn-primary w-100">Verificar e entrar</button>
      </form>
    </div>
  </div>
</div>
