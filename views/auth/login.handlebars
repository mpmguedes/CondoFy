<style>
  /* Contexto Login: a página vive dentro de <main.auth-body> (layout sem
     sessão). A composição usa as classes .auth-* do styles.css (mesma
     estrutura que "Os meus condomínios"). */
  .auth-body { background: var(--auth-bg); padding: 0; }
  .auth-flash { max-width: 480px; margin: 0 auto; padding-top: 1rem; }

  /* Coluna esquerda: logótipo por cima do slogan, ambos centrados na vertical
     dentro da coluna (deixa de estar no canto superior). */
  .auth-message {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.9rem;
  }
  .auth-message h2 { margin: 0; }

  /* Logótipo: versão horizontal com fundo transparente, pensada para superfícies
     escuras. No telemóvel é dimensionado pela largura. */
  .auth-logo img { height: clamp(96px, 9vw, 144px); width: auto; max-width: 100%; }
  @media (max-width: 575.98px) {
    .auth-logo img { height: auto; width: min(62vw, 230px); }
  }

  .auth-stage { padding-top: 0; }

  /* Tudo centrado na vertical: o logótipo+slogan e a caixa ficam no meio da
     janela, alinhados entre si (é o alinhamento central da grelha). Em janelas
     baixas a caixa encolhe ao conteúdo, para não cortar. */
  @media (max-height: 860px) {
    .auth-panel-inner { min-height: 0; }
    .auth-stage { padding-top: clamp(16px, 2.5vh, 28px); }
  }
</style>

<div class="auth-page">
  <div class="auth-stage">
    <section class="auth-message">
      <a class="auth-logo" href="/" title="GesCondu">
        <img src="/img/gescondu-logo-ativo.png" alt="GesCondu" />
      </a>
      <h2>A gestão do seu condomínio,<br />simplificada</h2>
      <p class="auth-message-apoio">Gestão simples, organizada e transparente.</p>
    </section>

    <section class="auth-panel-col">
      <div class="auth-panel">
        <div class="auth-panel-inner auth-panel-center">
          <h1 class="auth-titulo">Bem-vindo</h1>
          <p class="auth-sub">ao seu serviço de condomínio</p>
          <p class="auth-hint">Autentique-se para aceder ao serviço</p>

          {{#if expirada}}
          <div class="alert alert-warning py-2 px-3 small mb-3" role="status">
            A sua sessão expirou por inatividade. Inicie sessão novamente.
          </div>
          {{/if}}

          <form action="/login" method="POST" class="auth-form">
            <div class="mb-3">
              <label for="email" class="form-label">Email</label>
              <input type="email" class="form-control" id="email" name="email" autocomplete="email" placeholder="nome@exemplo.pt" required autofocus />
            </div>
            <div class="mb-3">
              <label for="password" class="form-label">Palavra-passe</label>
              <input type="password" class="form-control" id="password" name="password" autocomplete="current-password" placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn btn-primary w-100 auth-btn">Entrar</button>
          </form>

          <div class="text-center auth-recuperar">
            <a href="/recuperar">Esqueci-me da palavra-passe</a>
          </div>

          <div class="auth-divisor">Tem um código de convite?</div>
          <div class="auth-opcoes">
            <button type="button" class="auth-opcao" data-bs-toggle="collapse" data-bs-target="#loginConvite"
                    aria-expanded="false" aria-controls="loginConvite">
              <span class="material-symbols-outlined">key</span>
              <span>
                <span class="d-block fw-semibold">Entrar com um código</span>
                <span class="small text-muted">Aceitar convite de condomínio</span>
              </span>
              <span class="material-symbols-outlined ms-auto text-muted">expand_more</span>
            </button>
            <div class="collapse" id="loginConvite">
              <div class="auth-colapso">
                <label class="form-label" for="codigoConviteLogin">Código de convite</label>
                <div class="input-group">
                  <input type="text" id="codigoConviteLogin" class="form-control" placeholder="Cole aqui o código/link de convite" autocomplete="off" />
                  <button type="button" class="btn btn-outline-primary" id="btnConviteLogin">Aceitar</button>
                </div>
                <small class="text-muted d-block mt-2">Introduza o código de convite que recebeu por email.</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <footer class="auth-foot">© 2026 GesCondu. Todos os direitos reservados. · <a href="/politica-privacidade">Política de Privacidade</a> · <a href="/termos">Termos de Utilização</a></footer>
</div>

<script>
  // "Com um código": o convite usa o fluxo existente (/aceitar-convite/:token),
  // disponível antes de autenticar (não existe registo próprio na aplicação).
  var btnConviteLogin = document.getElementById('btnConviteLogin');
  if (btnConviteLogin) {
    btnConviteLogin.addEventListener('click', function () {
      var campo = document.getElementById('codigoConviteLogin');
      var codigo = campo ? campo.value.trim() : '';
      if (!codigo) return;
      // Aceita também colar o link completo de convite.
      var m = codigo.match(/\/aceitar-convite\/([A-Za-z0-9_-]+)/);
      var token = m ? m[1] : codigo;
      window.location.href = '/aceitar-convite/' + encodeURIComponent(token);
    });
  }
</script>
