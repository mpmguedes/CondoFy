{{#if success_msg}}
  {{#each success_msg}}
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <span class="material-symbols-outlined me-1">check_circle</span>{{this}}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
  </div>
  {{/each}}
{{/if}}
{{#if error_msg}}
  {{#each error_msg}}
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <span class="material-symbols-outlined me-1">error</span>{{this}}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
  </div>
  {{/each}}
{{/if}}
{{#if error}}
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <span class="material-symbols-outlined me-1">error</span>{{error}}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
  </div>
{{/if}}
