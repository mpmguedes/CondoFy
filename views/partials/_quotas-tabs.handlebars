{{!-- Tabs superiores do módulo Quotas — SEMPRE no topo da página (antes do título).
     Ordem visual: Conta-corrente | Quotas | Quotas Extra | Pagamentos | Recibos.
     Recebe "ativo": contacorrente | mapa | extra | comprovativos | recibos. --}}
<nav class="quotas-tabs" aria-label="Secções do módulo Quotas">
  <a class="quotas-tab {{#if (eq ativo 'contacorrente')}}active{{/if}}" href="/admin/quotas/conta-corrente">
    <span class="material-symbols-outlined">account_balance</span>Conta-corrente
  </a>
  <a class="quotas-tab {{#if (eq ativo 'mapa')}}active{{/if}}" href="/admin/quotas">
    <span class="material-symbols-outlined">grid_view</span>Quotas
  </a>
  <a class="quotas-tab {{#if (eq ativo 'extra')}}active{{/if}}" href="/admin/quotas-extra">
    <span class="material-symbols-outlined">savings</span>Quotas Extra
  </a>
  <a class="quotas-tab {{#if (eq ativo 'comprovativos')}}active{{/if}}" href="/admin/quotas/comprovativos">
    <span class="material-symbols-outlined">payments</span>Pagamentos
  </a>
  <a class="quotas-tab {{#if (eq ativo 'recibos')}}active{{/if}}" href="/admin/quotas/recibos">
    <span class="material-symbols-outlined">receipt_long</span>Recibos
  </a>
</nav>
