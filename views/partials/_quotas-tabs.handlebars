{{!-- Tabs superiores do módulo Quotas — SEMPRE no topo da página (antes do título).
     Ordem visual: Conta-corrente | Quotas | Quotas Extra | Pagamentos | Recibos.
     Recebe "ativo": contacorrente | mapa | extra | comprovativos | recibos.
     F17/F31 — a tab ativa leva `aria-current="page"`: o estado ativo era
     transmitido apenas pela cor da classe `.active`, invisível para leitores de
     ecrã. Alinha com `_config-tabs` e `_condomino-quotas-tabs`, que já o tinham. --}}
<nav class="quotas-tabs" aria-label="Secções do módulo Quotas">
  <a class="quotas-tab {{#if (eq ativo 'contacorrente')}}active{{/if}}" href="/admin/quotas/conta-corrente" {{#if (eq ativo 'contacorrente')}}aria-current="page"{{/if}}>
    <span class="material-symbols-outlined" aria-hidden="true">account_balance</span>Conta-corrente
  </a>
  <a class="quotas-tab {{#if (eq ativo 'mapa')}}active{{/if}}" href="/admin/quotas" {{#if (eq ativo 'mapa')}}aria-current="page"{{/if}}>
    <span class="material-symbols-outlined" aria-hidden="true">grid_view</span>Quotas
  </a>
  <a class="quotas-tab {{#if (eq ativo 'extra')}}active{{/if}}" href="/admin/quotas-extra" {{#if (eq ativo 'extra')}}aria-current="page"{{/if}}>
    <span class="material-symbols-outlined" aria-hidden="true">savings</span>Quotas Extra
  </a>
  <a class="quotas-tab {{#if (eq ativo 'comprovativos')}}active{{/if}}" href="/admin/quotas/comprovativos" {{#if (eq ativo 'comprovativos')}}aria-current="page"{{/if}}>
    <span class="material-symbols-outlined" aria-hidden="true">payments</span>Pagamentos
  </a>
  <a class="quotas-tab {{#if (eq ativo 'recibos')}}active{{/if}}" href="/admin/quotas/recibos" {{#if (eq ativo 'recibos')}}aria-current="page"{{/if}}>
    <span class="material-symbols-outlined" aria-hidden="true">receipt_long</span>Recibos
  </a>
</nav>
