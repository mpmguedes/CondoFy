{{!-- Mockup — Mudança de proprietário: a mesma fração, o mesmo condomínio, e
     duas pessoas com acessos separados (o anterior, com o período já encerrado,
     e o novo, com o seu próprio acesso). Construído com as peças dos restantes
     mockups; dados fictícios. No telemóvel os três blocos empilham. --}}
<div class="mk" role="img" aria-label="Exemplo de uma mudança de proprietário no GesCondu: a fração 1.º Esq continua no mesmo condomínio, o proprietário anterior mantém o seu período já encerrado no histórico e o novo proprietário passa a ter o seu próprio acesso.">
  <div class="mk-topo">
    <span class="mk-pontos" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="mk-url">gescondu.xyz/admin/fracoes/1-esq</span>
  </div>

  <div class="mk-principal">
    <div class="mk-cabeca">
      <div>
        <p class="mk-titulo">Fração 1.º Esq · 125,00 ‰</p>
        <p class="mk-sub">Relações registadas com data de início e de fim</p>
      </div>
      <span class="mk-botoes">
        <span class="mk-botao mk-botao-suave">Histórico</span>
        <span class="mk-botao">Registar titular</span>
      </span>
    </div>

    <div class="mk-conteudo">
      <div class="hp-titular-fluxo">
        <div class="mk-cartao hp-titular-passo">
          <div class="mk-cartao-titulo"><span>Proprietário anterior</span><span class="mk-etiqueta mk-etiqueta-neutra">Encerrado</span></div>
          <div class="mk-conteudo" style="padding: 0.7em 0.75em;">
            <div class="mk-linhas">
              <div class="mk-linha"><span class="mk-linha-rotulo">João S.</span><span class="mk-linha-valor">até 30/06/2026</span></div>
              <div class="mk-linha"><span class="mk-linha-rotulo">Conta própria</span><span class="mk-linha-valor">mantém-se dele</span></div>
            </div>
            <p class="mk-meta">Período guardado no histórico do condomínio.</p>
          </div>
        </div>

        <span class="mk-fluxo-seta hp-titular-seta" aria-hidden="true">→</span>

        <div class="mk-cartao hp-titular-passo hp-titular-fracao">
          <div class="mk-cartao-titulo"><span>A fração</span><span class="mk-etiqueta mk-etiqueta-info">No condomínio</span></div>
          <div class="mk-conteudo" style="padding: 0.7em 0.75em;">
            <div class="mk-linhas">
              <div class="mk-linha"><span class="mk-linha-rotulo">Fração</span><span class="mk-linha-valor">1.º Esq</span></div>
              <div class="mk-linha"><span class="mk-linha-rotulo">Quotas e recibos</span><span class="mk-linha-valor">mantêm-se</span></div>
              <div class="mk-linha"><span class="mk-linha-rotulo">Documentos e atas</span><span class="mk-linha-valor">mantêm-se</span></div>
            </div>
            <p class="mk-meta">A fração e o edifício não mudam de lugar.</p>
          </div>
        </div>

        <span class="mk-fluxo-seta hp-titular-seta" aria-hidden="true">→</span>

        <div class="mk-cartao hp-titular-passo">
          <div class="mk-cartao-titulo"><span>Novo proprietário</span><span class="mk-etiqueta mk-etiqueta-ok">Em vigor</span></div>
          <div class="mk-conteudo" style="padding: 0.7em 0.75em;">
            <div class="mk-linhas">
              <div class="mk-linha"><span class="mk-linha-rotulo">Maria C.</span><span class="mk-linha-valor">desde 01/07/2026</span></div>
              <div class="mk-linha"><span class="mk-linha-rotulo">Acesso</span><span class="mk-linha-valor">próprio, por convite</span></div>
            </div>
            <p class="mk-meta">Não recebe a conta de quem estava antes.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
