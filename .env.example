# ── GesCondu — ambiente ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SESSION_SECRET=troque-esta-chave-por-uma-segura

# Sessão: bloqueio automático por inatividade (a sessão não dura indefinidamente).
SESSION_IDLE_MINUTOS=120   # minutos sem atividade até encerrar a sessão
SESSION_AVISO_SEGUNDOS=120 # aviso antes de expirar (botão "Continuar sessão")

# ── MariaDB ─────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=condofy
DB_USER=condofy
DB_PASS=condofy

# ── SMTP (fornecedor configurável; não assume Gmail) ────────────────
# Estes valores são o fallback inicial. Depois de arrancar, a
# configuração pode ser feita na interface (Emails → Configurar SMTP) e
# fica guardada na base de dados (as chaves smtp_* têm prioridade).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_TLS=true
# (utilizar uma "App Password" de 16 caracteres em SMTP_PASS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
SMTP_FROM=noreply@condominio.pt
SMTP_FROM_NAME=Condomínio

# ── Cifragem das credenciais de armazenamento (obrigatória) ─────────
# Chave exclusiva desta instalação, usada para cifrar em repouso os tokens
# OAuth (Google Drive, Dropbox, OneDrive) guardados na tabela `configuracoes`
# (AES-256-GCM). Nunca é guardada no Git.
# Gere uma chave: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# São necessários 32 bytes (base64 ou hex). Sem esta chave, as ligações de
# armazenamento ficam indisponíveis (nenhuma credencial é guardada ou usada em
# texto simples) até estar configurada.
ENCRYPTION_KEY=
# Rotação de chave (opcional): chave(s) anterior(es), separadas por vírgula.
# Permitem decifrar os valores antigos; depois de rodar, corra
# `node scripts/migrar-tokens-cifrados.js` para recifrar tudo com a chave nova.
ENCRYPTION_KEY_OLD=

# ── Google Drive API (repositório documental + backups) ─────────────
# Credenciais OAuth 2.0 criadas no Google Cloud Console (ver docs/GOOGLE_DRIVE.md).
# Depois de definir as credenciais, ligue a conta Google na página
# Configuração → Google Drive — os tokens são guardados na base de dados.
# GOOGLE_DRIVE_ENABLED=true liga a integração.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deve corresponder exatamente a um Redirect URI registado na consola Google.
# Exemplos: http://localhost:3000/admin/config/drive/callback (dev)
#           https://gescondu.xyz/admin/config/drive/callback (produção)
GOOGLE_REDIRECT_URI=
# (Legado, opcional) Ligação direta sem fluxo OAuth na aplicação. Se ficar
# definido, a integração funciona mesmo sem ligar conta na Configuração.
GOOGLE_REFRESH_TOKEN=
# Pasta raiz no Drive. Precedência: configuração na BD → este valor →
# "GesCondu". Pastas antigas (ex.: "CondoFy") continuam válidas e reutilizáveis.
GOOGLE_DRIVE_ROOT_FOLDER=

# ── Serviço de armazenamento do condomínio ──────────────────────────
# Provedor por omissão quando o condomínio ainda não escolheu nenhum em
# Configuração → Armazenamento e Backups: google_drive | dropbox | onedrive.
STORAGE_PROVIDER=google_drive

# ── Dropbox (opcional, por condomínio) ──────────────────────────────
# Crie uma app em https://www.dropbox.com/developers/apps (scoped access,
# permissões files.content.read + files.content.write) e registe o redirect.
DROPBOX_ENABLED=false
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Exemplos: http://localhost:3000/admin/config/armazenamento/dropbox/callback
#           https://gescondu.xyz/admin/config/armazenamento/dropbox/callback
DROPBOX_REDIRECT_URI=
DROPBOX_ROOT_FOLDER=

# ── Microsoft OneDrive (opcional, por condomínio) ───────────────────
# Registe uma aplicação no Microsoft Entra ID (Azure AD) com o scope
# offline_access Files.ReadWrite e o redirect abaixo.
ONEDRIVE_ENABLED=false
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
# common | organizations | consumers | <tenant-id>
ONEDRIVE_TENANT=common
# Exemplos: http://localhost:3000/admin/config/armazenamento/onedrive/callback
#           https://gescondu.xyz/admin/config/armazenamento/onedrive/callback
ONEDRIVE_REDIRECT_URI=
ONEDRIVE_ROOT_FOLDER=

# ── Links temporários de documentos (emails para quem não tem conta) ─
# Segredo usado para assinar os links (por omissão usa SESSION_SECRET).
# Sem segredo configurado, os links temporários ficam DESATIVADOS e os emails
# para destinatários externos seguem sem link (o ficheiro vai em anexo).
DOC_LINK_SECRET=
# Validade dos links temporários, em horas (por omissão 168 = 7 dias).
DOC_LINK_TTL_HOURS=168
# Defina 0 para desativar totalmente os links temporários.
DOC_LINK_TEMPORARIO=1

# ── Backups (retenção em dias) ──────────────────────────────────────
BACKUP_DAILY_RETENTION=30
BACKUP_WEEKLY_RETENTION=90
BACKUP_MONTHLY_RETENTION=365
BACKUP_HOUR=3
