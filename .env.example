# ── Condofy — ambiente ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SESSION_SECRET=troque-esta-chave-por-uma-segura

# ── MariaDB ─────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=condofy
DB_USER=condofy
DB_PASS=condofy

# ── SMTP (fornecedor configurável; não assume Gmail) ────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
SMTP_FROM=noreply@condominio.pt
SMTP_FROM_NAME=Condomínio

# ── Google Drive API (repositório documental + backups) ─────────────
GOOGLE_DRIVE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER=

# ── Backups (retenção em dias) ──────────────────────────────────────
BACKUP_DAILY_RETENTION=30
BACKUP_WEEKLY_RETENTION=90
BACKUP_MONTHLY_RETENTION=365
BACKUP_HOUR=3
