# ── GesCondu — ambiente ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SESSION_SECRET=troque-esta-chave-por-uma-segura

# Sessão: bloqueio automático por inatividade (a sessão não dura indefinidamente).
SESSION_IDLE_MINUTOS=120   # minutos sem atividade até encerrar a sessão
SESSION_AVISO_SEGUNDOS=120 # aviso antes de expirar (botão "Continuar sessão")

# ── MariaDB ─────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=condofy
DB_USER=condofy
DB_PASS=condofy

# ── SMTP (fornecedor configurável; não assume Gmail) ────────────────
# Estes valores são o fallback inicial. Depois de arrancar, a
# configuração pode ser feita na interface (Emails → Configurar SMTP) e
# fica guardada na base de dados (as chaves smtp_* têm prioridade).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_TLS=true
# (utilizar uma "App Password" de 16 caracteres em SMTP_PASS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
SMTP_FROM=noreply@condominio.pt
SMTP_FROM_NAME=Condomínio

# ── Cifragem das credenciais de armazenamento (obrigatória) ─────────
# Chave exclusiva desta instalação, usada para cifrar em repouso os tokens
# OAuth (Google Drive, Dropbox, OneDrive) guardados na tabela `configuracoes`
# (AES-256-GCM). Nunca é guardada no Git.
# Gere uma chave: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# São necessários 32 bytes (base64 ou hex). Sem esta chave, as ligações de
# armazenamento ficam indisponíveis (nenhuma credencial é guardada ou usada em
# texto simples) até estar configurada.
ENCRYPTION_KEY=
# Rotação de chave (opcional): chave(s) anterior(es), separadas por vírgula.
# Permitem decifrar os valores antigos; depois de rodar, corra
# `node scripts/migrar-tokens-cifrados.js` para recifrar tudo com a chave nova.
ENCRYPTION_KEY_OLD=

# ── Google Drive API (repositório documental + backups) ─────────────
# Credenciais OAuth 2.0 criadas no Google Cloud Console (ver docs/GOOGLE_DRIVE.md).
# Depois de definir as credenciais, ligue a conta Google na página
# Configuração → Google Drive — os tokens são guardados na base de dados.
# GOOGLE_DRIVE_ENABLED=true liga a integração.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deve corresponder exatamente a um Redirect URI registado na consola Google.
# Exemplos: http://localhost:3000/admin/config/drive/callback (dev)
#           https://gescondu.xyz/admin/config/drive/callback (produção)
GOOGLE_REDIRECT_URI=
# (Legado, opcional) Ligação direta sem fluxo OAuth na aplicação. Se ficar
# definido, a integração funciona mesmo sem ligar conta na Configuração.
GOOGLE_REFRESH_TOKEN=
# Pasta raiz no Drive. Precedência: configuração na BD → este valor →
# "GesCondu". Pastas antigas (ex.: "CondoFy") continuam válidas e reutilizáveis.
GOOGLE_DRIVE_ROOT_FOLDER=

# ── Serviço de armazenamento do condomínio ──────────────────────────
# Provedor por omissão quando o condomínio ainda não escolheu nenhum em
# Configuração → Armazenamento e Backups: google_drive | dropbox | onedrive.
STORAGE_PROVIDER=google_drive

# ── Dropbox (opcional, por condomínio) ──────────────────────────────
# Crie uma app em https://www.dropbox.com/developers/apps (scoped access,
# permissões files.content.read + files.content.write) e registe o redirect.
DROPBOX_ENABLED=false
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Exemplos: http://localhost:3000/admin/config/armazenamento/dropbox/callback
#           https://gescondu.xyz/admin/config/armazenamento/dropbox/callback
DROPBOX_REDIRECT_URI=
DROPBOX_ROOT_FOLDER=

# ── Microsoft OneDrive (opcional, por condomínio) ───────────────────
# Registe uma aplicação no Microsoft Entra ID (Azure AD) e ative a integração.
# Guia completo (passo a passo, erros frequentes): docs/ONEDRIVE.md
# ONEDRIVE_ENABLED=true liga a integração. Sem isto o serviço não aparece como
# disponível e nenhuma operação usa o OneDrive (mesmo com as credenciais
# preenchidas) — o botão «Ligar» nem chega a ser oferecido.
# Permissões DELEGADAS necessárias no Microsoft Graph (nenhuma exige
# consentimento administrativo numa conta pessoal):
#   Files.ReadWrite · offline_access · User.Read
# (`User.Read` é o que permite identificar QUAL conta ficou ligada.)
ONEDRIVE_ENABLED=false
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
# common | organizations | consumers | <tenant-id>
# `common` é o correto para contas pessoais; nesse caso a App Registration tem
# de ser «Accounts in any organizational directory and personal Microsoft
# accounts», senão o pedido falha com AADSTS50194.
ONEDRIVE_TENANT=common
# Exemplos: http://localhost:3000/admin/config/armazenamento/onedrive/callback
#           https://gescondu.xyz/admin/config/armazenamento/onedrive/callback
# Tem de coincidir EXATAMENTE com um Redirect URI registado na plataforma «Web»
# da App Registration (esquema, host, porta e caminho) — senão: AADSTS50011.
ONEDRIVE_REDIRECT_URI=
ONEDRIVE_ROOT_FOLDER=

# ── Links temporários de documentos (emails para quem não tem conta) ─
# Segredo usado para assinar os links (por omissão usa SESSION_SECRET).
# Sem segredo configurado, os links temporários ficam DESATIVADOS e os emails
# para destinatários externos seguem sem link (o ficheiro vai em anexo).
DOC_LINK_SECRET=
# Validade dos links temporários, em horas (por omissão 168 = 7 dias).
DOC_LINK_TTL_HOURS=168
# Defina 0 para desativar totalmente os links temporários.
DOC_LINK_TEMPORARIO=1

# ── Backups da instalação (retenção em dias) ────────────────────────
# Os backups são da INSTALAÇÃO: um dump COMPLETO da base de dados, que contém
# os dados de todos os condomínios. NÃO existem backups por condomínio e os
# DOCUMENTOS dos condomínios (Drive/Dropbox/OneDrive) NÃO entram no backup.
#
# A cópia LOCAL é sempre feita, em `backups/local` (a pasta não é versionada).
# A cópia na cloud é ADICIONAL e escolhe-se em Configurações → Armazenamento e
# Backups; pode ser um serviço diferente do usado pelos documentos. Uma falha
# da cloud nunca afeta a cópia local.
#
# As retenções são POR DESTINO e independentes (local 30 / cloud 90 é válido),
# têm um mínimo de 30 dias e são por IDADE (não por número de ficheiros). O
# último backup local válido é sempre preservado.
#
# Estes valores são apenas o FALLBACK: a fonte é o que estiver guardado em
# Administração global → Backups (tabela `configuracoes`). Usam-se quando não
# houver nada guardado. `BACKUP_DAILY_RETENTION` mantém-se por compatibilidade.
BACKUP_DAILY_RETENTION=30
BACKUP_CLOUD_RETENTION=90
# Limite informativo do espaço local, em GB (não apaga nada; só avisa).
# BACKUP_LOCAL_LIMIT_GB=50
BACKUP_HOUR=3
# Pasta da cópia local (opcional; por omissão `backups/local`). Só é preciso
# definir quando os backups têm de ficar noutro volume/montagem.
# BACKUP_LOCAL_DIR=/var/backups/gescondu

# ── Páginas legais públicas (Política de Privacidade e Termos de Utilização) ──
# Identificação e contacto do responsável pelo tratamento, apresentados em
# /politica-privacidade e /termos. Nada é inventado pela aplicação: enquanto
# estas variáveis não estiverem definidas, as páginas mostram marcadores
# («[CONFIGURAR …]») e uma caixa com os elementos em falta.
# O domínio apresentado é o do próprio pedido (não precisa de configuração).
LEGAL_ENTIDADE=
LEGAL_NIF=
LEGAL_MORADA=
LEGAL_EMAIL=
LEGAL_TELEFONE=

# Encarregado de Proteção de Dados (EPD/DPO), se designado (art. 37.º do RGPD).
# Opcional: só é obrigatório em determinados tratamentos. Se ficar vazio, a
# política explica que não se encontra designado EPD, em vez de inventar um
# contacto. Quando LEGAL_EPD estiver definido, o EPD passa a constar da secção
# "Responsável pelo tratamento" e da secção "Contacto".
LEGAL_EPD=
LEGAL_EPD_EMAIL=

# ── Homepage pública e pedidos de acesso ────────────────────────────
# Endereço que recebe os pedidos de acesso apresentados na homepage e na página
# /pedir-acesso (o botão abre o cliente de correio com a mensagem já preparada).
# Se ficar vazio, é usado o LEGAL_EMAIL; se nenhum estiver definido, a página
# diz que o canal de contacto está por configurar (nunca inventa um endereço).
ACESSO_EMAIL=
