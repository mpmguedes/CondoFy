{
  "name": "condofy",
  "version": "1.0.0",
  "description": "Condofy — Gestão de condomínios em Portugal (PT-PT): quotas, pagamentos, despesas, documentos, comunicação e backups.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:setup": "sequelize-cli db:migrate && sequelize-cli db:seed:all"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-handlebars": "^7.1.3",
    "express-session": "^1.18.1",
    "googleapis": "^144.0.0",
    "method-override": "^3.0.0",
    "multer": "^2.0.1",
    "mysql2": "^3.11.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.15.0",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
